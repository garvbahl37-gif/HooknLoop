{%- comment -%}
  Trusted Supplier — port of TrustedSupplier() from sections/Basic.jsx
{%- endcomment -%}

<section class="ts" aria-labelledby="ts-h">
  <div class="wrap ts__grid">
    <div class="ts__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="sec-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}

      <div class="ts__block">
        <span class="ts__icn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
        </span>
        <div>
          <h2 id="ts-h" class="ts__h">{{ section.settings.h1 }}</h2>
          <p class="ts__p">{{ section.settings.p1 }}</p>
        </div>
      </div>

      <div class="ts__block">
        <span class="ts__icn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3h18v4H3zM5 7v14h14V7M9 11h6"/></svg>
        </span>
        <div>
          <h3 class="ts__h">{{ section.settings.h2 }}</h3>
          <p class="ts__p">{{ section.settings.p2 }}</p>
        </div>
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '/pages/about-us' }}" class="btn btn--primary ts__cta">{{ section.settings.cta_label }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      {%- endif -%}
    </div>

    <div class="ts__media">
      <div class="ts__frame">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image_alt, loading: 'lazy' }}
        {%- else -%}
          <img src="{{ 'hnl-b2b-hero.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy">
        {%- endif -%}
      </div>
      {%- if section.settings.proof_score != blank -%}
        <div class="ts__proof">
          <span class="ts__proof-stars" aria-hidden="true">★★★★★</span>
          <div><b>{{ section.settings.proof_score }}</b><span>{{ section.settings.proof_text }}</span></div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HooknLoop supplier",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "B2C & B2B · Australia-wide" },
    { "type": "text", "id": "h1", "label": "Heading 1", "default": "Trusted Hook and Loop Supplier for B2C & B2B Customers" },
    { "type": "textarea", "id": "p1", "label": "Paragraph 1", "default": "Proudly serving both B2C and B2B customers across Australia, we focus on quality products that work in real-world conditions. Every product offered at HooknLoop.com.au is carefully selected based on material quality, performance testing, and long-term reliability." },
    { "type": "text", "id": "h2", "label": "Heading 2", "default": "Wholesale, Bulk & Discounted Hook and Loop Supplies" },
    { "type": "textarea", "id": "p2", "label": "Paragraph 2", "default": "With a large range of fasteners, tapes, straps and accessories held in stock, we offer competitive pricing for retail, trade and commercial buyers. Buy by the roll, in bulk, or at wholesale rates — with volume discounts on larger orders." },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Read more" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Hook-and-loop tape beside a map of Australia and HooknLoop delivery boxes" },
    { "type": "text", "id": "proof_score", "label": "Rating", "default": "4.87 / 5" },
    { "type": "text", "id": "proof_text", "label": "Rating caption", "default": "Serving B2C & B2B across Australia" }
  ],
  "presets": [{ "name": "HooknLoop supplier" }]
}
{% endschema %}
