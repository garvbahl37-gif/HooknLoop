{%- comment -%}
  Best Sellers — port of storefront/src/sections/BestSellers.jsx + ProductCard.jsx

  Difference from the React version, deliberately: this reads REAL Shopify
  products from a collection, so titles, prices, images and links are live and
  never drift from the catalogue. The React version hardcoded an array of 12
  handles against a static catalog.js.

  The card itself lives in snippets/hnl-product-card so the homepage, the
  collection page and the PDP cross-sell all render the same thing.
{%- endcomment -%}

{%- assign coll = collections[section.settings.collection] -%}
{%- if coll == blank or coll.products_count == 0 -%}
  {%- assign coll = collections.all -%}
{%- endif -%}

<section class="bs" aria-labelledby="bs-h">
  <div class="wrap">
    <div class="sec-head">
      {%- if section.settings.eyebrow != blank -%}<span class="sec-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 id="bs-h" class="sec-h2">{{ section.settings.heading }}</h2>
      <a href="{{ routes.all_products_collection_url }}" class="bs__all" style="display:inline-block;margin-top:8px;">Shop all products →</a>
    </div>

    <div class="bs__grid">
      {%- for product in coll.products limit: section.settings.count -%}
        {% render 'hnl-product-card', product: product %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HooknLoop best sellers",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers & Offers" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Falls back to all products if empty." },
    { "type": "range", "id": "count", "min": 4, "max": 16, "step": 2, "label": "Products to show", "default": 12 }
  ],
  "presets": [{ "name": "HooknLoop best sellers" }]
}
{% endschema %}
