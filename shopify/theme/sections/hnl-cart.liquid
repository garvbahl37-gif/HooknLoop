{%- comment -%}
  Cart page — port of storefront/src/pages/CartPage.jsx

  The React version says it plainly in its own header: "Checkout is a mock
  (needs Shopify to be real)". Everything it faked is real here:

    - line items come from the Shopify cart, not localStorage
    - Checkout posts to /checkout, so it actually completes a purchase
    - the discount field uses Shopify's cart discount code, so the total updates
      instead of only promising to apply "at checkout"
    - payment marks come from shop.enabled_payment_types rather than three
      hand-drawn logos

  The free-shipping progress bar and the trust list carry over unchanged; the
  threshold is a setting because $300 will change before this file does.

  Dropped: React's ShippingEstimator. Shopify calculates real rates at checkout
  from the customer's address, and a second estimator that guesses beforehand
  can only ever disagree with the number that actually gets charged.
{%- endcomment -%}

{%- liquid
  assign threshold = section.settings.free_ship_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign pct = 0
  if threshold > 0
    assign pct = cart.total_price | times: 100.0 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  endif
-%}

<div id="main" class="page">
  {%- if cart.item_count == 0 -%}
    <div class="wrap cart__empty">
      <div class="cart__empty-icn" aria-hidden="true">
        <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 3H2"/></svg>
      </div>
      <h1 class="page__h1">Your cart is empty</h1>
      <p class="page__lead">Add some hook &amp; loop and it'll show up here.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop all products &rarr;</a>
    </div>

  {%- else -%}
    <div class="wrap cart">
      <div class="cart__items">
        <h1 class="page__h1">Your cart</h1>

        <form action="{{ routes.cart_url }}" method="post" novalidate data-hnl-cart-form>
          {%- for item in cart.items -%}
            <div class="cart__row" data-hnl-line="{{ forloop.index }}" data-key="{{ item.key }}">
              <div class="cart__media">
                <a href="{{ item.url }}">
                  {%- if item.image -%}
                    <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="200" height="200" loading="lazy">
                  {%- endif -%}
                </a>
              </div>

              <div class="cart__info">
                <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                {%- unless item.variant.title contains 'Default' -%}
                  <span class="cart__variant">{{ item.variant.title }}</span>
                {%- endunless -%}
                {%- if item.selling_plan_allocation -%}
                  <span class="cart__variant">{{ item.selling_plan_allocation.selling_plan.name }}</span>
                {%- endif -%}
                {%- if item.line_level_discount_allocations.size > 0 -%}
                  {%- for d in item.line_level_discount_allocations -%}
                    <span class="cart__variant">{{ d.discount_application.title }} (&minus;{{ d.amount | money }})</span>
                  {%- endfor -%}
                {%- endif -%}
                <button type="button" class="cart__remove" data-hnl-remove="{{ item.key }}">Remove</button>
              </div>

              <div class="cart__qty">
                <button type="button" data-hnl-line-qty="{{ item.key }}" data-delta="-1" aria-label="Decrease">&minus;</button>
                <span>{{ item.quantity }}</span>
                <button type="button" data-hnl-line-qty="{{ item.key }}" data-delta="1" aria-label="Increase">+</button>
              </div>

              <div class="cart__line">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </form>

        <div class="cart__tools">
          {%- comment -%}
            Estimate Shipping — the calculator the live store has on its cart.
            pages.css already styled .ship-est__* from the first build; nothing
            ever rendered the markup, so the rules sat dead in the bundle.

            Rates come from Shopify's own /cart/shipping_rates.json for the
            entered address rather than being hardcoded. The React prototype
            printed "Standard $12.00 / Express $18.00, free over $200", which is
            already wrong on two counts: free standard starts at $300 here, and
            orders between 5kg and 10kg are charged $24/$30 instead. Asking
            Shopify means the quote matches what checkout will actually charge,
            and keeps matching if the rate table changes.
          {%- endcomment -%}
          <form class="ship-est" data-hnl-ship-est>
            <div class="ship-est__head">
              <span class="ship-est__ic" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h11v11H2zM13 9h4l3 3v5h-7"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
              </span>
              <b>Estimate Shipping</b>
            </div>
            <div class="ship-est__row">
              <select class="ship-est__sel" data-hnl-se-state aria-label="State / territory">
                <option value="">---</option>
                <option value="Australian Capital Territory">Australian Capital Territory</option>
                <option value="New South Wales">New South Wales</option>
                <option value="Northern Territory">Northern Territory</option>
                <option value="Queensland">Queensland</option>
                <option value="South Australia">South Australia</option>
                <option value="Tasmania">Tasmania</option>
                <option value="Victoria">Victoria</option>
                <option value="Western Australia">Western Australia</option>
              </select>
              <input class="ship-est__zip" data-hnl-se-zip inputmode="numeric" maxlength="4"
                     placeholder="Postal/ZIP code" aria-label="Postal / ZIP code">
              <button type="submit" class="ship-est__btn">Shipping calculator</button>
            </div>
            <span class="ship-est__err" data-hnl-se-err hidden></span>
            <div class="ship-est__res" data-hnl-se-res hidden></div>
          </form>

          {%- comment -%}
            Shopify applies discount codes at checkout, and the cart API has no
            endpoint to add one. Sending the shopper through /discount/CODE
            registers it and returns them here with the total already reduced —
            so the number they see is the number they pay.
          {%- endcomment -%}
          <form class="cart__disc" data-hnl-discount>
            <label class="cart__disc-lbl" for="disc-code">Apply a discount code</label>
            <div class="cart__disc-row">
              <input id="disc-code" class="cart__disc-input" placeholder="Enter discount code here" aria-label="Discount code">
              <button class="cart__disc-btn" type="submit">Apply</button>
            </div>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              {%- for d in cart.cart_level_discount_applications -%}
                <span class="cart__disc-msg">{{ d.title }} applied &mdash; &minus;{{ d.total_allocated_amount | money }}</span>
              {%- endfor -%}
            {%- endif -%}
          </form>
        </div>
      </div>

      <aside class="cart__summary">
        {%- if threshold > 0 -%}
          <div class="cart__ship">
            {%- if remaining > 0 -%}
              <span><b>{{ remaining | money }} AUD</b> away from <b>Free Standard Shipping</b>.</span>
            {%- else -%}
              <span>You've unlocked <b>Free Standard Shipping</b>.</span>
            {%- endif -%}
            <div class="cart__ship-bar" role="progressbar" aria-valuenow="{{ pct | round }}" aria-valuemin="0" aria-valuemax="100">
              <span style="width: {{ pct }}%"></span>
              <i class="cart__ship-truck" style="left: {{ pct }}%" aria-hidden="true">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6h11v11H2zM13 9h4l3 3v5h-7"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
              </i>
            </div>
          </div>
        {%- endif -%}

        <div class="cart__sumrow cart__sumrow--total"><span>Subtotal</span><b>{{ cart.total_price | money }} AUD</b></div>
        <p class="cart__taxnote">Tax included. Shipping calculated at checkout.</p>

        <button type="submit" name="checkout" form="hnl-cart-checkout" class="btn btn--primary cart__checkout">Checkout</button>
        <form action="{{ routes.cart_url }}" method="post" id="hnl-cart-checkout" hidden></form>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="cart__pay" aria-label="Accepted payment methods">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'ft__paymark' }}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <a href="{{ routes.all_products_collection_url }}" class="cart__cont">&larr; Continue shopping</a>

        <ul class="cart__trust">
          {%- assign trust = section.settings.trust | newline_to_br | split: '<br />' -%}
          {%- for t in trust -%}
            {%- assign line = t | strip -%}
            {%- if line != blank -%}<li>{{ line }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </aside>
    </div>
  {%- endif -%}
</div>

<script>
(function () {
  var form = document.querySelector('[data-hnl-cart-form]');

  {%- comment -%}
    Every press used to POST and then window.location.reload() — a full page
    load to change one number, which is why the cart felt like it was
    restarting itself. It now repaints in place and writes in the background,
    the same way the drawer does.

    Lines are addressed by key rather than index: a removal renumbers every
    line after it, so a queued change could otherwise hit the wrong row.

    The server still has the last word. Stock limits and automatic discounts
    can both make the result differ from what was asked for, so its response
    is applied when it lands — unless a newer press is already on screen.
  {%- endcomment -%}
  var THRESHOLD = {{ section.settings.free_ship_threshold | default: 300 | times: 100 }};
  var cart = null;
  var pending = {};
  var flushTimer = null;
  var seq = 0;

  function money(c) { return '$' + (c / 100).toFixed(2); }

  function paint(c) {
    cart = c;
    c.items.forEach(function (it) {
      var row = form && form.querySelector('.cart__row[data-key="' + (window.CSS && CSS.escape ? CSS.escape(it.key) : it.key) + '"]');
      if (!row) return;
      var n = row.querySelector('.cart__qty span');
      if (n) n.textContent = it.quantity;
      var lp = row.querySelector('.cart__line');
      if (lp) lp.textContent = money(it.final_line_price != null ? it.final_line_price : it.line_price);
    });

    /* Rows the server no longer knows about are gone. */
    if (form) {
      [].forEach.call(form.querySelectorAll('.cart__row'), function (row) {
        var k = row.getAttribute('data-key');
        var still = c.items.some(function (it) { return it.key === k; });
        if (!still) row.remove();
      });
      if (!c.items.length) window.location.reload();   /* empty cart has its own layout */
    }

    [].forEach.call(document.querySelectorAll('[data-hnl-cart-count]'), function (el) {
      el.textContent = c.item_count;
      el.classList.toggle('is-on', c.item_count > 0);
    });

    var sub = document.querySelector('.cart__sumrow--total b');
    if (sub) sub.textContent = money(c.total_price) + ' AUD';

    var ship = document.querySelector('.cart__ship');
    if (ship && THRESHOLD > 0) {
      var remaining = THRESHOLD - c.total_price;
      var pct = Math.min(100, (c.total_price / THRESHOLD) * 100);
      var msg = ship.querySelector('span');
      if (msg) {
        msg.innerHTML = remaining > 0
          ? '<b>' + money(remaining) + ' AUD</b> away from <b>Free Standard Shipping</b>.'
          : 'You&rsquo;ve unlocked <b>Free Standard Shipping</b>.';
      }
      var bar = ship.querySelector('.cart__ship-bar');
      if (bar) bar.setAttribute('aria-valuenow', Math.round(pct));
      var fill = ship.querySelector('.cart__ship-bar > span');
      if (fill) fill.style.width = pct + '%';
      var truck = ship.querySelector('.cart__ship-truck');
      if (truck) truck.style.left = pct + '%';
    }
  }

  function optimistic(key, qty) {
    if (!cart) return false;
    var items = [], found = false;
    cart.items.forEach(function (it) {
      if (it.key !== key) { items.push(it); return; }
      found = true;
      if (qty <= 0) return;
      var unit = it.quantity ? ((it.final_line_price != null ? it.final_line_price : it.line_price) / it.quantity) : it.price;
      var copy = {};
      for (var k in it) { if (Object.prototype.hasOwnProperty.call(it, k)) copy[k] = it[k]; }
      copy.quantity = qty;
      copy.final_line_price = Math.round(unit * qty);
      copy.line_price = copy.final_line_price;
      items.push(copy);
    });
    if (!found) return false;
    paint({
      items: items,
      item_count: items.reduce(function (n, x) { return n + x.quantity; }, 0),
      total_price: items.reduce(function (n, x) { return n + (x.final_line_price != null ? x.final_line_price : x.line_price); }, 0)
    });
    return true;
  }

  function flush() {
    var updates = pending;
    pending = {};
    if (!Object.keys(updates).length) return;
    var mine = ++seq;
    fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ updates: updates })
    })
      .then(function (r) { return r.ok ? r.json() : Promise.reject(r); })
      .then(function (server) {
        if (mine !== seq) return;                    /* a newer press owns the screen */
        if (Object.keys(pending).length) return;
        paint(server);
      })
      .catch(function () { window.location.reload(); });   /* fall back to the truth */
  }

  function queue(key, qty) {
    pending[key] = qty;
    if (!optimistic(key, qty)) { flush(); return; }
    clearTimeout(flushTimer);
    flushTimer = setTimeout(flush, 220);
  }

  if (form) {
    /* Seed from the server so the optimistic path has something to copy. */
    fetch('/cart.js', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (c) { cart = c; })
      .catch(function () {});

    form.addEventListener('click', function (e) {
      var step = e.target.closest('[data-hnl-line-qty]');
      if (step) {
        var row = step.closest('.cart__row');
        var current = parseInt(row.querySelector('.cart__qty span').textContent, 10);
        var next = current + parseInt(step.getAttribute('data-delta'), 10);
        queue(step.getAttribute('data-hnl-line-qty'), Math.max(0, next));
        return;
      }
      var rm = e.target.closest('[data-hnl-remove]');
      if (rm) queue(rm.getAttribute('data-hnl-remove'), 0);
    });
  }

  /* Estimate Shipping — real rates from Shopify for the entered address. */
  var se = document.querySelector('[data-hnl-ship-est]');
  if (se) {
    var seState = se.querySelector('[data-hnl-se-state]');
    var seZip   = se.querySelector('[data-hnl-se-zip]');
    var seErr   = se.querySelector('[data-hnl-se-err]');
    var seRes   = se.querySelector('[data-hnl-se-res]');
    var seBtn   = se.querySelector('.ship-est__btn');

    function seReset() { seErr.hidden = true; seRes.hidden = true; }
    seState.addEventListener('change', seReset);
    seZip.addEventListener('input', function () {
      seZip.value = seZip.value.replace(/\D/g, '').slice(0, 4);
      seReset();
    });

    se.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!seState.value || seZip.value.length !== 4) {
        seErr.textContent = 'Select your state and enter a 4-digit postcode.';
        seErr.hidden = false;
        seRes.hidden = true;
        return;
      }
      seErr.hidden = true;
      seBtn.disabled = true;
      var was = seBtn.textContent;
      seBtn.textContent = 'Checking…';

      var q = 'shipping_address[country]=Australia'
            + '&shipping_address[province]=' + encodeURIComponent(seState.value)
            + '&shipping_address[zip]=' + encodeURIComponent(seZip.value);

      fetch('/cart/shipping_rates.json?' + q, {
        headers: { 'Accept': 'application/json' }, credentials: 'same-origin'
      })
        .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
        .then(function (out) {
          seBtn.disabled = false;
          seBtn.textContent = was;
          var rates = out.ok && out.d && out.d.shipping_rates;
          if (!rates || !rates.length) {
            /* No rate for this address is a real answer, not an error state —
               it means nothing in the rate table covers this cart. */
            seErr.textContent = 'No shipping rates found for that address. Contact us and we will sort it.';
            seErr.hidden = false;
            return;
          }
          var html = rates.map(function (r) {
            var cents = Math.round(parseFloat(r.price) * 100);
            var free = cents === 0;
            return '<span class="ship-est__rate' + (free ? ' is-free' : '') + '">'
                 + (free ? '<b>Free</b> &mdash; ' + esc(r.name)
                         : esc(r.name) + ': <b>$' + parseFloat(r.price).toFixed(2) + '</b>')
                 + '</span>';
          }).join('');
          html += '<span class="ship-est__note">Dispatched in 1&ndash;2 business days &middot; delivery Australia-wide. '
                + 'Free standard shipping on orders over $' + (THRESHOLD / 100).toFixed(0) + '.</span>';
          seRes.innerHTML = html;
          seRes.hidden = false;
        })
        .catch(function () {
          seBtn.disabled = false;
          seBtn.textContent = was;
          seErr.textContent = 'Could not reach the shipping calculator. Please try again.';
          seErr.hidden = false;
        });
    });
  }

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (m) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[m];
    });
  }

  /* /discount/CODE registers the code against the session and redirects back,
     so the subtotal on screen already reflects it. */
  var disc = document.querySelector('[data-hnl-discount]');
  if (disc) {
    disc.addEventListener('submit', function (e) {
      e.preventDefault();
      var code = disc.querySelector('input').value.trim();
      if (!code) return;
      window.location.href = '/discount/' + encodeURIComponent(code)
        + '?redirect=' + encodeURIComponent('{{ routes.cart_url }}');
    });
  }
})();
</script>

{% schema %}
{
  "name": "HooknLoop cart",
  "tag": "section",
  "settings": [
    { "type": "number", "id": "free_ship_threshold", "label": "Free shipping over ($)", "default": 300, "info": "Set to 0 to hide the progress bar. This only displays the goal — set the actual free-shipping rate in Settings > Shipping." },
    { "type": "textarea", "id": "trust", "label": "Trust list", "info": "One per line.", "default": "✓ GST tax invoice on every order\n✓ Dispatched 1–2 business days Australia-wide\n✓ Ordered the wrong side? We'll sort it" }
  ]
}
{% endschema %}
