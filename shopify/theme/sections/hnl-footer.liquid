{%- comment -%}
  Footer — port of storefront/src/sections/Footer.jsx

  Two deliberate departures from the React source, both because Shopify gives us
  something better than the prototype had:

  1. Newsletter. React POSTed to its own /api/subscribe. Here it is Shopify's
     native {% form 'customer' %} — the same form the current live site uses,
     which is what feeds the Klaviyo "Email List" through the Shopify
     integration. Swapping in a custom endpoint would silently break that sync,
     and every Klaviyo flow hanging off it.

  2. Payment marks. React shipped its own SVGs and hardcoded which cards to show.
     shop.enabled_payment_types renders exactly what this store actually
     accepts, so the row can never advertise a method that fails at checkout.

  Link columns are `Label | /path` per line rather than Shopify menus, because
  the menus these columns need don't exist in the store's navigation yet and a
  missing menu renders an empty column with no warning.
{%- endcomment -%}

<footer class="ft">
  <div class="wrap ft__main">
    <div class="ft__brand">
      {%- if section.settings.logo != blank -%}
        <img class="ft__logo-img" src="{{ section.settings.logo | image_url: width: 780 }}" alt="{{ shop.name | escape }}" width="389" height="69">
      {%- else -%}
        <img class="ft__logo-img" src="{{ 'hnl-logo-footer.svg' | asset_url }}" alt="{{ shop.name | escape }}" width="389" height="69">
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="ft__tag">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if section.settings.phone != blank -%}
        <a class="ft__phone" href="tel:{{ section.settings.phone | replace: ' ', '' }}">
          <b>{{ section.settings.phone }}</b><span>{{ section.settings.phone_sub }}</span>
        </a>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <a class="ft__email" href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
      {%- endif -%}

      {%- if section.settings.abn != blank -%}
        <p class="ft__abn">{{ section.settings.abn }}</p>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'column' -%}
        <div class="ft__col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          <ul>
            {%- assign lines = block.settings.links | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign bits = line | strip | split: '|' -%}
              {%- liquid
                assign target = bits[1] | strip
                assign ok = true
                # A /pages/… line whose page has not been created yet would be a
                # dead footer link. Skip it rather than ship a 404.
                if target contains '/pages/'
                  assign ph = target | split: '/pages/' | last | split: '?' | first
                  unless pages[ph] != blank and pages[ph].handle
                    assign ok = false
                  endunless
                endif
              -%}
              {%- if bits.size >= 2 and ok -%}
                <li><a href="{{ target }}">{{ bits[0] | strip }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="ft__col ft__col--connect">
      <h4>{{ section.settings.signup_heading }}</h4>

      {%- form 'customer', class: 'ft__signup', id: 'hnl-footer-signup' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <p class="ft__signup-blurb">{{ section.settings.signup_blurb }}</p>

        {%- if form.posted_successfully? -%}
          <p class="ft__signup-ok">&#10003; {{ section.settings.signup_ok }}</p>
        {%- else -%}
          <div class="ft__signup-row">
            <input type="email"
                   name="contact[email]"
                   required
                   placeholder="{{ section.settings.signup_placeholder }}"
                   aria-label="Email address"
                   value="{{ form.email }}">
            <button type="submit">{{ section.settings.signup_button }}</button>
          </div>
          {%- if form.errors -%}
            <p class="ft__signup-err" role="alert">{{ form.errors.messages['email'] | default: 'Please check your email and try again.' }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- comment -%}
        Social row. Networks are listed here rather than hardcoded so adding
        one is an editor change; each renders only when it has a URL, so an
        empty setting never leaves a dead icon linking to "#" — which is what
        the React footer did.
      {%- endcomment -%}
      {%- assign networks = 'facebook,instagram,pinterest,linkedin,youtube' | split: ',' -%}
      {%- assign social_count = 0 -%}
      {%- for net in networks -%}
        {%- assign key = 'social_' | append: net -%}
        {%- if section.settings[key] != blank -%}{%- assign social_count = social_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}

      {%- if social_count > 0 -%}
        <div class="ft__social" aria-label="Social links">
          {%- for net in networks -%}
            {%- assign key = 'social_' | append: net -%}
            {%- assign url = section.settings[key] -%}
            {%- if url != blank -%}
              <a href="{{ url }}" class="ft__soc" rel="noopener noreferrer" target="_blank"
                 aria-label="{% render 'hnl-social-name', network: net %}">
                {% render 'hnl-social-icon', network: net %}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div class="ft__legal">
    <div class="wrap ft__legal-row">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.legal_name }}</span>

      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="ft__pay" aria-label="Accepted payment methods">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'ft__paymark' }}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <span class="ft__legal-links">
        {%- assign legal = section.settings.legal_links | newline_to_br | split: '<br />' -%}
        {%- for line in legal -%}
          {%- assign bits = line | strip | split: '|' -%}
          {%- if bits.size >= 2 -%}
            <a href="{{ bits[1] | strip }}">{{ bits[0] | strip }}</a>
          {%- endif -%}
        {%- endfor -%}
      </span>
    </div>

    {%- if section.settings.trademark != blank -%}
      <p class="wrap ft__velcro">{{ section.settings.trademark }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "HooknLoop footer",
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Falls back to the bundled HooknLoop wordmark." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Industrial hook & loop, dispatched fast across Australia." },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+61 3 4061 6287" },
    { "type": "text", "id": "phone_sub", "label": "Phone caption", "default": "Call our Australian team" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@hooknloop.com.au" },
    { "type": "text", "id": "abn", "label": "ABN", "default": "ABN 93 878 995 217" },

    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Stay in touch" },
    { "type": "text", "id": "signup_blurb", "label": "Blurb", "default": "Trade tips & bulk price drops. No spam — unsubscribe any time." },
    { "type": "text", "id": "signup_placeholder", "label": "Placeholder", "default": "you@company.com.au" },
    { "type": "text", "id": "signup_button", "label": "Button", "default": "Notify me" },
    { "type": "text", "id": "signup_ok", "label": "Success message", "default": "You're on the list — check your inbox." },

    { "type": "header", "content": "Social" },
    { "type": "url", "id": "social_facebook", "label": "Facebook" },
    { "type": "url", "id": "social_instagram", "label": "Instagram" },
    { "type": "url", "id": "social_pinterest", "label": "Pinterest" },
    { "type": "url", "id": "social_linkedin", "label": "LinkedIn" },
    { "type": "url", "id": "social_youtube", "label": "YouTube" },

    { "type": "header", "content": "Legal bar" },
    { "type": "text", "id": "legal_name", "label": "Copyright line", "default": "HooknLoop Australia · All rights reserved" },
    { "type": "textarea", "id": "legal_links", "label": "Legal links", "info": "One per line: Label | /path", "default": "Privacy | /pages/privacy-policy\nTerms | /pages/terms-conditions\nShipping | /pages/shipping-delivery\nReturns | /pages/return-policy" },
    { "type": "textarea", "id": "trademark", "label": "Trademark note", "default": "VELCRO® is a registered trademark of Velcro IP Holdings LLC. HooknLoop stocks genuine VELCRO® Brand product; other products are our own brand." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "links", "label": "Links", "info": "One per line: Label | /path" }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
