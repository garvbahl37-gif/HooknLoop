{%- comment -%}
  Product card — port of storefront/src/components/ProductCard.jsx

  Extracted from hnl-bestsellers so the homepage, collection page and PDP
  "Related products" all render the same card. One copy, one place to fix.

  Usage: {% render 'hnl-product-card', product: product %}

  Every card carries the SAME call to action, which is how the live store works —
  it has no "Choose options" anywhere. The button opens the Quick Add popup so
  the shopper picks size, colour and side without leaving the page.

  It is an <a> to the product page, not a <button>: the popup is a JS upgrade,
  so without JS (or if the product fetch fails) the link still takes the shopper
  somewhere they can buy. It also keeps the card crawlable.
{%- endcomment -%}

<article class="pc">
  <a href="{{ product.url }}" class="pc__media" aria-label="View {{ product.title | escape }}">
    {%- if product.compare_at_price > product.price -%}
      <span class="pc__badge">Sale</span>
    {%- endif -%}
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 640 | image_tag: class: 'pc__img', alt: product.title, loading: 'lazy' }}
    {%- endif -%}
    {%- if product.images[1] -%}
      {{ product.images[1] | image_url: width: 640 | image_tag: class: 'pc__img pc__img--alt', alt: '', aria-hidden: 'true', loading: 'lazy' }}
    {%- endif -%}
  </a>

  <div class="pc__body">
    <h3 class="pc__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    {%- comment -%}
      Judge.me holds this store's real ratings — the live site shows 4.0, 4.5
      and 5.0 on these same cards. This is its badge hook; the fallback below is
      only what shows before the widget paints, or for a product with no reviews
      yet. Hardcoding "No reviews yet" hid ratings the store had earned.
    {%- endcomment -%}
    <div class="pc__rating">
      <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}"></div>
      <span class="pc__rating-fallback">No reviews yet</span>
    </div>

    {%- if product.type != blank -%}
      <p class="pc__spec">{{ product.type }}</p>
    {%- elsif product.variants.size > 1 -%}
      <p class="pc__spec">{{ product.variants.size }} options available</p>
    {%- endif -%}

    <div class="pc__price">
      <span class="pc__set">From <b>{{ product.price_min | money }}</b> <span class="pc__gst">incl. GST</span></span>
    </div>

    {%- if product.available -%}
      <a href="{{ product.url }}" class="pc__add" data-hnl-quick-add="{{ product.handle }}">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 3H2"/></svg>
        {{ settings.hnl_card_cta | default: 'Add to cart' }}
      </a>
    {%- else -%}
      <a href="{{ product.url }}" class="pc__add" aria-disabled="true">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6h15l-1.5 9h-12z"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M6 6 5 3H2"/></svg>
        Sold out
      </a>
    {%- endif -%}
  </div>
</article>
