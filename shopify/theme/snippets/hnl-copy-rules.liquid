{%- comment -%}
  Store wording rules, applied to merchant HTML at render time.

  Why this exists rather than a find-and-replace on the products themselves:
  the phrases live in product.description, which is Shopify data. Editing it
  needs the Admin API, and this theme deploys with a Theme Access token that is
  theme-files-only (verified: the Admin API returns 401 for it). So the change
  is made where the copy is displayed.

  IMPORTANT — this is a display layer, not a data fix. The product record still
  says "100% nylon", so Shopify admin, the products.json feed, Google Shopping,
  Klaviyo emails and any app reading the description will all still show the old
  wording. Editing the twelve product descriptions in admin is the real fix;
  after that this snippet can be deleted.

  Usage: {% render 'hnl-copy-rules', html: product.description, handle: product.handle %}
{%- endcomment -%}

{%- liquid
  assign out = html

  # Longest first — "100% premium nylon" must not be left as "premium premium
  # nylon" by an earlier, shorter rule firing on the same text.
  assign out = out | replace: '100% premium nylon', 'premium nylon'
  assign out = out | replace: '100% Premium Nylon', 'Premium Nylon'
  assign out = out | replace: '100% premium Nylon', 'Premium Nylon'
  assign out = out | replace: '100 % premium nylon', 'premium nylon'

  assign out = out | replace: '100% nylon', 'premium nylon'
  assign out = out | replace: '100% Nylon', 'Premium Nylon'
  assign out = out | replace: '100 % nylon', 'premium nylon'
  assign out = out | replace: '100 % Nylon', 'Premium Nylon'
  assign out = out | replace: '100%nylon', 'premium nylon'
  assign out = out | replace: '100%Nylon', 'Premium Nylon'

  # ── Per-product corrections ────────────────────────────────────────────
  # Descriptions that advertise a size or colour the product does not sell.
  # Scoped by handle: "Colour - Black and White." is correct on other products,
  # so an unscoped replace would make those wrong instead.

  # Double Sided (Self-Gripping Back to Back): sells 12/15/25mm in Black only,
  # but the copy offered a 50mm and a White that have no variant behind them.
  if handle == 'double-sided-hook-and-loop'
    assign out = out | replace: 'Width - Comes in 12mm,15mm, 25mm, 50mm', 'Width - Comes in 12mm, 15mm and 25mm'
    assign out = out | replace: '12mm,15mm, 25mm, 50mm', '12mm, 15mm and 25mm'
    assign out = out | replace: 'Colour - Black and White.', 'Colour - Black.'
    assign out = out | replace: 'Black and White.', 'Black.'
  endif

  # Hook and Loop for Fabric: sells 25/50/100mm in Black and White, but the copy
  # listed eight colours and six widths — most with no variant behind them.
  if handle == 'hook-and-loop-for-fabric'
    assign out = out | replace: '– Black, Beige, Fawn, White, Navy, Olive Green, Charcoal Grey, Light Grey', '– Black, White'
    assign out = out | replace: 'Black, Beige, Fawn, White, Navy, Olive Green, Charcoal Grey, Light Grey', 'Black, White'
    assign out = out | replace: 'We also offer a complete range of widths to suit your project: 12, 20, 25, 38, 50, and 100 mm.', 'Available in 25, 50 and 100 mm.'
    assign out = out | replace: '12, 20, 25, 38, 50, and 100 mm.', '25, 50 and 100 mm.'
  endif

  echo out
-%}
