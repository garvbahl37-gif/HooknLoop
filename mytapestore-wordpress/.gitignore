# Local WordPress install (Playground writes ~10k core files + the SQLite DB here).
# Disposable: `rm -rf local/wordpress` then `npm start` rebuilds it, and
# `npm run import` repopulates it from content/.
local/

node_modules/

# Generated by scripts/build-css.sh from mytapestore-redesign/src/styles.
# Committed deliberately so the theme directory is deployable on its own —
# see the note in theme/style.css. Assets are synced, not authored, here.
theme/assets/fonts/
theme/assets/img/

# Playground snapshot built for internal review (151MB; rebuild with build-snapshot).
*.zip

# Handover secrets. build/release/ is where the developer package is assembled,
# and the wp-config snippet in it carries live API keys by design — it exists so
# the keys travel WITH the package instead of over chat. It must never travel
# into git as well.
build/release/*SECRETS*
build/release/*keys*

# Live API keys, generated into the theme by scripts/write-api-keys.sh so they
# travel inside the handover zip. Never committed — the file is rebuilt from
# .env whenever the package is rebuilt.
theme/MTS-API-KEYS.php
