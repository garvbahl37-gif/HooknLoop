{% comment %}
  MY TAPE STORE — ORDER CANCELLED
  Paste into: Settings > Notifications > Order cancelled > Edit code.

  TONE IS THE DESIGN DECISION HERE.
  A cancellation is the one transactional email where the customer may be
  unhappy, and the reflex — a big red banner and an apology paragraph — makes it
  feel worse than it is. Most cancellations on a trade store are routine: a
  duplicate order, a stock issue, a customer phoning to change something.

  So: no red alert, no apology. Neutral ink header, a calm slate status chip,
  and the two facts they actually need — that nothing will ship, and when the
  money comes back. Brand red appears once, on the button back to the catalogue,
  because re-ordering is the useful next action.
{% endcomment %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{ shop.name }} — order {{ order.name }} cancelled</title>
<style>
  body { margin:0 !important; padding:0 !important; width:100% !important; }
  img { border:0; line-height:100%; outline:none; text-decoration:none; }
  table { border-collapse:collapse !important; }
  a { color:#b32f18; }
  .mts-shell { width:600px; }
  @media only screen and (max-width:620px) {
    .mts-shell { width:100% !important; }
    .mts-pad { padding-left:22px !important; padding-right:22px !important; }
    .mts-h1 { font-size:23px !important; }
    .mts-cta a { display:block !important; }
  }
  @media (prefers-color-scheme: dark) {
    .mts-body { background:#141312 !important; }
    .mts-card { background:#1d1b19 !important; }
    .mts-ink { color:#f2efec !important; }
    .mts-muted { color:#a49d96 !important; }
    .mts-rule { border-color:#332f2b !important; }
    .mts-soft { background:#231f1c !important; }
    /* Masthead stays white in dark mode: the logo is charcoal and brand red on
       transparent, so an inverted ground makes it vanish. */
    .mts-mast { background:#ffffff !important; }
  }
</style>
</head>
<body class="mts-body" style="margin:0; padding:0; background:#f3f1ee; -webkit-font-smoothing:antialiased;">

<div style="display:none; font-size:1px; color:#f3f1ee; line-height:1px; max-height:0; max-width:0; opacity:0; overflow:hidden;">
  Order {{ order.name }} has been cancelled and nothing will be shipped.
</div>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f1ee;">
<tr><td align="center" style="padding:28px 12px 44px 12px;">
<table role="presentation" class="mts-shell" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px;">

  <tr><td class="mts-mast" style="background:#ffffff; border-radius:12px 12px 0 0; padding:26px 34px 22px 34px; border-bottom:3px solid #df3c22;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
      <td align="left" valign="middle" style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <img src="https://cdn.shopify.com/s/files/1/0783/2017/3161/files/mytapestore-checkout-logo-420.png?v=1786910098"
             alt="{{ shop.name }}" width="176" height="31"
             style="display:block; width:176px; max-width:176px; height:auto; border:0;">
      </td>
      <td align="right" valign="middle" style="font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:11px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; color:#8a8078;">
        Order {{ order.name }}
      </td>
    </tr></table>
  </td></tr>

  <tr><td class="mts-card mts-pad" style="background:#ffffff; padding:38px 34px 0 34px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <div class="mts-soft" style="display:inline-block; background:#eceae6; color:#5d5651; font-size:11px; font-weight:700; letter-spacing:1.3px; text-transform:uppercase; padding:6px 11px; border-radius:6px;">Cancelled</div>
    <h1 class="mts-h1 mts-ink" style="margin:16px 0 0 0; font-size:27px; line-height:1.22; font-weight:700; color:#1f1f1f; letter-spacing:-0.5px;">
      Order {{ order.name }} has been cancelled.
    </h1>
    <p class="mts-muted" style="margin:11px 0 0 0; font-size:15px; line-height:1.6; color:#5d5651;">
      Nothing from this order will be shipped, and you won't be charged for it.
      {% if order.cancel_reason %} Reason recorded: {{ order.cancel_reason_label | downcase }}.{% endif %}
    </p>
  </td></tr>

  {% if order.financial_status == 'refunded' or order.financial_status == 'partially_refunded' %}
  <tr><td class="mts-card mts-pad" style="background:#ffffff; padding:24px 34px 0 34px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mts-soft" style="background:#f6f4f1; border-radius:10px;">
      <tr><td style="padding:18px 20px;">
        <div class="mts-muted" style="font-size:11px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; color:#8a8078;">Refund</div>
        <div class="mts-ink" style="font-size:15px; line-height:1.6; color:#1f1f1f; margin-top:6px;">
          <strong>{{ order.total_refunded_amount | money_with_currency }}</strong> is on its way back to your original payment method.
          <span class="mts-muted" style="color:#5d5651;">Banks usually take 3–5 business days to show it.</span>
        </div>
      </td></tr>
    </table>
  </td></tr>
  {% endif %}

  <tr><td class="mts-card mts-pad" style="background:#ffffff; padding:0 34px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mts-rule" style="border-top:1px solid #e6e1da; margin-top:24px;">
      <tr><td style="padding:20px 0 14px 0;">
        <span class="mts-muted" style="font-size:11px; font-weight:700; letter-spacing:1.4px; text-transform:uppercase; color:#8a8078;">What was cancelled</span>
      </td></tr>
      {% for line in order.line_items %}
      <tr><td style="padding:0 0 13px 0;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"><tr>
          <td width="52" valign="top" style="padding-right:13px;">
            {% if line.image %}
              <img src="{{ line | img_url: 'compact_cropped' }}" alt="" width="52" height="52" class="mts-soft" style="display:block; width:52px; height:52px; border-radius:7px; background:#f3f1ee;">
            {% endif %}
          </td>
          <td valign="top" style="font-size:14px; line-height:1.5;">
            <div class="mts-ink" style="font-weight:600; color:#1f1f1f;">{{ line.title }}</div>
            {% if line.variant_title and line.variant_title != 'Default Title' %}
              <div class="mts-muted" style="color:#6d6660; font-size:13px; margin-top:2px;">{{ line.variant_title }}</div>
            {% endif %}
            <div class="mts-muted" style="color:#6d6660; font-size:13px; margin-top:3px;">Qty {{ line.quantity }}</div>
          </td>
          <td valign="top" align="right" class="mts-muted" style="font-size:14px; color:#5d5651; white-space:nowrap;">{{ line.final_line_price | money }}</td>
        </tr></table>
      </td></tr>
      {% endfor %}
      <tr>
        <td class="mts-ink mts-rule" style="padding:14px 0 20px 0; border-top:1px solid #e6e1da; font-size:15px; font-weight:700; color:#1f1f1f;">Order total</td>
        <td class="mts-ink mts-rule" align="right" style="padding:14px 0 20px 0; border-top:1px solid #e6e1da; font-size:15px; font-weight:700; color:#1f1f1f;">{{ order.total_price | money_with_currency }}</td>
      </tr>
    </table>
  </td></tr>

  <tr><td class="mts-card mts-pad" style="background:#ffffff; padding:0 34px 34px 34px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; border-radius:0 0 12px 12px;">
    <table role="presentation" cellpadding="0" cellspacing="0" class="mts-cta"><tr>
      <td style="background:#df3c22; border-radius:7px;">
        <a href="{{ shop.url }}" style="display:inline-block; padding:14px 28px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">Browse the range</a>
      </td>
    </tr></table>
  </td></tr>

  <tr><td style="padding:20px 0 0 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="mts-soft" style="background:#eceae6; border-radius:12px;">
      <tr><td class="mts-pad" style="padding:22px 30px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
        <div class="mts-ink" style="font-size:15px; font-weight:600; color:#1f1f1f;">Cancelled by mistake?</div>
        <div class="mts-muted" style="font-size:14px; line-height:1.6; color:#5d5651; margin-top:5px;">
          Reply to this email and we'll put it straight back through — no need to re-enter anything.
          <br>Or email <a href="mailto:info@mytapestore.com.au" style="color:#b32f18; text-decoration:underline;">info@mytapestore.com.au</a>
        </div>
      </td></tr>
    </table>
  </td></tr>

  <tr><td style="padding:24px 30px 0 30px; font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif; text-align:center;">
    <div class="mts-muted" style="font-size:12.5px; line-height:1.65; color:#8a8078;">
      {{ shop.name }}<br>
      <a href="{{ shop.url }}" style="color:#8a8078; text-decoration:underline;">{{ shop.domain }}</a>
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
