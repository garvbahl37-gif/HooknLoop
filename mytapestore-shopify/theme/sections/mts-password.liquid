<main id="main" class="mts-password">
  <div class="wrap">
    <img class="mts-password__logo" src="{{ 'mts-logo.png' | asset_url }}" alt="{{ shop.name }}" width="196" height="34">
    <h1>{{ shop.name }}</h1>
    <p>{{ shop.password_message | default: 'We are opening soon.' }}</p>

    {%- form 'storefront_password', class: 'contact__form' -%}
      {{ form.errors | default_errors }}
      <label>Enter store password<input type="password" name="password" autocomplete="current-password"></label>
      <button class="btn btn--brand btn--lg" type="submit">Enter</button>
    {%- endform -%}
  </div>
</main>

{% schema %}
{ "name": "Password" }
{% endschema %}
