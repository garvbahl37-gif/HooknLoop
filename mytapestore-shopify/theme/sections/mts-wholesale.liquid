{%- comment -%}
  Wholesale / bulk — ported from the Wholesale section in home.jsx.
  Image left, copy and a five-item perk list right.
{%- endcomment -%}
<section class="section wholesale">
  <div class="wrap wholesale__grid">
    <div class="wholesale__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1020">
      {%- else -%}
        <img src="{{ 'mts-bulk-wholesale.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1020">
      {%- endif -%}
    </div>

    <div class="wholesale__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="wholesale__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="wholesale__intro">{{ section.settings.intro }}</p>{%- endif -%}

      <ul class="wholesale__perks">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="wholesale__ic">{% render 'mts-icon', name: block.settings.icon, size: 18 %}</span>
            <div>
              <b>{{ block.settings.title }}</b>
              <span>{{ block.settings.text }}</span>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn--brand btn--lg">
          {{ section.settings.cta_label }} {% render 'mts-icon', name: 'arrowRight', size: 18 %}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Wholesale",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Warehouse pallets stacked with adhesive tape stock" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wholesale & bulk" },
    {
      "type": "text", "id": "heading", "label": "Heading",
      "default": "Buy adhesive tape in bulk — wholesale pricing for Australia"
    },
    {
      "type": "textarea", "id": "intro", "label": "Intro",
      "default": "Australia's trusted tape experts. We're proud to supply thousands of individuals and businesses with tailored solutions and quality products."
    },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Bulk & trade pricing" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" },
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "tag", "label": "Tag" },
            { "value": "truck", "label": "Truck" },
            { "value": "layers", "label": "Layers" },
            { "value": "factory", "label": "Factory" },
            { "value": "shield", "label": "Shield" },
            { "value": "warehouse", "label": "Warehouse" }
          ],
          "default": "tag"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale",
      "blocks": [
        { "type": "perk", "settings": { "icon": "tag", "title": "Significant discounts", "text": "Save more when you order in bulk — contact us for substantial reductions on large quantities." } },
        { "type": "perk", "settings": { "icon": "truck", "title": "Quick delivery across Australia", "text": "Fast, reliable shipping so your bulk tape orders arrive exactly when you need them." } },
        { "type": "perk", "settings": { "icon": "layers", "title": "Cost-effective stock management", "text": "Keep a well-stocked inventory without breaking the bank, even with high tape usage." } },
        { "type": "perk", "settings": { "icon": "factory", "title": "Tailored wholesale services", "text": "Customised wholesale solutions built around your business's specific needs." } },
        { "type": "perk", "settings": { "icon": "shield", "title": "Trusted tape suppliers", "text": "Consistent quality and after-sales service — all your adhesive needs, always covered." } }
      ]
    }
  ]
}
{% endschema %}
