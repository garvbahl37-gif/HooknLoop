{%- comment -%}
  Intro band — ported from the IntroBand section in home.jsx. Heading + CTA on
  the left, lead copy and brand chips on the right, then a four-up stat strip.

  The React version computed the stats from the catalogue (average rating,
  industry count). Shopify has no equivalent to hand, so they are blocks — which
  also stops them drifting out of date silently.
{%- endcomment -%}
<section class="section intro">
  <div class="wrap intro__grid">
    <div class="intro__head">
      {%- comment -%}
        Plain eyebrow. The h1 belongs on the opening banner, not here — one h1
        per page, and it should be the first thing on it.
      {%- endcomment -%}
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="intro__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn--brand btn--lg intro__cta">
          {{ section.settings.cta_label }} {% render 'mts-icon', name: 'arrowRight', size: 18 %}
        </a>
      {%- endif -%}
    </div>
    <div class="intro__body">
      {%- if section.settings.lead != blank -%}
        <p class="intro__lead">{{ section.settings.lead }}</p>
      {%- endif -%}
      {%- if section.settings.brands != blank -%}
        <div class="intro__brands">
          <span class="intro__brands-label">{{ section.settings.brands_label }}</span>
          <ul class="intro__chips">
            {%- assign brand_list = section.settings.brands | split: ',' -%}
            {%- for b in brand_list -%}
              <li class="intro__chip">{{ b | strip }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="wrap">
      <div class="intro__stats">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <b class="num">{{ block.settings.value }}</b>
            <span>{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Intro band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Adhesive tape suppliers in Australia" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Buy tapes online from My Tape Store" },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop the full range" },
    { "type": "url", "id": "cta_url", "label": "Button link" },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead copy",
      "default": "We bring a complete range of adhesive tapes to trade and DIY customers Australia-wide. Whether you work in construction, retail, packaging or transport, we've got you covered — with fast delivery at fair prices and bulk-order discounts."
    },
    { "type": "text", "id": "brands_label", "label": "Brand chips label", "default": "Trusted brands we stock" },
    {
      "type": "text",
      "id": "brands",
      "label": "Brand chips",
      "info": "Comma separated.",
      "default": "FrogTape®, T-Rex®, Shurtape, Husky Tape, Kikusui, Acribond, VELCRO®"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "3,600+" },
        { "type": "text", "id": "label", "label": "Label", "default": "AU postcodes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Intro band",
      "blocks": [
        { "type": "stat", "settings": { "value": "4.9★", "label": "Highly rated by customers" } },
        { "type": "stat", "settings": { "value": "26", "label": "Industries served" } },
        { "type": "stat", "settings": { "value": "3,600+", "label": "AU postcodes" } },
        { "type": "stat", "settings": { "value": "2–3", "label": "Day typical delivery" } }
      ]
    }
  ]
}
{% endschema %}
