{%- comment -%}
  "A more comprehensive range" — ported from RangeSection in home.jsx.
  Copy column with three icon blocks, image column alongside.
{%- endcomment -%}
<section class="section range">
  <div class="wrap range__grid">
    <div class="range__copy">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}

      <div class="range__blocks">
        {%- for block in section.blocks -%}
          <div class="range__block" {{ block.shopify_attributes }}>
            <span class="range__ic">{% render 'mts-icon', name: block.settings.icon, size: 20 %}</span>
            <div>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--brand btn--lg range__cta">
          {{ section.settings.cta_label }} {% render 'mts-icon', name: 'arrowRight', size: 18 %}
        </a>
      {%- endif -%}
    </div>

    <div class="range__media">
      {%- if section.settings.image != blank -%}
        <img src="{{ section.settings.image | image_url: width: 1200 }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1200">
      {%- else -%}
        <img src="{{ 'mts-range.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1200" height="1200">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Range",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A more comprehensive range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Adhesive tapes for every purpose" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text", "id": "image_alt", "label": "Image alt text",
      "default": "A range of adhesive tapes — packaging, duct, masking, foil, cloth and electrical"
    },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Explore the full range" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Range block",
      "limit": 5,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "General-purpose adhesive tapes" },
        { "type": "textarea", "id": "text", "label": "Text" },
        {
          "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "layers", "label": "Layers" },
            { "value": "spool", "label": "Spool" },
            { "value": "factory", "label": "Factory" },
            { "value": "shield", "label": "Shield" },
            { "value": "tag", "label": "Tag" },
            { "value": "warehouse", "label": "Warehouse" }
          ],
          "default": "layers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Range",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "General-purpose adhesive tapes",
            "text": "Cost-effective, versatile tapes for everyday packaging, bundling and assembly — dependable hold across countless jobs."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Specialty adhesive tapes",
            "text": "Engineered for specific applications: high-bond, glazing, thermal, fire-retardant and more, where a standard tape won't do."
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Construction & industrial tapes",
            "text": "Rugged tapes built for the site — flashing, cloth, foil and duct grades that stand up to demanding conditions."
          }
        }
      ]
    }
  ]
}
{% endschema %}
