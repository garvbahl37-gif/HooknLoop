{%- comment -%}
  Brand wall — ported from BrandWall in home.jsx. Dark band, an infinite logo
  marquee (the track holds the logo set three times so the step-and-hold loop
  can rewind invisibly — the outer copies are aria-hidden), then three stats.
{%- endcomment -%}
<section class="brandx grain">
  <div class="wrap brandx__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow eyebrow--onink">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="brandx__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="brandx__sub">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>

  {%- assign logo_blocks = section.blocks | where: 'type', 'logo' -%}
  {%- if logo_blocks.size > 0 -%}
    <div class="brandx__slider">
      <div class="brandx__track">
        {%- comment -%}
          THREE passes, not two. Pass 2 is the one that is actually driven; the
          copies either side exist so the rail can rewind invisibly.

          With only two copies the loop had to reset to the very first plate,
          which has nothing to its left — so the rewind showed a gap and the
          rail visibly restarted after the last brand. Centring inside the
          MIDDLE copy means every plate always has real logos on both sides,
          and the jump back is one copy-width with identical pixels either side
          of it. Passes 1 and 3 are aria-hidden so a screen reader still hears
          the brand list exactly once.

          pass 1: lead-in copy, pass 2: the real logos, pass 3: run-out copy

          NOT lazy-loaded, deliberately. The track is `width: max-content`
          inside an `overflow: hidden` slider, so most plates sit outside the
          scrollport at load. `loading="lazy"` therefore holds their fetch back
          until the animation walks each one into view — you watch the logo
          arrive in an already-visible plate, which reads as a broken image.
          The whole rail is ~46KB, so it is fetched up front instead, at low
          priority so it never competes with anything above the fold.
        {%- endcomment -%}
        {%- for pass in (1..3) -%}
          {%- for block in logo_blocks -%}
            <div class="brandx__plate">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 320 }}"
                     alt="{% if pass == 2 %}{{ block.settings.name | escape }}{% endif %}"
                     {% unless pass == 2 %}aria-hidden="true"{% endunless %}
                     class="brandx__logo" width="223" height="143"
                     decoding="async" fetchpriority="low">
              {%- elsif block.settings.packaged_logo != 'none' -%}
                {%- comment -%}
                  Every packaged logo now sits on the same 223:143 canvas, so
                  one declared size is correct for all of them. The VELCRO®
                  exception that lived here was for the old metal-nameplate
                  badge (a 4.49:1 bar); the current logo is composed like the
                  rest and no longer needs it.
                {%- endcomment -%}
                {%- liquid
                  assign logo_w = 223
                  assign logo_h = 143
                -%}
                <img src="{{ block.settings.packaged_logo | asset_url }}"
                     alt="{% if pass == 2 %}{{ block.settings.name | escape }}{% endif %}"
                     {% unless pass == 2 %}aria-hidden="true"{% endunless %}
                     class="brandx__logo" width="{{ logo_w }}" height="{{ logo_h }}"
                     decoding="async" fetchpriority="low">
              {%- elsif block.settings.name != blank -%}
                {%- comment -%}
                  Wordmark fallback. A brand with no logo file used to render an
                  empty plate — a gap in the marquee that looks like a failed
                  image. Setting the name in the display face keeps the rail
                  complete until the real artwork is supplied.
                {%- endcomment -%}
                <span class="brandx__wordmark" {% unless pass == 2 %}aria-hidden="true"{% endunless %}>
                  {{ block.settings.name }}
                </span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- if stat_blocks.size > 0 -%}
    <div class="wrap brandx__stats">
      {%- for block in stat_blocks -%}
        <div class="brandx__stat" {{ block.shopify_attributes }}>
          <b class="num">{{ block.settings.value }}</b>
          <span>{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brand wall",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted brands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We partner with the best tape brands" },
    {
      "type": "textarea", "id": "text", "label": "Text",
      "default": "Genuine, trade-grade products from the names professionals rely on — plus our own value lines."
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand logo",
      "settings": [
        { "type": "text", "id": "name", "label": "Brand name" },
        { "type": "image_picker", "id": "image", "label": "Logo" },
        {
          "type": "select",
          "id": "packaged_logo",
          "label": "Packaged logo",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "mts-brand-1.png", "label": "Logo 1" },
            { "value": "mts-brand-2.png", "label": "Logo 2" },
            { "value": "mts-brand-3.png", "label": "Logo 3" },
            { "value": "mts-brand-4.png", "label": "Logo 4" },
            { "value": "mts-brand-5.png", "label": "Logo 5" },
            { "value": "mts-brand-6.png", "label": "Logo 6" },
            { "value": "mts-brand-7.png", "label": "Logo 7" },
            { "value": "mts-brand-8.png", "label": "Logo 8" }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "6" },
        { "type": "text", "id": "label", "label": "Label", "default": "Leading brands" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand wall",
      "blocks": [
        { "type": "logo", "settings": { "name": "FrogTape", "packaged_logo": "mts-brand-6.png" } },
        { "type": "logo", "settings": { "name": "T-Rex", "packaged_logo": "mts-brand-4.png" } },
        { "type": "logo", "settings": { "name": "Shurtape", "packaged_logo": "mts-brand-2.png" } },
        { "type": "logo", "settings": { "name": "Husky Tape", "packaged_logo": "mts-brand-3.png" } },
        { "type": "logo", "settings": { "name": "Kikusui", "packaged_logo": "mts-brand-1.png" } },
        { "type": "logo", "settings": { "name": "Acribond", "packaged_logo": "mts-brand-5.png" } },
        { "type": "logo", "settings": { "name": "VELCRO®", "packaged_logo": "mts-brand-7.png" } },
        { "type": "logo", "settings": { "name": "My Tape Store", "packaged_logo": "mts-brand-8.png" } },
        { "type": "stat", "settings": { "value": "12", "label": "Leading brands" } },
        { "type": "stat", "settings": { "value": "130+", "label": "Genuine tapes" } },
        { "type": "stat", "settings": { "value": "100%", "label": "Trade-grade quality" } }
      ]
    }
  ]
}
{% endschema %}
