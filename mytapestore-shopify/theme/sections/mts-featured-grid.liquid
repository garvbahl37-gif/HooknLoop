{%- comment -%}
  "Popular right now" — ported from FeaturedGrid in home.jsx. Four product cards
  from a chosen collection (the React version read BESTSELLER_HANDLES).
{%- endcomment -%}
<section class="section{% if section.settings.paper %} section--paper{% endif %}">
  <div class="wrap">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    </div>

    {%- assign coll = collections[section.settings.collection] -%}
    <div class="grid-products grid-products--5">
      {%- for product in coll.products limit: section.settings.count -%}
        {% render 'mts-product-card', product: product, index: forloop.index0 %}
      {%- else -%}
        {%- comment -%} Fresh store with nothing imported yet — show the real card shape. {%- endcomment -%}
        {%- for i in (1..section.settings.count) -%}
          <article class="pc">
            <div class="pc__media">{{ 'product-1' | placeholder_svg_tag }}</div>
            <div class="pc__body">
              <h3 class="pc__name"><a href="{{ routes.all_products_collection_url }}">Product title</a></h3>
              <div class="pc__foot">
                <div class="pc__price"><b class="num">{{ 1990 | money }}</b><span class="pc__gst">{{ 'products.product.inc_gst' | t }}</span></div>
              </div>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="section-cta">
        <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--ghost btn--lg">
          {{ section.settings.cta_label }} {% render 'mts-icon', name: 'arrowRight', size: 18 %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular right now" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products shown", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "paper", "label": "Warm background band", "default": false },
    { "type": "text", "id": "cta_label", "label": "Button", "default": "Shop all products" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
