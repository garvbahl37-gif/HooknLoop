<main id="main">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow eyebrow--onink">Account</span>
      <h1>{{ 'customer.reset_password.title' | t }}</h1>
      <p>{{ 'customer.reset_password.subtext' | t }}</p>
    </div>
  </section>
  <div class="wrap mts-auth">
    <div class="contact__form">
      {%- form 'reset_customer_password' -%}
        {{ form.errors | default_errors }}
        <label>{{ 'customer.reset_password.password' | t }}<input type="password" name="customer[password]" required autocomplete="new-password"></label>
        <label>{{ 'customer.reset_password.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" required autocomplete="new-password"></label>
        <button class="btn btn--brand btn--lg" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</main>

{% schema %}
{ "name": "Reset password" }
{% endschema %}
