{%- comment -%}
  Shared address form fields for the customer address forms.
  Params: form
{%- endcomment -%}
<div class="contact__row">
  <label>{{ 'customer.addresses.first_name' | t }}<input type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></label>
  <label>{{ 'customer.addresses.last_name' | t }}<input type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></label>
</div>
<label>{{ 'customer.addresses.company' | t }}<input type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></label>
<label>{{ 'customer.addresses.address1' | t }}<input type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></label>
<label>{{ 'customer.addresses.address2' | t }}<input type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></label>
<div class="contact__row">
  <label>{{ 'customer.addresses.city' | t }}<input type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></label>
  <label>{{ 'customer.addresses.zip' | t }}<input type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></label>
</div>
<div class="contact__row">
  <label>
    {{ 'customer.addresses.country' | t }}
    <select name="address[country]" data-default="{{ form.country }}" data-mts-address-country autocomplete="country">
      {{ country_option_tags }}
    </select>
  </label>
  <label data-mts-address-province-wrap>
    {{ 'customer.addresses.province' | t }}
    <select name="address[province]" data-default="{{ form.province }}" data-mts-address-province autocomplete="address-level1"></select>
  </label>
</div>
<label>{{ 'customer.addresses.phone' | t }}<input type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></label>
<label class="filt__check mts-address__default">
  {{ form.set_as_default_checkbox }}
  <span>{{ 'customer.addresses.set_default' | t }}</span>
</label>
