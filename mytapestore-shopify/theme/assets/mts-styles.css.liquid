  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--faint);
}
.rail-dd__opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 14px;
  font-size: 0.92rem;
  color: var(--ink-2);
  transition: background .12s var(--ease), color .12s var(--ease);
}
.rail-dd__opt b { font-size: var(--t-xs); color: var(--faint); font-weight: 600; }
.rail-dd__opt:hover,
.rail-dd__opt.is-focus { background: var(--paper); color: var(--brand-ink); }
.rail-dd__opt.is-active {
  background: var(--brand-wash);
  color: var(--brand-ink);
  font-weight: 600;
}
.rail-dd__opt.is-active b { color: var(--brand-ink); }
.rail--select .rail__none { padding: 14px; font-size: var(--t-sm); color: var(--muted); }

/* --- filter sidebar --------------------------------------------------------
   Matches the live mytapestore.com.au sidebar: collapsible group headings with
   a chevron and a short brand underline, options carrying their result count.
   The card chrome from the ported .filt-card is dropped — on the original each
   group is its own band separated by a rule, not one boxed panel. */
.filt-card {
  border: 0;
  background: none;
  border-radius: 0;
  padding: 0;
  overflow: visible;
}
.filt-card__head { display: none; }

.filt {
  border: 0;
  padding: 0;
  margin-bottom: 22px;
}
.filt__title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 0 0 9px;
  margin: 0;
  background: none;
  border: 0;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: var(--t-sm);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  position: relative;
  border-bottom: 1px solid var(--line);
}
/* the short brand underline from the original */
.filt__title::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 46px;
  height: 2px;
  background: var(--brand);
}
.filt__chev { color: var(--muted); transition: transform .2s var(--ease); flex-shrink: 0; }
.filt__title[aria-expanded="false"] .filt__chev { transform: rotate(-90deg); }

.filt__body { padding-top: 12px; }
/* long option lists scroll inside their own group rather than pushing the page */
.filt__colours,
.filt__cats {
  display: block;
  max-height: 260px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: var(--line-2) transparent;
}
.filt__colours::-webkit-scrollbar,
.filt__cats::-webkit-scrollbar { width: 8px; }
.filt__colours::-webkit-scrollbar-thumb,
.filt__cats::-webkit-scrollbar-thumb {
  background: var(--line-2); border-radius: 100px; border: 2px solid #fff;
}

.filt__check {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  font-size: 0.92rem;
  color: var(--ink-2);
  cursor: pointer;
  min-width: 0;
}
/* :not(.filt__dot) matters. The colour swatch is itself a <span>, so a bare
   `.filt__check > span { flex: 1 }` made it grow to fill the row — a 17px
   circle stretched into a 200px ellipse. That selector also outranks
   `.filt__dot`'s own width, so the width there could never win. */
.filt__check > span:not(.filt__dot) {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filt__check input { flex-shrink: 0; accent-color: var(--brand); width: 16px; height: 16px; }
.filt__check:hover > span { color: var(--brand-ink); }
.filt__check input:disabled ~ span { opacity: .45; }
.filt__count {
  flex-shrink: 0;
  font-size: var(--t-xs);
  font-weight: 600;
  color: var(--faint);
}
.filt__dot {
  flex: 0 0 17px;            /* never grow, never shrink — it is a circle */
  width: 17px;
  height: 17px;
  border-radius: 50%;
  border: 1px solid var(--line-2);
  background: var(--paper);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.5);
}

.filt__clear {
  display: inline-block;
  margin-top: 4px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: var(--t-sm);
  color: var(--brand-ink);
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* the sidebar itself must never clip the category dropdown or scroll sideways */
.col__side { overflow: visible; min-width: 0; }
.col__layout { min-width: 0; }

/* --- mega-menu overflow ----------------------------------------------------
   A 3-column panel opening from a mid-nav item is ~570px wide, and below about
   1200px that runs past the right edge — the page scrolled 110px sideways at
   1024px. body{overflow-x:clip} did not catch it because the scrollport is on
   <html>, not <body>, and once the nav is position:fixed it is outside body's
   clip anyway.

   Fixed at the source: below 1200px every panel anchors to the right edge of
   its trigger, so it opens inwards and can never leave the viewport. The clip
   on <html> is the belt-and-braces guard for anything else that misbehaves. */
html { overflow-x: clip; }

@media (max-width: 1200px) {
  .hd-nav__item .hd-mega,
  .hd-nav__item--wide .hd-mega {
    left: auto;
    right: 0;
    transform: translateY(8px) scale(0.98);
  }
  .hd-nav__item.is-open .hd-mega,
  .hd-nav__item--wide.is-open .hd-mega {
    transform: translateY(0) scale(1);
  }
}
/* The panel can never be wider than the page gutters allow. It must NOT wrap:
   flex-wrap here collapsed the three mega-menu columns into one very long
   single column, which is what turned the nav into "one big dropdown". Columns
   stay side by side; the right-anchoring above is what keeps them on screen. */
.hd-mega { max-width: calc(100vw - 32px); }
.hd-mega__cols { flex-wrap: nowrap; }

/* --- Judge.me -------------------------------------------------------------
   The app ships its own typography, buttons and star colours. Mapped onto the
   theme's tokens so the reviews read as part of the store rather than as an
   embedded widget. Selectors are the app's stable public classes (jdgm-*),
   not build-hashed internals. */
.jdgm-widget,
.jdgm-widget * { font-family: var(--f-body) !important; }

.jdgm-rev-widg__title,
.jdgm-histogram__summary-title,
.jdgm-rev-widg__summary-average {
  font-family: var(--f-head) !important;
  color: var(--ink) !important;
  letter-spacing: -0.01em;
}
.jdgm-star { color: var(--star) !important; }

/* primary action — the theme's brand button, tight radius, uppercase head face */
.jdgm-write-rev-link,
.jdgm-rev-widg__sort-wrapper .jdgm-sort-dropdown,
.jdgm-btn,
.jdgm-submit-rev {
  font-family: var(--f-head) !important;
  font-weight: 700 !important;
  border-radius: 10px !important;
}
.jdgm-write-rev-link,
.jdgm-submit-rev {
  background: var(--brand-cta) !important;
  border-color: var(--brand-cta) !important;
  color: #fff !important;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  transition: background .16s var(--ease) !important;
}
.jdgm-write-rev-link:hover,
.jdgm-submit-rev:hover { background: var(--brand-cta-hov) !important; }

/* review cards pick up the store's hairline-and-radius vocabulary */
.jdgm-rev {
  border-color: var(--line) !important;
  padding-block: 18px !important;
}
.jdgm-rev__author { font-family: var(--f-head) !important; color: var(--ink) !important; }
.jdgm-rev__timestamp, .jdgm-rev__location { color: var(--faint) !important; }
.jdgm-rev__body { color: var(--ink-2) !important; line-height: 1.6 !important; }
.jdgm-rev__buyer-badge {
  background: color-mix(in srgb, var(--stock) 10%, #fff) !important;
  color: var(--stock) !important;
  border-radius: var(--r) !important;
}

/* the write-a-review form: theme inputs, not the app's defaults */
.jdgm-form input[type="text"],
.jdgm-form input[type="email"],
.jdgm-form textarea {
  border: 1.5px solid var(--line-2) !important;
  border-radius: 10px !important;
  font-family: var(--f-body) !important;
  color: var(--ink) !important;
  padding: 12px 14px !important;
}
.jdgm-form input:focus, .jdgm-form textarea:focus {
  outline: none !important;
  border-color: var(--ink) !important;
}
.jdgm-form__title, .jdgm-form label { font-family: var(--f-head) !important; color: var(--ink-2) !important; }

/* the preview badge sits inline with the product title block */
.pdp-buy__rating .jdgm-preview-badge { display: inline-flex; align-items: center; gap: 8px; }
.jdgm-prev-badge__text { font-size: var(--t-sm) !important; color: var(--muted) !important; }

/* never let the widget push the page sideways */
.jdgm-widget { max-width: 100%; overflow-x: hidden; }

/* --- policy pages ----------------------------------------------------------
   Long legal prose is a different typographic problem to marketing copy: it is
   scanned rather than read, its headings ARE the navigation, and it runs to
   thousands of words. Shopify's fallback set 18,000 characters full-width with
   no hierarchy, which is unreadable.

   Three things fix that: a measure capped near 70 characters, headings with
   enough space above them to act as landmarks, and a clear step between levels
   so the structure survives skimming. */
.mts-policy {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  gap: 48px;
  align-items: start;
  padding-block: 44px 8px;
}
@media (max-width: 940px) {
  .mts-policy { grid-template-columns: 1fr; gap: 28px; }
}

.mts-policy__body {
  max-width: 70ch;              /* the readable measure for continuous prose */
  color: var(--ink-2);
  font-size: 1.0625rem;
  line-height: 1.75;            /* looser than marketing copy — long-form needs air */
}
.mts-policy__body > *:first-child { margin-top: 0; }

.mts-policy__body h1,
.mts-policy__body h2,
.mts-policy__body h3,
.mts-policy__body h4,
.mts-policy__body strong > br + strong {
  font-family: var(--f-head);
  color: var(--ink);
  line-height: 1.2;
  letter-spacing: -0.01em;
}
/* space ABOVE a heading is what makes it read as a landmark */
.mts-policy__body h2 { font-size: 1.35rem; margin: 40px 0 12px; }
.mts-policy__body h3 { font-size: 1.1rem;  margin: 32px 0 10px; }
.mts-policy__body h4 { font-size: 1rem;    margin: 26px 0 8px; }

/* Shopify's policy editor often emits bold paragraphs as pseudo-headings */
.mts-policy__body p > strong:only-child {
  display: block;
  font-family: var(--f-head);
  font-size: 1.1rem;
  color: var(--ink);
  margin-top: 30px;
  margin-bottom: 2px;
}

.mts-policy__body p { margin-bottom: 16px; }
.mts-policy__body ul,
.mts-policy__body ol { margin: 0 0 18px 0; padding-left: 22px; }
.mts-policy__body ul { list-style: disc; }
.mts-policy__body ol { list-style: decimal; }
.mts-policy__body li { margin-bottom: 8px; padding-left: 4px; }
.mts-policy__body li::marker { color: var(--brand); }

.mts-policy__body a {
  color: var(--brand-ink);
  text-decoration: underline;
  text-underline-offset: 2px;
  overflow-wrap: anywhere;      /* long URLs in legal text must not overflow */
}
.mts-policy__body hr { border: 0; border-top: 1px solid var(--line); margin: 32px 0; }
.mts-policy__body table { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-sm); }
.mts-policy__body th, .mts-policy__body td { border: 1px solid var(--line); padding: 10px 12px; text-align: left; }

/* help panel sticks alongside the prose on desktop */
.mts-policy__help {
  position: sticky;
  top: 88px;
  padding: 22px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
}
.mts-policy__help h2 {
  font-family: var(--f-head);
  font-size: 1.05rem;
  color: var(--ink);
  margin-bottom: 8px;
}
.mts-policy__help p { font-size: var(--t-sm); color: var(--muted); margin-bottom: 16px; line-height: 1.6; }
.mts-policy__help-actions { display: grid; gap: 8px; }
.mts-policy__help-actions .btn { width: 100%; justify-content: center; }
@media (max-width: 940px) { .mts-policy__help { position: static; } }

/* --- Shopify's own policy markup -------------------------------------------
   Shopify renders /policies/* through its built-in shopify-policy__* markup and
   ignores templates/policy.liquid on this store — our layout wraps it (header
   and footer are ours) but the body comes out of Shopify's fallback, full width
   and unstyled. That is what made the privacy policy unreadable.

   So the fallback markup gets the same treatment as .mts-policy above: capped
   measure, real heading hierarchy, generous space above headings so they act as
   landmarks in a long document. Styling their classes works regardless of which
   template wins, which is why it is done here rather than only in the section. */
.shopify-policy__container {
  width: 100%;
  max-width: var(--maxw);
  margin-inline: auto;
  padding: 44px 24px 64px;
}
@media (max-width: 640px) { .shopify-policy__container { padding-inline: 16px; } }

.shopify-policy__title {
  max-width: 70ch;
  margin: 0 auto 8px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--line);
}
.shopify-policy__title h1 {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: clamp(1.85rem, 3.4vw, 2.7rem);
  letter-spacing: -0.015em;
  color: var(--ink);
}

.shopify-policy__body {
  max-width: 70ch;              /* the readable measure for continuous prose */
  margin-inline: auto;
  padding-top: 26px;
  color: var(--ink-2);
  font-size: 1.0625rem;
  line-height: 1.75;            /* long-form needs more air than marketing copy */
}
.shopify-policy__body h1,
.shopify-policy__body h2,
.shopify-policy__body h3,
.shopify-policy__body h4 {
  font-family: var(--f-head);
  color: var(--ink);
  line-height: 1.2;
  letter-spacing: -0.01em;
}
.shopify-policy__body h2 { font-size: 1.35rem; margin: 40px 0 12px; }
.shopify-policy__body h3 { font-size: 1.1rem;  margin: 32px 0 10px; }
.shopify-policy__body h4 { font-size: 1rem;    margin: 26px 0 8px; }

/* the policy editor commonly emits bold paragraphs as pseudo-headings */
.shopify-policy__body p > strong:only-child {
  display: block;
  font-family: var(--f-head);
  font-size: 1.1rem;
  color: var(--ink);
  margin-top: 30px;
  margin-bottom: 2px;
}

.shopify-policy__body p { margin-bottom: 16px; }
.shopify-policy__body ul,
.shopify-policy__body ol { margin: 0 0 18px; padding-left: 22px; }
.shopify-policy__body ul { list-style: disc; }
.shopify-policy__body ol { list-style: decimal; }
.shopify-policy__body li { margin-bottom: 8px; padding-left: 4px; }
.shopify-policy__body li::marker { color: var(--brand); }
.shopify-policy__body a {
  color: var(--brand-ink);
  text-decoration: underline;
  text-underline-offset: 2px;
  overflow-wrap: anywhere;      /* long URLs must not push the page sideways */
}
.shopify-policy__body hr { border: 0; border-top: 1px solid var(--line); margin: 32px 0; }
.shopify-policy__body table {
  width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-sm);
  display: block; overflow-x: auto;
}
.shopify-policy__body th,
.shopify-policy__body td { border: 1px solid var(--line); padding: 10px 12px; text-align: left; }

/* the same measure treatment for the terms page, which is a normal page */
.template-page .page-prose { max-width: 70ch; }
.template-page .page-prose h2 { margin-top: 38px; }
.template-page .page-prose h3 { margin-top: 30px; }

/* ---------------------------------------------------------------------------
   WISHLIST — loading state

   The page no longer ships the catalogue and hides it; cards are fetched one
   per saved handle. That leaves a short gap on load, and showing "your wishlist
   is empty" during it would be a lie, so the gap gets its own quiet state.
   --------------------------------------------------------------------------*/
.wishlist__loading {
  display: flex; flex-direction: column; align-items: center; gap: 14px;
  padding: 56px 20px; text-align: center;
}
.wishlist__loading p { color: var(--muted); font-size: var(--t-sm); margin: 0; }
.wishlist__spinner {
  width: 26px; height: 26px; border-radius: 50%;
  border: 2px solid var(--line); border-top-color: var(--brand);
  animation: mts-wish-spin .7s linear infinite;
}
@keyframes mts-wish-spin { to { transform: rotate(360deg) } }
@media (prefers-reduced-motion: reduce) {
  .wishlist__spinner { animation-duration: 2.4s; }
}

/* ---------------------------------------------------------------------------
   VOLUME PRICE BREAKS — per-product bands

   The band count is no longer fixed at four: the ladders scraped from the
   original store range from two bands to four, so the row flexes instead of
   sitting on a hard 4-column grid (which left two empty cells on the products
   that only break at 10+).

   Layout follows the original store — price and the "(x% off)" on one line,
   the quantity range beneath, left aligned.
   --------------------------------------------------------------------------*/
/* auto-fit, not a fixed 4: the buy column is ~450px on desktop, where four
   116px cards don't fit and flex-wrap left a lopsided 3 + 1. A 150px floor
   resolves to 2 columns there (a clean 2x2), and to 4 across on the wider
   tablet layout, without either ever overflowing the column. */
.pdp-vol__row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 8px;
  max-width: 100%;
}
.pdp-vtier {
  min-width: 0;                  /* grid items default to min-content — this is what stops overflow */
  align-items: flex-start;
  text-align: left;
  padding: 11px 13px;
  gap: 5px;
}
.pdp-vtier__top {
  display: flex;
  align-items: baseline;
  gap: 5px;
  flex-wrap: wrap;
  min-width: 0;
}
.pdp-vtier b { font-size: 1.12rem; line-height: 1.15; }
.pdp-vtier__off {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: none;
  letter-spacing: 0;
  color: var(--faint);
  white-space: nowrap;
}
.pdp-vtier.is-active .pdp-vtier__off { color: var(--brand-ink); }
.pdp-vtier__lbl {
  font-size: 0.78rem;
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  color: var(--faint);
}
.pdp-vtier.is-active .pdp-vtier__lbl { color: var(--brand-ink); }


/* ---------------------------------------------------------------------------
   STICKY NAV — seam and flick fixes

   1. The spacer that holds the bar's place in flow was transparent. During the
      swap a 48px band of page background sat at the top of the viewport, which
      is the "white layer" that appeared on scroll. Painting it the bar's own
      colour means the header never looks like it develops a hole — while the
      real bar is parked off screen, its slot still reads as the bar.

   2. `is-instant` suppresses the transform transition for a single frame, so
      moving the bar into its hidden position on promotion can't animate. Without
      it the browser tweened from top:0 to -100% and you saw the bar flick
      upward across the page every time you scrolled past the header.

   Both are behind `.hd-nav` selectors only — nothing else on the page changes.
   --------------------------------------------------------------------------*/
.mts-stick-spacer {
  background: var(--ink);
  /* it stands in for the bar, so it must not be reachable or read out */
  pointer-events: none;
}
.hd-nav.is-instant { transition: none !important; }

/* Reveal is the motion the visitor actually watches, so it gets the easing;
   hiding is away from the eye and can be quicker. */
.hd-nav.is-fixed {
  transition: transform .26s cubic-bezier(.22, .61, .36, 1), box-shadow .2s var(--ease);
}
.hd-nav.is-fixed.is-hidden { transition: transform .18s cubic-bezier(.4, 0, 1, 1); }

/* A hairline under the pinned bar separates it from white page content without
   the heavier drop shadow reading as a floating card. */
.hd-nav.is-fixed.is-pinned {
  box-shadow: 0 1px 0 rgba(0, 0, 0, .06), 0 6px 18px -8px rgba(0, 0, 0, .28);
}

/* ---------------------------------------------------------------------------
   BUY CARD — drop the hairline separators

   Every block in the buy box carried a `border-top`, and the reset meant to
   spare the first one (`.pdp-buybox > .pdp-buy__section:first-child`) never
   matched: the form's first child is a hidden <input name="id">, not a section.
   So the card opened with an orphan rule floating above the size selector.

   The selector could be patched to :first-of-type, but four stacked hairlines
   down a narrow column is the wrong instinct anyway — the card already has its
   own border, and the blocks differ enough in weight and colour to separate on
   spacing alone. Rules come out; rhythm does the work.
   --------------------------------------------------------------------------*/
.pdp-buybox > .pdp-buy__section {
  border-top: 0;
  padding-top: 0;
  margin-top: 28px;
}
.pdp-buybox > .pdp-buy__section:first-of-type { margin-top: 20px; }

/* ---------------------------------------------------------------------------
   CALL BUTTON — a circle, not a pill

   It was a lozenge carrying three lines of text ("Free expert advice / Call us
   / number") that expanded further on hover. As a persistent floating element
   that is a lot of standing weight for a secondary action, and it competed with
   the chat launcher on the opposite corner. Reduced to a single round target
   with the phone glyph — the accessible name still reads out the full number,
   so nothing is lost to a screen reader.
   --------------------------------------------------------------------------*/
.callbtn {
  width: 56px;
  height: 56px;
  padding: 0;
  gap: 0;
  border-radius: 50%;
  justify-content: center;
}
.callbtn__txt { display: none; }
.callbtn__ic {
  width: 100%;
  height: 100%;
  background: none;
  border-radius: 50%;
}
.callbtn__ic svg { width: 22px; height: 22px; }
/* the pulse now traces the button edge rather than a smaller inner disc */
.callbtn__ic::after { inset: 0; border-color: rgba(255, 255, 255, .5); }
.callbtn:hover { transform: translateY(-3px) scale(1.04); }

/* --- call button teaser ---------------------------------------------------
   The circle says "phone"; the teaser says which phone. It sits outside the
   round target so the button stays a circle, and is pinned rather than
   revealed on hover — on touch there is no hover, and a floating glyph with no
   label is a guessing game. */
.callbtn__teaser {
  position: absolute;
  left: calc(100% + 10px);
  top: 50%;
  transform: translateY(-50%);
  white-space: nowrap;
  background: #fff;
  color: var(--ink);
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 0.78rem;
  letter-spacing: 0.01em;
  padding: 7px 12px;
  border-radius: var(--r-sm, 8px);
  box-shadow: 0 6px 18px -6px rgba(0, 0, 0, .3), 0 0 0 1px rgba(0, 0, 0, .05);
  pointer-events: none;
}
/* a small nub joining the teaser to the button */
.callbtn__teaser::before {
  content: "";
  position: absolute;
  right: 100%;
  top: 50%;
  transform: translateY(-50%);
  border: 5px solid transparent;
  border-right-color: #fff;
}
@media (max-width: 560px) {
  .callbtn__teaser { display: none; }   /* no room beside the chat launcher */
}

/* --- header: signed-in avatar --------------------------------------------
   Replaces the outline glyph with a filled initials disc once there is a
   customer, so the header carries the login state rather than hiding it. */
.hd-avatar {
  width: 26px;
  height: 26px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--brand-cta);
  color: #fff;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 0.72rem;
  letter-spacing: 0.02em;
  line-height: 1;
}
.hd-act--account.is-in:hover .hd-avatar { background: var(--brand-cta-hov); }

/* --- description images that are too small -------------------------------
   A handful of description images (5 of them) are only 300–400px at source —
   the ORIGINAL store uploaded them that size, and no larger variant exists on
   its server, so nothing was lost in the migration. The Glue Dots one is a
   four-panel composite with captions, and at 310px those captions are simply
   unreadable.

   `min-width` lifts only the undersized ones: an image whose intrinsic width
   already exceeds the floor is untouched and stays pin-sharp, while a small one
   is scaled up to a legible size. It trades a little softness for being able to
   read the panel, which is the right way round.  */
.pdp-desc__img,
.pdp-desc img {
  display: block;
  margin: 8px auto 20px;
  min-width: min(100%, 520px);
  height: auto;
}

/* --- collection banner as a real image ------------------------------------
   The banner moved from a CSS background to an <img> so it can be discovered
   in the first HTML scan, fetched at high priority and sized per device. It
   fills the band exactly as background-size:cover did, and sits under the
   scrim (which is z-index 1) and the content (z-index 3). */
.colban__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  z-index: 0;

  /* NO background here — and this is the whole fix for "a black strip appears,
     then the image".

     This element is position:absolute; inset:0, so it covers the entire band.
     It used to carry `background: var(--ink)`, a solid near-black, on the
     theory that it prevented a white flash. What it actually did was paint an
     opaque black rectangle OVER the low-quality placeholder that `.colban`
     sets underneath it — so the placeholder could never be seen, and every
     category page showed a black bar for the whole download.

     Transparent lets the placeholder underneath do its job: the band is
     already the right colour when the sharp image resolves into it. */
  background: transparent;
}

/* --- cart: removing a line ------------------------------------------------
   The row collapses out under its own animation while the request is in
   flight, so the click reads as instant. If the request fails the class comes
   off and the row springs back, rather than leaving something that looks
   deleted but is still in the cart. */
/* While a burst of + presses settles, the quantity on screen is already right
   but the money has not caught up. Dim only the figures that are briefly
   stale — never the row itself, and never anything that would suggest the
   press did not register. */
.cart-line.is-syncing .cart-line__total,
.cart-line.is-syncing .cart-line__discount { opacity: .45; transition: opacity .12s var(--ease); }
@media (prefers-reduced-motion: reduce) {
  .cart-line.is-syncing .cart-line__total,
  .cart-line.is-syncing .cart-line__discount { transition: none; }
}

.cart-line.is-removing {
  opacity: 0;
  transform: translateX(-12px);
  pointer-events: none;
  transition: opacity .16s var(--ease), transform .16s var(--ease);
}
@media (prefers-reduced-motion: reduce) {
  .cart-line.is-removing { transition-duration: .01ms; transform: none; }
}

/* ===========================================================================
   HERO — clipping and the mobile crop
   ========================================================================*/

/* 1. NOTHING GETS CLIPPED, AT ANY WIDTH.
   Slides were position:absolute inside a track with a FIXED min-height, and
   .hslide has overflow:hidden — so any slide whose copy ran taller than the
   track simply had its bottom cut off. On a 390px phone the copy measured
   444px against a 440px track, so it was already losing content.

   Stacking them in one grid cell instead means every slide still overlaps for
   the crossfade, but the track now sizes itself to the TALLEST slide. The
   clipping cannot come back when copy is edited or a language is longer. */
.hslide__track { display: grid; }
.hslide__slide { position: relative; grid-area: 1 / 1; }

/* 2. THE MOBILE CROP.
   The banners are ~1.9:1 but the phone box is ~0.9:1, so object-fit:cover was
   throwing away 53% of the image width — the subject was sliced in half and
   the copy sat on top of whatever was left, which is why it read as "cut".

   On phones the image becomes its own 16:9 band above the copy instead of a
   backdrop behind it. Crop drops from ~53% to ~6%, and the text moves onto the
   solid dark ground where it is properly legible rather than fighting the
   photograph. */
@media (max-width: 700px) {
  .hslide__track { min-height: 0; }
  .hslide__media {
    position: relative;
    inset: auto;
    width: 100%;
    aspect-ratio: 16 / 9;
  }
  .hslide__media img { object-position: center; }
  /* the scrim existed to make text readable over the image; with the text no
     longer over the image it would only mute the artwork */
  .hslide__media::after { display: none; }
  .hslide__inner {
    min-height: 0;
    align-items: flex-start;
    padding: 22px 0 58px;
  }
  .hslide__dots { bottom: 18px; }
}

/* The cycling branding strip that used to live here is gone — it stacked the
   promises absolutely and showed one at a time. It is now a continuous ticker
   (see BRANDING STRIP — continuous ticker on phones, further down), and the old
   rules had to go: absolutely-positioned children gave the ticker track a
   content width of zero, so there was nothing to scroll. */

/* --- mobile: strip stays one line, search field gets its room back --------
   The rotating promises wrapped to two lines ("Secure / checkout"), doubling
   the strip's height as it cycled and shifting the whole page down. And the
   SEARCH button was taking about half the row, squeezing the input until the
   placeholder was cut mid-word. */
@media (max-width: 560px) {
  .hd-util__feats > li { white-space: nowrap; }
  .hd-util__feats > li span { white-space: nowrap; }

  /* let the input win the space; the button only needs to fit its own label */
  .hd-search__btn {
    flex: 0 0 auto;
    padding-inline: 15px;
    font-size: 0.78rem;
  }
  .hd-search input { min-width: 0; }
}

/* ===========================================================================
   COLLECTION PAGE — mobile
   ========================================================================*/

/* 1. PRODUCTS IN THE FIRST FOLD.
   The banner ran 68px of padding top and bottom on a phone, and with the
   category rail and two open filter groups beneath it the first product card
   started at ~1,136px against an 844px viewport. Nobody saw stock without
   scrolling past a screen and a half of controls. */
@media (max-width: 900px) {
  .colban__inner { padding-block: 30px; }
  .colban__title { font-size: clamp(1.7rem, 8vw, 2.2rem); }

  /* 2. ONE BOX, CLOSED BY DEFAULT.
     Category and filters collapse behind a single two-button bar. The aside
     still holds the real controls — it is only hidden until asked for, so
     nothing about how filtering works changes. */
  .col__mobilebar {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin: 16px 0 4px;
  }
  .col__mobilebar-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 13px 12px;
    border: 1.5px solid var(--line-2);
    border-radius: var(--r-md, 10px);
    background: #fff;
    font-family: var(--f-head);
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--ink);
    min-height: 46px;              /* comfortable tap target */
  }
  .col__mobilebar-btn svg { color: var(--brand); }
  .col__mobilebar-btn[aria-expanded="true"] {
    border-color: var(--brand);
    background: var(--brand-wash);
    color: var(--brand-ink);
  }
  .col__mobilebar-chev { transition: transform .18s var(--ease); color: var(--muted) !important; }
  .col__mobilebar-btn[aria-expanded="true"] .col__mobilebar-chev { transform: rotate(180deg); }

  .col__side { display: none; }
  .col__side.is-open { display: block; margin-top: 10px; }
  /* only the requested panel shows */
  .col__side.is-open[data-show="cats"] .filt-card,
  .col__side.is-open[data-show="filters"] .rail { display: none; }
}
@media (min-width: 901px) {
  .col__mobilebar { display: none; }
}

/* 3. IN-STOCK BADGE.
   Availability previously only showed when something was OUT of stock. */
.tag--instock {
  background: rgba(31, 122, 46, .1);
  color: #1a6626;
  border: 1px solid rgba(31, 122, 46, .22);
}
.tag--instock svg { color: #1f7a2e; }

/* 4. WISHLIST BACK IN THE MOBILE HEADER.
   It was display:none below the nav breakpoint, so the saved-items list was
   unreachable on a phone — and the heart on every product card wrote to a list
   with no way to open it. */
@media (max-width: 900px) {
  .hd-act--wish { display: inline-flex !important; }
  .hd-act--wish span:not(.hd-act__cart-icon):not(.hd-cart-badge) { display: none; }
}

/* --- narrow phones: the search field could not shrink ----------------------
   `.search-ac` is a flex item with `flex: 1` but the default `min-width: auto`,
   which means a flex item will NOT shrink below its content's intrinsic width.
   Its content is the input plus a padded SEARCH button, so on a 320px screen
   the form still measured 359px and the button was sliced — the "SEA" in the
   reported screenshot.

   `min-width: 0` is the fix: it lets the flex item shrink, and the input's own
   `min-width: 0` then lets the text truncate instead of forcing width. */
.search-ac { min-width: 0; }

@media (max-width: 380px) {
  .hd-search { padding-inline: 12px 5px; }
  .hd-search__btn { padding-inline: 12px; font-size: 0.74rem; }
  .hd-search input { padding-inline: 8px; }
}

/* --- category label: never on a category page -----------------------------
   Standing on the Butyl Tape page, reading "BUTYL TAPE" above every card is
   noise — it repeats what the H1 already said and pushes the product name down.

   The card also takes a `hide_cat` parameter and the collection section passes
   it, but that proved unreliable in practice: on collections with more than a
   couple of products the label still rendered, and the theme files on the
   server were verified correct. Rather than keep guessing at Liquid scoping,
   the body class settles it — `template-collection` is present on exactly the
   pages where the context is already given, and nowhere else.

   Home grids, search results, cart upsell and the wishlist keep their label:
   there, "which kind of tape is this?" is a real question. */
.template-collection .pc__cat { display: none; }

/* --- card availability: quiet, not a billboard ----------------------------
   "In stock" was a filled green pill sitting over the product photo. It is
   true of nearly every line in this catalogue, so it carried almost no
   information while taking the most visually dominant position on the card.

   It is now a small dot and a muted label on the meta line, next to the size
   count — readable when you look for it, invisible when you're scanning
   photos. Out-of-stock keeps the badge treatment: that is the state that
   actually changes what the shopper does. */
.pc__stock {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 0.78rem;
  font-weight: 500;
  color: var(--stock);
  white-space: nowrap;
}
.pc__stock-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--stock);
  flex-shrink: 0;
}
.pc__rating { flex-wrap: wrap; gap: 4px 8px; }

/* --- tab labels are headings now ------------------------------------------
   Each tab sits inside an <h2> so the four panels appear in the document
   outline beneath the product's H1. The heading is purely structural — it must
   not introduce a font size, weight or margin of its own, or the tab strip
   would visibly change. Every visual property still comes from
   .pdp-tabnav__btn. */
.pdp-tabnav__h {
  margin: 0;
  padding: 0;
  font: inherit;
  letter-spacing: inherit;
  line-height: inherit;
  display: contents;
}

/* --- was-price beside the discounted price -------------------------------
   Quiet and smaller than the live price: it is context, not the number the
   shopper is being asked to act on. Sits left of the price so the reading
   order is "was $63.50, now $60.33". */
.pdp-buy__was {
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--faint);
  text-decoration-thickness: 2px;
  margin-right: 10px;
}

/* ===========================================================================
   MOBILE HEADER — menu on the left, account icon restored

   Two problems below 900px:

   1. The hamburger sat at the far RIGHT, after the cart. On a phone the menu
      is the primary navigation and the thumb expects it top-left; every major
      storefront puts it there. `order: -1` moves it ahead of the logo without
      touching the desktop DOM, where the burger is hidden anyway.

   2. `.hd-act:not(.hd-act--cart) { display: none }` hid every action except
      the cart, then wishlist was added back by name — so the ACCOUNT icon was
      simply missing on mobile. There was no way to reach sign-in or orders
      from a phone at all.
   ========================================================================*/
@media (max-width: 900px) {
  /* Row 1: burger | logo | actions.  Row 2: search, full width.
     The logo must NOT flex-grow — given free space it scaled to the full
     viewport and pushed every control onto its own line. Fixed height, auto
     width, no growing. The search form takes a 100% basis so it wraps to its
     own line instead of squeezing the row. */
  .hd-burger { margin-right: 2px; flex: 0 0 auto; }
  .hd-logo { flex: 0 1 auto; min-width: 0; }
  .hd-logo__img { height: 30px; width: auto; max-width: 100%; }
  .hd-actions { flex: 0 0 auto; margin-left: auto; gap: 14px; }
  .search-ac { flex: 1 0 100%; order: 3; }
  /* Icons only. The "Account / Wishlist / Cart" captions are what pushed the
     actions past the row's width budget and onto a line of their own; on a
     390px phone the glyphs are unambiguous without them. */
  .hd-act span:not(.hd-act__cart-icon) { display: none; }
  .hd-act { padding: 0; }
  .hd-mast__row { padding-top: 10px; padding-bottom: 10px; row-gap: 8px; }

  /* account is a primary action, not an afterthought */
  .hd-act--account { display: inline-flex !important; }
  /* icon only — the label would not survive the width */
  .hd-act--account span:not(.hd-act__cart-icon) { display: none; }

  /* keep the row readable now it carries one more control */
  .hd-mast__row { gap: 10px; }
  .hd-actions { gap: 6px; }
}

/* ============================================================
   MOBILE HERO — one static banner, phones only
   ============================================================
   Replaces the 5-slide rotator below 900px. Every colour below is an existing
   token; the contrast ratios in tokens.css are what make these choices safe:

     tape tab       #df3c22 fill, white label   → label set at 19px/800 so it
                                                  clears the AA "large text"
                                                  threshold (18.66px bold)
     heading        --on-ink        16.7:1  AA
     body           --on-ink-soft    9.1:1  AA
     proof labels   --on-ink-mute    5.0:1  AA
     CTA            --brand-cta fill, white label, same 19px/800 rule

   The banner is display:none above 900px and the slider is display:none below
   it, so exactly one hero is in play at any width. */
.mhero { display: none; }

@media (max-width: 900px) {
  .hslide { display: none !important; }

  .mhero {
    display: block;
    position: relative;
    background: var(--ink);
    isolation: isolate;
  }

  /* Full-bleed. An image box that stopped partway down left a visible seam
     where the photograph ended and the flat ink began; letting the scrim do
     all the work removes the edge entirely. */
  .mhero__media { position: absolute; inset: 0; z-index: 0; }
  .mhero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }

  /* Bottom-weighted scrim. It is opaque where the copy sits and clear at the
     top so the photograph still reads as a photograph — a flat overlay across
     the whole image would waste the picture entirely. */
  .mhero__media::after {
    content: "";
    position: absolute; inset: 0;
    /* Reaches effectively solid ink BEFORE the copy starts. With the image
       correctly filling the box, the tape rolls ran straight under the body
       text; the ramp is gradual (over ~130px) so it reads as a vignette rather
       than the hard edge a truncated image gave. */
    background: linear-gradient(180deg,
      rgba(20,17,15,.15) 0%,
      rgba(20,17,15,.44) 26%,
      rgba(28,26,24,.88) 46%,
      rgba(31,31,31,.97) 58%,
      var(--ink) 70%);
  }

  .mhero__inner {
    position: relative; z-index: 1;
    padding-top: 150px;
    padding-bottom: 20px;
    color: var(--on-ink);
  }

  /* THE SIGNATURE — a torn strip of tape holding the eyebrow. The serrated
     edge is one repeating-linear-gradient on the right edge, so it costs no
     image and no extra element. */
  .mhero__tab {
    position: relative;
    display: inline-block;
    padding: 7px 22px 7px 12px;
    /* The DEEPER brand red, not --brand-cta. White on #df3c22 measures 4.37:1,
       which is fine for the 19px CTA (AA large text) but fails for an 11px
       label; #c1301a takes it to 5.6:1. It also leaves the CTA as the only
       bright element on the banner, which is where the eye should land. */
    background: var(--brand-cta-hov);
    color: #fff;
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1;
    /* Torn off a roll: a real sawtooth on the right edge. clip-path is exact
       at any label length, where the stacked gradients it replaced rendered as
       a barely-visible nick. */
    clip-path: polygon(
      0 0, calc(100% - 7px) 0,
      100% 12.5%, calc(100% - 7px) 25%,
      100% 37.5%, calc(100% - 7px) 50%,
      100% 62.5%, calc(100% - 7px) 75%,
      100% 87.5%, calc(100% - 7px) 100%,
      0 100%);
  }

  .mhero__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.85rem, 8.4vw, 2.4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--on-ink);
    margin: 16px 0 10px;
    text-wrap: balance;
  }

  .mhero__text {
    font-family: var(--f-body);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--on-ink-soft);
    margin: 0 0 20px;
    max-width: 34ch;
  }

  .mhero__cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 54px;               /* comfortably past the 44px touch target */
    padding: 0 20px;
    background: var(--brand-cta);
    color: #fff;
    border-radius: var(--r);
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 1.1875rem;           /* 19px — clears AA large-text at 4.4:1 */
    letter-spacing: 0.01em;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(0,0,0,.38);
  }
  .mhero__cta:active { background: var(--brand-cta-hov); }

  /* Proof rail — the numbers the sentence above deliberately does not carry. */
  .mhero__proof {
    position: relative; z-index: 1;
    display: grid;
    /* auto-fit, not a hard 3 — clearing a proof in the editor should
       re-centre the rail, not leave a gap where an item used to be. */
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    margin: 0;
    padding: 14px 0 16px;
    list-style: none;
    background: var(--ink);
    border-top: 1px solid var(--line-ink);
  }
  .mhero__proof li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    text-align: center;
    padding: 0 6px;
  }
  .mhero__proof li + li { border-left: 1px solid var(--line-ink); }
  .mhero__proof b {
    font-family: var(--f-num);
    font-weight: 800;
    font-size: 1rem;
    color: var(--on-ink);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  .mhero__proof span {
    font-family: var(--f-head);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-ink-mute);
  }
}

/* Very small phones: keep the heading to two lines and the image from eating
   the copy. */
@media (max-width: 380px) {
  .mhero__inner { padding-top: 118px; }
}

@media (prefers-reduced-motion: reduce) {
  .mhero__cta { transition: none; }
}


/* ------------------------------------------------------------------
   <picture> must fill its media box
   ------------------------------------------------------------------
   The hero images are sized `height: 100%` against `.hslide__media` /
   `.mhero__media`, which are `position:absolute; inset:0` and therefore have a
   definite height. Wrapping each <img> in a <picture> (to stop desktop and
   mobile downloading each other's hero) inserted an INLINE box with auto height
   between them, so the percentage no longer resolved and the images fell back
   to their intrinsic 2400×1000 ratio — letterboxed at narrow widths and cropped
   at wide ones. Making the wrapper a block that fills the box restores it. */
.hslide__media picture,
.mhero__media picture {
  display: block;
  width: 100%;
  height: 100%;
}

/* ============================================================
   MOBILE FOOTER — 1,419px was ~1.7 screens on a 390px phone
   ============================================================
   746px of that was three fully-expanded link lists. Collapsing them into
   accordions is the bulk of the saving; the rest comes from tightening the
   brand block, which carried desktop spacing straight down to mobile.

   Desktop is untouched: the toggle renders as the plain heading it replaced. */
.ft-col__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  width: 100%;
  padding: 0;
  background: none;
  border: 0;
  color: inherit;
  font: inherit;
  letter-spacing: inherit;
  text-transform: inherit;
  text-align: left;
  cursor: default;
}
.ft-col__chev { display: none; }

@media (max-width: 900px) {
  .ft-main { gap: 0 !important; }

  .ft-col__toggle {
    cursor: pointer;
    min-height: 52px;                 /* full-width tap target */
  }
  .ft-col__chev {
    display: block;
    flex: 0 0 auto;
    transition: transform .18s var(--ease);
  }
  .ft-col__toggle[aria-expanded="true"] .ft-col__chev { transform: rotate(180deg); }

  /* Each group reads as a row in a list, which is what it now behaves like. */
  .ft-col:not(.ft-col--brand) {
    border-top: 1px solid var(--line-ink);
    padding: 0;
  }
  .ft-col:not(.ft-col--brand) h4 { margin: 0; }
  .ft-col:not(.ft-col--brand) > ul { padding: 2px 0 14px; }
  .ft-col:not(.ft-col--brand) > ul li a { display: block; padding: 9px 0; }

  /* Brand block: desktop spacing was carried down unchanged. */
  .ft-col--brand { padding-bottom: 12px; }
  .ft-blurb { font-size: 0.875rem; line-height: 1.5; margin: 6px 0 10px; }
  .ft-contact { gap: 8px; margin-bottom: 10px; }
  .ft-contact li a, .ft-contact li { font-size: 0.9375rem; }
  .ft-social { gap: 8px; }
  .ft-social a { width: 38px; height: 38px; }

  /* The gap between the last accordion and the newsletter box was ~100px of
     nothing — the grid's desktop row spacing with no rows left to separate. */
  .ft-main { padding-bottom: 0 !important; }
  .ft-logo { margin-bottom: 4px; }

  .ft-signup { padding: 14px 0; }
  /* The box carries its own 14px block margins, which stacked on top of
     .ft-signup's padding — 28px of doubled space for no reason. */
  .ft-signup__box { padding: 14px; margin-block: 0; }
  .ft-signup__title { margin: 5px 0 9px; }

  .ft-bottom { padding: 12px 0 16px; }
  .ft-bottom__row { gap: 10px; }
  .ft-bottom__row p { font-size: 0.75rem; line-height: 1.45; }

  /* The fixed call and chat buttons sit over whatever is at the bottom of the
     viewport — at the end of the page that is the ABN line and the payment
     marks. This keeps them clear of it. */
  .ft-bottom { padding-bottom: 48px; }
}

/* ============================================================
   RELATED PRODUCTS inside blog articles
   ============================================================
   These cards are static HTML written into the article bodies (see
   scripts/fix_blog_related.py), replacing the migrated WooCommerce loop whose
   thumbnails all resolved to a 1×1 transparent placeholder. Styled here so the
   article body does not have to carry inline CSS. */
.blogprod {
  margin: 40px 0 8px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
}
.blogprod__h {
  font-family: var(--f-display);
  font-size: var(--t-h2);
  font-weight: 700;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 0 0 20px;
}
.blogprod__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}
.blogprod__card {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  /* The article body underlines every <a>; these are cards, not links in a
     sentence, so the rule has to be undone for them and their children. */
  text-decoration: none;
  transition: transform .18s var(--ease), box-shadow .18s var(--ease), border-color .18s var(--ease);
}
.blogprod__card,
.blogprod__card:hover,
.blogprod__card * { text-decoration: none !important; }
.blogprod__card:hover { transform: translateY(-3px); box-shadow: var(--sh-lg); border-color: var(--line-2); }
.blogprod__media {
  display: block;
  aspect-ratio: 1 / 1;
  border-radius: var(--r);
  overflow: hidden;
  background: var(--paper);
  margin-bottom: 10px;
}
.blogprod__media img { width: 100%; height: 100%; object-fit: cover; }
.blogprod__name {
  font-family: var(--f-head);
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.32;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blogprod__card:hover .blogprod__name { color: var(--brand-ink); }
.blogprod__price {
  font-family: var(--f-num);
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--ink);
  margin-top: auto;
  padding-top: 4px;
  font-variant-numeric: tabular-nums;
}

@media (max-width: 900px) {
  .blogprod { margin-top: 32px; padding-top: 22px; }
  .blogprod__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
}

/* ============================================================
   BLOG INDEX — the tape journal
   ============================================================
   Direction: a trade supplier's reference library. Authority is the premium
   signal for this audience, so the work is done by type, measure and structure
   — not ornament. Ink on warm paper, hairline rules, one red accent used only
   for the topic label. Tokens only; no new palette.

   Replaces `.catx` (the homepage category tile) which this page borrowed. */

/* Warm ground so the white cards lift off it — the single biggest change in
   how "considered" the page reads, and it costs nothing. */
.blogpage { background: var(--paper); }
.blogpage__body { padding-top: 30px; padding-bottom: 56px; }

/* ---- masthead ---- */
/* Centred, matching the category banners.

   It was half-and-half before: the eyebrow and title were forced left, but the
   intro and the count are max-width blocks whose `margin: auto` survived, so
   they sat centred while the title sat left — two different left edges in the
   same block. Centring everything is both consistent with the rest of the site
   and the alignment that cannot drift. */
.blogmast { text-align: center; }
.blogmast > * { margin-inline: auto; }
.blogmast__title {
  font-family: var(--f-display);
  font-weight: 800;
  font-size: clamp(2.1rem, 5vw, 3.4rem);
  line-height: 1.04;
  letter-spacing: -0.03em;
  color: var(--on-ink);
  margin: 12px 0 0;
}
.blogmast__intro {
  max-width: 52ch;
  margin: 14px auto 0;
  color: var(--on-ink-soft);
  font-size: var(--t-lead);
  line-height: 1.5;
}
.blogmast__count {
  margin: 18px auto 0;
  font-size: var(--t-xs);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--on-ink-mute);
}

/* ---- topic rail ---- */
.blogtopics {
  background: #fff;
  border-bottom: 1px solid var(--line);
}
@media (max-width: 900px) {
  /* Only worth pinning when it is a single compact line. */
  .blogtopics { position: sticky; top: 0; z-index: 3; }
}
/* DESKTOP: wrap, do not scroll.

   There are 20 topics — 3,030px of chips in a 1,280px row. As a single-line
   scroller the last chip was sliced in half with nothing to say more existed,
   which reads as a rendering fault rather than a scroll hint. With room to wrap
   there is no reason to hide anything: every topic is visible and centred.

   PHONE keeps the scroller (wrapping 20 chips there would push the first
   article off the screen), and gets edge fades so the cut is legible as
   "there is more this way". */
.blogtopics__row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  padding-block: 14px;
}

@media (max-width: 900px) {
  .blogtopics { position: relative; }
  .blogtopics__row {
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-padding-inline: 16px;
  }
  .blogtopics__row::-webkit-scrollbar { display: none; }
  .blogtopics__chip { flex: 0 0 auto; }

  /* fades that say "keep going" — drawn in the bar's own colour so they read as
     the content dissolving, not as a shadow */
  .blogtopics::before,
  .blogtopics::after {
    content: "";
    position: absolute;
    top: 0; bottom: 1px;
    width: 28px;
    pointer-events: none;
    z-index: 1;
  }
  .blogtopics::before { left: 0;  background: linear-gradient(90deg, #fff, rgba(255,255,255,0)); }
  .blogtopics::after  { right: 0; background: linear-gradient(270deg, #fff, rgba(255,255,255,0)); }
}
.blogtopics__chip {
  flex: 0 0 auto;
  padding: 8px 14px;
  border: 1px solid var(--line-2);
  border-radius: var(--r-pill);
  font-family: var(--f-head);
  font-size: 0.8125rem;
  font-weight: 600;
  color: var(--ink-2);
  white-space: nowrap;
  text-decoration: none;
  transition: background .16s var(--ease), color .16s var(--ease), border-color .16s var(--ease);
}
.blogtopics__chip:hover { border-color: var(--ink); color: var(--ink); }
.blogtopics__chip.is-on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--on-ink);
}

/* ---- grid ---- */
.blogx { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

.blogx__card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  overflow: hidden;
  text-decoration: none;
  transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease);
}
.blogx__card:hover { transform: translateY(-4px); box-shadow: var(--sh-lg); border-color: var(--line-2); }
.blogx__card:focus-visible { outline: 2px solid var(--brand-cta); outline-offset: 3px; }

.blogx__media {
  position: relative;
  aspect-ratio: 16 / 10;
  background: var(--paper-2);
  overflow: hidden;
  flex: 0 0 auto;
}
.blogx__media img, .blogx__media svg {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  transition: transform .5s var(--ease);
}
.blogx__card:hover .blogx__media img { transform: scale(1.04); }

.blogx__body {
  display: flex;
  flex-direction: column;
  gap: 9px;
  padding: 18px 20px 20px;
  flex: 1 1 auto;
}

/* The one red thing on the page. It says what the article is before the title
   has to, which is the whole point of deriving topics in the first place. */
.blogx__topic {
  font-family: var(--f-head);
  font-size: 0.6875rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--brand-ink);
}

.blogx__title {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 1.125rem;
  line-height: 1.26;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.blogx__card:hover .blogx__title { color: var(--brand-ink); }

.blogx__excerpt {
  font-size: 1rem;
  line-height: 1.6;
  color: var(--muted);
  margin: 0;
  max-width: 58ch;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.blogx__meta {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0;
  margin-top: auto;            /* equal card heights by construction */
  padding-top: 6px;
  font-size: var(--t-xs);
  color: var(--faint);
}
.blogx__dot {
  width: 3px; height: 3px;
  border-radius: 50%;
  background: var(--line-2);
}

/* ---- lead story ---- */
@media (min-width: 901px) {
  .blogx__card--lead {
    grid-column: 1 / -1;
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 8px;
  }
  .blogx__card--lead .blogx__media { flex: 0 0 58%; aspect-ratio: auto; }
  .blogx__card--lead .blogx__body { justify-content: center; gap: 14px; padding: 40px 44px; }
  .blogx__card--lead .blogx__title {
    font-size: clamp(1.6rem, 2.4vw, 2.15rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    -webkit-line-clamp: 3;
  }
  .blogx__card--lead .blogx__meta { margin-top: 0; }
}

@media (max-width: 1100px) and (min-width: 901px) {
  .blogx { grid-template-columns: repeat(2, 1fr); }
}

/* ---- phone: lead card, then a scannable index ---- */
@media (max-width: 900px) {
  .blogpage__body { padding-top: 20px; }
  .blogx { grid-template-columns: 1fr; gap: 0; }

  .blogx__card--lead { margin-bottom: 20px; }
  .blogx__card--lead .blogx__title { font-size: 1.375rem; line-height: 1.18; -webkit-line-clamp: 4; }
  .blogx__card--lead .blogx__body { padding: 18px 18px 20px; }

  /* Rows, not stacked cards: twelve full-width cards ran ~3,600px. */
  .blogx__card:not(.blogx__card--lead) {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
    padding: 15px 0;
    background: none;
  }
  .blogx__card:not(.blogx__card--lead):hover { transform: none; box-shadow: none; }
  .blogx__card:not(.blogx__card--lead) .blogx__media {
    flex: 0 0 96px; width: 96px;
    aspect-ratio: 1 / 1;
    border-radius: var(--r);
  }
  .blogx__card:not(.blogx__card--lead) .blogx__body { padding: 0; gap: 5px; }
  .blogx__card:not(.blogx__card--lead) .blogx__title {
    font-size: 0.9375rem; line-height: 1.32; -webkit-line-clamp: 3;
  }
  .blogx__card:not(.blogx__card--lead) .blogx__topic { font-size: 0.625rem; letter-spacing: 0.12em; }
  .blogx__card:not(.blogx__card--lead) .blogx__meta { margin-top: 0; padding-top: 0; }
}

.blogx__empty { text-align: center; color: var(--muted); padding: 56px 0; }

@media (prefers-reduced-motion: reduce) {
  .blogx__card, .blogx__media img { transition: none !important; }
  .blogx__card:hover { transform: none; }
  .blogx__card:hover .blogx__media img { transform: none; }
}

/* ============================================================
   BRANDING STRIP — continuous ticker on phones
   ============================================================
   Desktop is unchanged: four promises centred in a row. Below 900px they no
   longer fit, so the track scrolls instead of swapping one item in at a time.

   The track holds two copies of the list and travels exactly -50%, which puts
   the second copy exactly where the first was when the animation restarts —
   that is what makes the loop seamless rather than jumping. Duration is set in
   JS from the measured width so the speed is constant. */
@media (max-width: 900px) {
  .hd-util { overflow: hidden; }

  /* Edge to edge — a ticker that starts and stops inside the page gutter looks
     clipped rather than continuous. */
  .hd-util__row {
    justify-content: flex-start;
    overflow: hidden;
    padding-inline: 0;
    max-width: none;
  }

  /* The base stylesheet hides items 3+ below 900px and all separators below
     560px, which was right for a static row that had to fit. The ticker shows
     every promise, so both rules are undone here. */
  .hd-util .hd-util__sep,
  .hd-util .hd-util__sep:nth-child(n + 3) { display: inline-flex; }

  .hd-util__feats.is-ticker {
    flex-wrap: nowrap;
    width: max-content;
    justify-content: flex-start;
    animation-name: mts-ticker;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    will-change: transform;
  }
  .hd-util__feats.is-ticker { display: flex; position: static; min-height: 0; }
  .hd-util__feats.is-ticker > li {
    /* explicit resets, so any leftover stacking rule cannot flatten the track */
    position: static;
    inset: auto;
    opacity: 1;
    pointer-events: auto;
    transition: none;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  /* prefers-reduced-motion: no movement, but every promise must still be
     reachable — so the row becomes swipeable instead of animated. */
  .hd-util__feats.is-static {
    flex-wrap: nowrap;
    justify-content: flex-start;
    overflow-x: auto;
    scrollbar-width: none;
    padding-inline: 16px;
  }
  .hd-util__feats.is-static::-webkit-scrollbar { display: none; }
  .hd-util__feats.is-static li { white-space: nowrap; flex: 0 0 auto; }
}

@keyframes mts-ticker {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

@media (prefers-reduced-motion: reduce) {
  .hd-util__feats.is-ticker { animation: none; }
}

/* ============================================================
   QUANTITY STEPPER — stop it being crushed on narrow screens
   ============================================================
   On a 390px phone the buy row (stepper + Add to cart + wishlist) does not fit,
   and flex items shrink by default. The stepper lost the argument: its buttons
   were squeezed from 46px to 12px and the +/- glyphs inside them to 0×0, so the
   control was on the page but invisible — it read as a missing feature.

   Fixed by refusing to shrink rather than by hiding anything: the stepper keeps
   its size and the Add to cart button absorbs the leftover space, wrapping to
   its own line if there genuinely isn't enough. 44px is also the minimum
   comfortable touch target, so this is the floor regardless of layout. */
.qty { flex-shrink: 0; }
.qty button {
  flex: 0 0 auto;
  min-width: 44px;
  flex-shrink: 0;
}
.qty input {
  flex: 0 0 auto;
  min-width: 46px;
  flex-shrink: 0;
}
.qty button svg { flex-shrink: 0; }

@media (max-width: 900px) {
  /* Wrap rather than compress: a full-width Add to cart on its own line is a
     better outcome than three squeezed controls on one. */
  .pdp-buy__actions { flex-wrap: wrap; align-items: stretch; }
  /* Once the row wraps, the stepper is alone on its line and collapses to the
     input's natural height (31px) — under the 44px touch minimum. Height has to
     be stated, not inherited from a sibling that is no longer beside it. */
  .pdp-buy__actions .qty { flex: 0 0 auto; min-height: 52px; }
  .pdp-buy__actions .qty button { width: 44px; height: auto; }
  .pdp-buy__actions .qty input { height: auto; }
  .pdp-buy__actions .pdp-buy__add { flex: 1 1 190px; min-width: 0; }
  .pdp-buy__wish { flex: 0 0 auto; }
}

/* ============================================================
   CATEGORY BANNER — stop it reading as a black box
   ============================================================
   Two separate faults, both visible on /collections/hook-loop-tapes:

   1. FLASH OF BLACK. `.colban` is charcoal and the banner is a normal <img>,
      so the band painted solid black until the image decoded. It now carries a
      24px-wide copy of the same image as a background, which arrives almost
      instantly and is scaled up into a blurred colour wash — the sharp image
      resolves into it instead of replacing black.

   2. PERMANENTLY BLACK. The scrim was a radial gradient running .66 → .90 of
      near-black. Over a bright banner that is merely moody; over the hook &
      loop banner — black tape photographed on a dark surface — it erased the
      photograph entirely. Lightened, and shaped so the darkening sits behind
      the text rather than over the whole picture. Contrast is measured against
      the rendered pixels, not assumed. */
.colban--img {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}
/* NO TINT — the photograph shows at full brightness, edge to edge, with nothing
   painted over it. Asked for directly, twice, and it is the right call for the
   artwork: these are product photographs, and darkening them to protect a
   headline that occupies a third of the band is what made the banners read as
   black boxes.

   Legibility is therefore carried entirely by the type: the layered shadow
   below is invisible against a dark part of a picture and becomes a soft dark
   halo against a bright one.

   MEASURED, so the trade-off is on the record rather than assumed. White text
   against the rendered pixels behind it, worst 5% of the text block:

       painters-tape          1.07:1     hook-and-loop-dots     1.19:1
       aluminium-foil-tapes   1.14:1     masking-tape           1.23:1
       hook-loop-tapes        1.16:1     tapes-dispensers       1.25:1
       bumpers-tapes          1.17:1     safety-tape            1.62:1

   WCAG AA wants 3:1 for text this large. A shadow is not a contrast ratio, and
   no amount of shadow closes a gap that big — the only fix that does not put a
   tint back on the picture is DARKER ARTWORK for the pale categories. Where a
   banner is shot on a white bench (painters-tape is white crepe on white),
   white type over it will not measure however it is styled. */
.colban--img .colban__scrim { background: none; }

.colban--img .colban__inner {
  text-align: center;
  margin-inline: auto;
}
.colban--img .colban__title {
  text-shadow:
    0 1px 2px rgba(0,0,0,.55),
    0 3px 14px rgba(0,0,0,.55),
    0 0 42px rgba(0,0,0,.40);
}
/* Small text is the worst case: a shadow works by darkening what is directly
   behind a stroke, and a thin stroke has little behind it. These get a tighter,
   heavier halo than the headline — plus the breadcrumbs go fully white, since
   the muted greys they inherit are invisible on a pale photograph. */
.colban--img .colban__inner .crumbs,
.colban--img .eyebrow--onink {
  text-shadow:
    0 0 4px rgba(0,0,0,.9),
    0 1px 3px rgba(0,0,0,.85),
    0 2px 12px rgba(0,0,0,.6);
}
.colban--img .colban__inner .crumbs li,
.colban--img .colban__inner .crumbs a,
.colban--img .colban__inner .crumbs [aria-current="page"] { color: #fff; }
.colban--img .colban__inner .crumbs__sep { color: rgba(255,255,255,.75); }
/* The count chip keeps a faint plate of its own — it is small text, where a
   shadow alone does least. */
.colban--img .colban__count {
  background: rgba(11,9,7,.34);
  backdrop-filter: blur(3px);
  -webkit-backdrop-filter: blur(3px);
  text-shadow: 0 1px 3px rgba(0,0,0,.6);
}



/* No banner image (bestsellers, frontpage): keep the original solid treatment —
   there is no photograph to reveal, so lightening it would only wash out. */
.colban:not(.colban--img) .colban__scrim {
  background: radial-gradient(120% 130% at 50% 42%, rgba(11,9,7,.55) 0%, rgba(11,9,7,.7) 55%, rgba(11,9,7,.82) 100%);
}

/* article header meta + the "shop all" line under related products */
.art__meta {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 14px 0 0;
  font-size: var(--t-xs);
  color: var(--on-ink-mute);
}
.art__meta a { color: var(--brand-on-dark); text-decoration: none; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.12em; }
.art__meta a:hover { text-decoration: underline; }
.blogprod__all { margin: 18px 0 0; }
.blogprod__all a {
  font-family: var(--f-head); font-weight: 700; font-size: 0.9375rem;
  color: var(--brand-ink); text-decoration: none;
}
.blogprod__all a:hover { text-decoration: underline; }
.art__back { margin-top: 28px; }

/* derived colour/size filters: empty state + disabled values */
.filt__none { margin: 28px 0; color: var(--muted); text-align: center; }
.filt__check input:disabled + .filt__dot,
.filt__check input:disabled ~ span { opacity: .42; }
.filt__check input:disabled { cursor: not-allowed; }

/* Category copy footer with no copy: the CTA stands alone, so it does not need
   the card's top padding or the divider that separated it from body text. */
.catseo--bare { padding-top: 0; }
.catseo--bare .catseo__close { border-top: 0; padding-top: 8px; }

/* ============================================================
   PDP FAQ — a real accordion
   ============================================================
   The migrated FAQ was alternating <p>question</p><p>answer</p>, so the two
   were typographically identical and the section read as an unbroken wall of
   text under a heading that said "FAQ".

   Built on <details>/<summary>: it opens and closes, is keyboard operable and
   announced correctly by screen readers, and needs no JavaScript — so it cannot
   break if a script fails. Styled to match the category-page FAQ. */
.pdp-faq { margin: 6px 0 4px; border-top: 1px solid var(--line); }

.pdp-faq__item { border-bottom: 1px solid var(--line); }

.pdp-faq__q {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  padding: 16px 0;
  list-style: none;
  cursor: pointer;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 1rem;
  line-height: 1.45;
  color: var(--ink);
  transition: color .14s var(--ease);
}
.pdp-faq__q::-webkit-details-marker { display: none; }   /* Safari's own triangle */
.pdp-faq__q:hover { color: var(--brand-ink); }

/* The +/− is drawn in CSS so there is no icon to load and it always matches
   the open state exactly. */
.pdp-faq__q::after {
  content: "";
  flex: 0 0 auto;
  width: 14px; height: 14px;
  margin-left: auto;
  margin-top: 4px;
  background:
    linear-gradient(currentColor, currentColor) center/100% 2px no-repeat,
    linear-gradient(currentColor, currentColor) center/2px 100% no-repeat;
  transition: transform .18s var(--ease), opacity .18s var(--ease);
  color: var(--brand-ink);
}
/* Open = minus. Dropping the vertical bar is the whole change; rotating as
   well turned the remaining horizontal bar back into a vertical one. */
.pdp-faq__item[open] .pdp-faq__q::after {
  background: linear-gradient(currentColor, currentColor) center/100% 2px no-repeat;
}

.pdp-faq__a {
  padding: 0 34px 18px 0;
  color: var(--muted);
  line-height: 1.65;
}
.pdp-faq__a > :first-child { margin-top: 0; }
.pdp-faq__a > :last-child { margin-bottom: 0; }

@media (prefers-reduced-motion: reduce) {
  .pdp-faq__q::after { transition: none; }
}

/* An h1 used as the intro eyebrow: semantic rank, not size. Reset the browser's
   heading defaults so it looks exactly like the span it replaced. */
.intro__eyebrow-h1 {
  display: block;
  margin: 0;
  font-size: var(--t-eyebrow);
  line-height: inherit;
}

/* Brand wall wordmark, for a brand whose logo file we do not have yet. */
.brandx__wordmark {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  padding: 0 10px;
  font-family: var(--f-display);
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: -0.01em;
  color: var(--on-ink);
  text-align: center;
}

/* ================================================= SEARCH BAR: THE FOCUS RING
   Clicking into the search field drew TWO red outlines: a brand-coloured pill
   around `.hd-search` (its own designed `:focus-within` state) and, inside it, a
   3px square-cornered brand outline hugging the input itself.

   The square one is a generic accessibility fallback —

       :where(a, button, input, select, textarea, [tabindex]):focus-visible
       .mts input:focus-visible

   — written to guarantee every control shows focus, because the CSS reset
   removes the browser default. It is the right rule to have. It is the wrong
   rule HERE, because this control already announces focus on its container, and
   two concentric red rings on one element read as an error state rather than as
   a cursor.

   So the input's own ring is suppressed and the container keeps the indicator.
   Focus is still plainly visible — the whole pill changes — which is what the
   requirement actually is; it is not "every element must have an outline".

   The container's ring is also toned down: `--line-2` at rest, brand only as a
   soft wash, so the field reads as focused rather than as flagged. */
.hd-search input:focus,
.hd-search input:focus-visible,
.mts .hd-search input:focus,
.mts .hd-search input:focus-visible {
  outline: none !important;
  box-shadow: none;
}

.hd-search:focus-within {
  border-color: var(--ink-2);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(26, 26, 26, .07);
}

/* The clear (×) button inside the field is a control of its own and DOES keep a
   ring — it has no container state to borrow. */
.hd-search input::-webkit-search-cancel-button { cursor: pointer; }

/* ============================================ MOBILE: THE TRUST STRIP SCROLLS
   Four trust lines do not fit across a 390px screen. They wrapped onto four
   stacked rows — ninety pixels of red band above the logo before any content —
   and the previous answer was to hide items three and four below 900px, so a
   phone never saw "Lowest-price guarantee" or "Australian owned" at all.

   Below 900px the row becomes an infinite marquee: all four, in the height of
   one. Above it, nothing changes — the clone is simply not rendered. */
.hd-util__marquee { display: flex; align-items: center; justify-content: center; }
.hd-util__feats--clone { display: none; }

@media (max-width: 900px) {
  /* The window. overflow:hidden is what makes the track a marquee rather than
     a very wide row that scrolls the page sideways. */
  .hd-util__row {
    overflow: hidden;
    min-height: 38px;
    padding-inline: 0;
    /* The strip runs edge to edge; the fade at each end does the framing. The
       mask means a line entering or leaving does not simply get chopped by the
       viewport edge. */
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 26px, #000 calc(100% - 26px), transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 26px, #000 calc(100% - 26px), transparent 100%);
  }

  .hd-util__marquee {
    width: max-content;
    flex-wrap: nowrap;
    justify-content: flex-start;
    /* Duration is per-copy, so the speed does not change when the number of
       features does. 18s reads at about 45px/second — slow enough to finish a
       sentence, quick enough not to feel stalled. */
    animation: mts-util-marquee 18s linear infinite;
    will-change: transform;
  }

  .hd-util__feats--clone { display: flex; }

  /* Every feature shows, and none of them wrap. The old breakpoints hid items
     by index; there is nothing to hide now. */
  .hd-util .hd-util__sep,
  .hd-util .hd-util__sep:nth-child(n+3) { display: inline-flex; }
  .hd-util__feats { flex-wrap: nowrap; }
  .hd-util li { white-space: nowrap; padding-inline: 16px; }
  .hd-util__lead { padding-left: 16px; }

  /* -50% because the track holds TWO copies: at -50% the second copy sits
     exactly where the first started, so the reset is invisible. */
  @keyframes mts-util-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  /* Motion is decorative here, and a permanently moving band is a genuine
     problem for vestibular disorders. Stopped, the strip is a normal scrollable
     row — the content stays reachable rather than being hidden. */
  @media (prefers-reduced-motion: reduce) {
    .hd-util__marquee { animation: none; }
    .hd-util__row { overflow-x: auto; scrollbar-width: none; }
    .hd-util__row::-webkit-scrollbar { display: none; }
    .hd-util__feats--clone { display: none; }
  }
}

/* ==================================== MOBILE: THE FOOTER SUBSCRIBE BUTTON
   The button hung 6px outside its own box at 390px — measured: the form's right
   edge at 359, the button's at 365.

   `.ft-signup__form input` is a FIXED `width: 190px`, and the form is a flex row
   with an 8px gap. 190 + 8 + a 132px button is 330px of content in a box whose
   inner width on a 390px screen is about 296. Neither child could give, so the
   button was pushed out of the rounded panel and clipped.

   The input flexes instead. `min-width: 0` is the load-bearing half: a flex item
   will not shrink below its intrinsic content width without it, so `flex: 1`
   alone would have changed nothing. */
@media (max-width: 560px) {
  .ft-signup__box { width: 100%; padding: 14px; }
  .ft-signup__form { width: 100%; }
  .ft-signup__form input { width: auto; flex: 1 1 auto; min-width: 0; }
  .ft-signup__form .btn { flex: 0 0 auto; padding-inline: 16px; }
  .ft-signup__title { white-space: normal; }
}

/* ================================================ CHAT ASSISTANT: ASK BOX
   The panel already had a message list, quick-reply chips and a route to a
   human. These three additions are the live assistant: the box you type in,
   the disclaimer that has to sit with it, and the product links.

   Deliberately quiet. The panel's one piece of colour is the send button;
   everything else is paper, ink and a hairline, so the answer stays the thing
   you look at. */

.chatw__ask {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 12px 0;
  flex-shrink: 0; background: #fff;
}

.chatw__ask input {
  flex: 1 1 auto; min-width: 0;
  font-family: var(--f-body); font-size: 0.82rem;
  padding: 9px 12px;
  border: 1px solid var(--line); border-radius: 10px;
  background: var(--paper); color: var(--ink);
}

.chatw__ask input::placeholder { color: var(--muted); }

.chatw__ask input:focus {
  border-color: var(--ink-2);
  background: #fff;
}

.chatw__ask button {
  flex: 0 0 auto;
  display: inline-flex; align-items: center; justify-content: center;
  width: 36px; height: 36px;
  border: 0; border-radius: 10px;
  background: var(--brand-cta); color: #fff;
  cursor: pointer;
  transition: background .16s var(--ease);
}

.chatw__ask button:hover { background: var(--brand-cta-hov); }

/* Small, but never hidden. The replies are generated and a trade buyer choosing
   a tape for a real job is entitled to know that before acting on one. */
.chatw__disclaimer {
  margin: 6px 12px 0;
  font-size: 0.63rem; line-height: 1.45;
  color: var(--muted);
  flex-shrink: 0;
}

/* Product links, rendered by us from catalogue data — never a URL the model
   composed. They read as a short stack of options under the answer. */
.chatw__links {
  display: flex; flex-direction: column; gap: 4px;
  margin: 2px 0 4px;
}

.chatw__link {
  display: block;
  padding: 8px 11px;
  font-size: 0.75rem; line-height: 1.35;
  color: var(--ink);
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 10px;
  transition: border-color .14s var(--ease), background .14s var(--ease);
}

.chatw__link:hover {
  border-color: var(--ink-2);
  background: #fff;
}

/* ============================ NO FOCUS RING ON PROGRAMMATIC FOCUS TARGETS
   Switching account panels drew a 3px brand-red rectangle around the panel
   heading — "Addresses" framed in red as though it were an error.

   assets/js/acct.js gives the new panel's heading `tabindex="-1"` and focuses it
   so a screen reader lands on the new content instead of staying where the old
   panel used to be. That is correct behaviour. The problem is that the global
   focus ring matches `[tabindex]` — attribute presence, not value — so a
   heading that exists only as a programmatic focus target got the ring meant
   for controls a person tabbed to.

   `tabindex="-1"` means EXPLICITLY not keyboard-reachable. Nobody can tab to it,
   so a focus ring on it communicates nothing and misreads as a validation
   error. Every genuinely focusable element keeps its ring.

   THIS BLOCK ALONE DID NOT FIX IT, and that is worth knowing before trusting it.
   It landed here, but mts-wordpress-overrides.css carries its own ring rule at
   IDENTICAL specificity (0,3,0) roughly 400 lines further down the built
   stylesheet — so that one won the cascade and the red rectangle stayed. The
   actual fix is in the two ring selectors themselves: both now say
   `[tabindex]:not([tabindex="-1"])` instead of a bare `[tabindex]`, so the ring
   is never claimed for a -1 element in the first place.

   This block is kept as a backstop, and it earns its place by covering `:focus`
   as well as `:focus-visible` — so a future rule that rings plain `:focus` can't
   reintroduce the same rectangle. Do not treat it as the primary defence. */
:where([tabindex="-1"]):focus,
:where([tabindex="-1"]):focus-visible,
.mts [tabindex="-1"]:focus,
.mts [tabindex="-1"]:focus-visible {
  outline: none;
}

/* ══════════════════════════════════════════════════════════ THE ACCOUNT AREA
   Rebuilt. It read as WooCommerce's default wearing the brand's colours: a bare
   content column with no panel around it, three red-outlined tiles that looked
   like alerts, a definition list borrowed from the CHECKOUT's totals layout so
   an address was stranded against the right edge, and 240px of dead space on
   every dashboard because `.page-stats` is a four-column grid that was only ever
   given three stats.

   The direction is the store's own paperwork — a dispatch docket. Trade supply
   runs on packing slips and spec sheets: a header that states the account, then
   facts in machined rows under hairlines. Every value below comes from the
   existing token set; nothing new is introduced.

   ONE FLARE. The masthead is the single bold element and total-spent is the only
   thing in brand red. Everything else is quiet on purpose.
   ═══════════════════════════════════════════════════════════════════════════ */

/* --- the masthead ---------------------------------------------------------
   Ink, because the site already carries an ink navigation bar directly above
   it — a dark band here belongs to the same family rather than arriving from
   nowhere. It gives the account a sense of arrival the old page had none of. */
.acct-head {
	display: flex;
	flex-wrap: wrap;
	align-items: flex-end;
	justify-content: space-between;
	gap: 28px 40px;
	margin-top: 4px;
	padding: 32px 36px;
	border-radius: var(--r-lg);
	background: var(--ink);
	/* The light end is #1d1d1d, not #2c2c2c, and the number is measured rather
	   than chosen. The eyebrow is --brand-on-dark (#fa3c22) at 9.9px, which
	   counts as SMALL text and therefore needs 4.5:1 — and it sits at the top
	   left, exactly where this gradient is brightest. Against #2c2c2c it scored
	   3.81:1 and failed; #1d1d1d puts it at 4.61:1. The gradient is subtler for
	   it, which costs nothing: the depth was decoration, the eyebrow is not. */
	background-image: radial-gradient(120% 140% at 12% -20%, #1d1d1d 0%, var(--ink) 62%, #141414 100%);
	color: #fff;
}

.acct-head__eyebrow {
	display: block;
	margin-bottom: 10px;
	font-family: var(--f-head);
	font-weight: 700;
	font-size: var(--t-xs);
	letter-spacing: 0.16em;
	text-transform: uppercase;
	color: var(--brand-on-dark);
}

/* The customer's name is the largest thing on the page, in the display face.
   It is the answer to "whose account is this", which the old page never gave. */
.acct-head__name {
	margin: 0;
	font-family: var(--f-display);
	font-weight: 700;
	font-size: clamp(1.7rem, 3.4vw, 2.35rem);
	line-height: 1.05;
	letter-spacing: -0.02em;
	color: #fff;
}

.acct-head__meta {
	display: flex;
	align-items: center;
	flex-wrap: wrap;
	gap: 10px;
	margin: 12px 0 0;
	font-size: var(--t-sm);
	color: var(--on-ink-soft);
}
.acct-head__dot {
	width: 3px;
	height: 3px;
	border-radius: 50%;
	background: var(--on-ink-mute);
	flex-shrink: 0;
}

/* The figures. A dl, because they are label/value pairs and a screen reader
   should hear them as such rather than as six loose fragments. */
.acct-head__figures {
	display: flex;
	flex-wrap: wrap;
	gap: 0;
	margin: 0;
}
.acct-head__figures > div {
	padding: 0 26px;
	border-left: 1px solid rgba(255, 255, 255, .14);
}
.acct-head__figures > div:first-child { padding-left: 0; border-left: 0; }
.acct-head__figures > div:last-child { padding-right: 0; }

.acct-head__figures dt {
	font-family: var(--f-head);
	font-weight: 700;
	font-size: 0.62rem;
	letter-spacing: 0.14em;
	text-transform: uppercase;
	color: var(--on-ink-mute);
	margin-bottom: 8px;
	white-space: nowrap;
}
.acct-head__figures dd {
	margin: 0;
	font-family: var(--f-display);
	font-weight: 700;
	font-size: 1.9rem;
	line-height: 1;
	letter-spacing: -0.02em;
	color: #fff;
	/* Tabular numerals: the three figures sit in a row, and without this the
	   digits shift width and the row reads as three headings rather than data. */
	font-variant-numeric: tabular-nums;
}
/* The one flare. Total spent is the figure a returning trade buyer looks for. */
.acct-head__figure--flare dd { color: var(--brand-on-dark); }

/* --- panels become real objects ------------------------------------------
   `.acct__panel` carried `min-width: 0` and nothing else, so every endpoint's
   content floated directly on the page with no card, no padding and no edge. */
.acct__main > .acct__panel,
.acct__main .acct__panel {
	padding: 30px 34px;
	background: #fff;
	border: 1px solid var(--line);
	border-radius: var(--r-lg);
}

.acct__panel-head {
	display: flex;
	align-items: flex-start;
	justify-content: space-between;
	gap: 20px;
	padding-bottom: 20px;
	margin-bottom: 24px;
	border-bottom: 1px solid var(--line);
}
.acct__panel-head h2 { margin-bottom: 4px; }
.acct__panel-head .acct__lede { margin: 0; }

/* A quiet text action, not a third button competing with the two below. */
.acct__panel-action {
	display: inline-flex;
	align-items: center;
	gap: 6px;
	flex-shrink: 0;
	font-family: var(--f-head);
	font-weight: 700;
	font-size: var(--t-xs);
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--brand-ink);
	white-space: nowrap;
}
.acct__panel-action:hover { text-decoration: underline; text-underline-offset: 3px; }

/* --- the spec table -------------------------------------------------------
   Label left in small caps, value right in body type, hairline between. The
   same way the product pages present specifications, so the account speaks the
   store's existing vocabulary for "facts about this thing". */
.acct__spec { margin: 0; }
.acct__spec > div {
	display: grid;
	grid-template-columns: 190px minmax(0, 1fr);
	gap: 10px 28px;
	padding: 15px 0;
	border-bottom: 1px solid var(--line);
}
.acct__spec > div:last-child { border-bottom: 0; padding-bottom: 0; }
.acct__spec dt {
	font-family: var(--f-head);
	font-weight: 700;
	font-size: var(--t-xs);
	letter-spacing: 0.08em;
	text-transform: uppercase;
	color: var(--faint);
	padding-top: 2px;
}
.acct__spec dd {
	margin: 0;
	font-size: var(--t-body);
	line-height: 1.6;
	color: var(--ink);
}
.acct__spec dd.num { font-variant-numeric: tabular-nums; }

.acct__form-actions {
	display: flex;
	flex-wrap: wrap;
	gap: 12px;
	margin-top: 26px;
	padding-top: 24px;
	border-top: 1px solid var(--line);
}

/* --- the sidebar reads as an index ---------------------------------------
   The active row was a pink wash, which on a page with a red masthead made two
   competing reds. It is a solid ink marker now: unmistakable, and it leaves the
   brand red to the one thing that earns it. */
.acct__nav-item {
	position: relative;
	padding-left: 18px;
}
.acct__nav-item::before {
	content: "";
	position: absolute;
	left: 0;
	top: 0;
	bottom: 0;
	width: 3px;
	background: transparent;
	transition: background .14s var(--ease);
}
.acct__nav-item.is-active,
.acct__nav-item[aria-current="page"] {
	background: var(--paper);
	color: var(--ink);
}
.acct__nav-item.is-active::before,
.acct__nav-item[aria-current="page"]::before { background: var(--ink); }
.acct__nav-item.is-active svg,
.acct__nav-item[aria-current="page"] svg { color: var(--brand); }

/* The profile card duplicated the masthead's job once the masthead existed. */
.acct__side .acct__profile { display: none; }

/* --- the phantom column ---------------------------------------------------
   `.page-stats` is `repeat(4, 1fr)`. Every page using it renders three stats,
   so the fourth track sat empty and took 240px of content width with it. */
.page-stats { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }

@media (max-width: 900px) {
	.acct-head { padding: 24px; gap: 22px; }
	.acct-head__figures { width: 100%; }
	.acct-head__figures > div { padding-inline: 18px; }
	.acct-head__figures > div:first-child { padding-left: 0; }
	.acct__main > .acct__panel,
	.acct__main .acct__panel { padding: 22px 20px; }
	.acct__spec > div { grid-template-columns: 1fr; gap: 4px; padding: 13px 0; }
	.acct__panel-head { flex-wrap: wrap; }
}

@media (max-width: 560px) {
	/* The masthead was eating most of a phone screen before any content: a
	   38px name, a meta line that wrapped and orphaned its separator dot onto
	   the end of the first line, and 32px of padding. Tightened so the account
	   is still stated clearly and the panel below is reachable. */
	.acct-head { padding: 20px; gap: 18px; border-radius: var(--r); }
	.acct-head__name { font-size: 1.5rem; }
	.acct-head__eyebrow { margin-bottom: 7px; }

	/* Stacked, and the dot goes with the row it was separating. A middot
	   floating at the end of a line is not a separator, it is a typo. */
	.acct-head__meta { flex-direction: column; align-items: flex-start; gap: 3px; margin-top: 9px; }
	.acct-head__dot { display: none; }

	.acct-head__figures > div { padding-inline: 14px; }
	.acct-head__figures dd { font-size: 1.4rem; }
	.acct-head__figures dt { font-size: 0.58rem; letter-spacing: 0.1em; }
}

/* --- every panel gets the same header, without editing six templates -------
   dashboard.php was given an explicit `.acct__panel-head`; the other endpoints
   open with a bare <h2> and a lede, so their titles sat with no rule under them
   and the panels no longer matched each other. Targeting the panel's own first
   heading gives all of them the separated header for free — including any
   endpoint a plugin adds later. */
.acct__panel > h2:first-of-type + .acct__lede {
	padding-bottom: 20px;
	margin-bottom: 24px;
	border-bottom: 1px solid var(--line);
}
/* A panel whose heading has no lede after it still needs the rule. */
.acct__panel > h2:first-of-type:not(:has(+ .acct__lede)):not(:only-child) {
	padding-bottom: 18px;
	margin-bottom: 22px;
	border-bottom: 1px solid var(--line);
}

/* --- addresses ------------------------------------------------------------
   <address> is italic by browser default, so every saved delivery address on
   the account rendered in italics — which reads as a quotation, not as the
   place someone's parcels are going. */
.acct__main address,
.acct__addr address {
	font-style: normal;
	line-height: 1.65;
	color: var(--ink-2);
}

/* --- WooCommerce's own notices, inside the account column ------------------
   "Confirm email address to check for past orders" is emitted as a bare
   `.woocommerce-info` div directly into the content column, so on the orders
   page it appeared as an unstyled sentence floating above the panel with no
   frame, no icon and no relationship to anything.

   It gets the design's own notice treatment rather than being hidden: it is a
   real, useful prompt — it links guest orders to the account. */
.acct__main > .woocommerce-info,
.acct__main > .woocommerce-message,
.acct__main > .woocommerce-error {
	display: flex;
	flex-direction: column;
	align-items: flex-start;
	gap: 10px;
	padding: 18px 22px;
	border: 1px solid var(--line);
	border-left: 3px solid var(--brand);
	border-radius: var(--r);
	background: var(--panel);
	font-size: var(--t-sm);
	line-height: 1.6;
	color: var(--ink-2);
}
.acct__main > .woocommerce-error { border-left-color: var(--sale, var(--brand)); }
.acct__main > .woocommerce-info .button,
.acct__main > .woocommerce-message .button { align-self: flex-start; }

/* An empty notices wrapper still occupies a flex gap in the column. */
.acct__main > .woocommerce-notices-wrapper:empty { display: none; }

/* ============================================== CHAT ASSISTANT — REFINEMENT
   THE BUG FIRST, because it is why this looked broken rather than merely plain.

   The bubble styles were written against `.chatw__msg p`, but widgets.js builds
   each message as a bare <span> with textContent and no <p> inside it. So every
   one of those rules — size, line-height, and critically `color: #fff` on the
   user's own bubble — matched nothing. The result was #333 text on a #1f1f1f
   bubble: 1.30:1, which is not "hard to read", it is invisible. Everything below
   targets .chatw__msg itself.

   THE REST IS RESTRAINT. The panel already had the right bones; what made it
   feel cheap was loudness — a 45%-opacity red glow under the launcher, a pulsing
   dot, brand-washed chips competing with the send button. A messaging surface
   should be quiet so the conversation is the only thing with colour in it.
   One red element: the send button. */

/* --- launcher ------------------------------------------------------------- */

/* A neutral shadow, not a red halo. The coloured glow read as a notification
   badge rather than as elevation, and it fought the header the moment the panel
   opened over it. */
.chatw__launch {
  box-shadow: 0 8px 24px rgba(20, 15, 10, .24), 0 0 0 3px #fff;
}

.chatw__launch:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 30px rgba(20, 15, 10, .3), 0 0 0 3px #fff;
}

/* The unread ping pulsed forever on a widget nobody had unread messages in.
   It stays as a dot — the affordance — without the animation. */
.chatw__ping { animation: none; }

/* --- panel ---------------------------------------------------------------- */

/* WARM WHITE, NOT PURE WHITE.
   #fff against the store's paper-and-ink field reads as a browser dialog
   dropped on top of the page rather than as part of it. Half a step warm ties
   the panel to the same stock everything else is printed on. */
.chatw__panel {
  width: 380px;
  border-radius: 16px;
  border-color: var(--line-2);
  background: #fffdfb;
  /* Three stacked shadows instead of one: a hairline contact edge, a close
     ambient, and a long soft cast. A single large blur is what makes a floating
     panel look like a cheap drop-shadow — depth comes from the layering. */
  box-shadow:
    0 1px 2px rgba(20, 15, 10, .07),
    0 8px 20px rgba(20, 15, 10, .09),
    0 32px 64px rgba(20, 15, 10, .20);
}

/* --- header --------------------------------------------------------------- */

/* WARM ESPRESSO, NOT FLAT BLACK.
   This header was a solid slab of `--ink` (#1f1f1f) — a dead, cold, perfectly
   flat rectangle, which is the single thing that made the widget read as a
   default chat plugin rather than as part of this store.
   Two changes fix it without adding noise. The fill becomes a warm espresso
   with a gentle vertical fall, so it has a light source and belongs to the same
   warm palette as the paper below it. And the panel's top edge carries a 2px
   brand rule — the machined detail this brand uses everywhere else, and the one
   place a flare of colour earns its keep up here. The send button stays the
   only OTHER colour in the panel; a rule is an edge, not a control, so it does
   not compete for the press. */
.chatw__head {
  padding: 16px 16px 15px;
  gap: 12px;
  background: linear-gradient(180deg, #2e2622 0%, #221c19 100%);
  box-shadow:
    inset 0 2px 0 var(--brand-cta),
    inset 0 -1px 0 rgba(255, 255, 255, .08);
}

/* The spool gets the brand red and a soft halo, so the eye lands on the mark
   first and reads "My Tape Store" second. Previously a flat 11%-white circle:
   invisible against the black, and the one element in the header that had any
   licence to carry the brand. */
.chatw__avatar {
  width: 36px;
  height: 36px;
  background: var(--brand-cta);
  color: #fff;
  box-shadow:
    0 0 0 1px rgba(255, 255, 255, .10),
    0 4px 12px rgba(223, 60, 34, .38);
}

.chatw__head-info b {
  font-size: 0.92rem;
  letter-spacing: -0.01em;
}

/* `em` rather than the old `span`: the markup changed when the trading hours
   came out. Not italic — it is a label, and italics here read as an aside. */
/* .58 white failed AA against the new espresso fill. Measured, not guessed —
   see the contrast check in scripts/. */
.chatw__head-info em {
  font-style: normal;
  font-family: var(--f-head);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, .72);
}

/* --- messages ------------------------------------------------------------- */

/* The field the conversation sits on. Warm paper, a shade darker than the
   bubbles, so a white bot bubble lifts off it without needing a heavy border. */
.chatw__list {
  padding: 18px 16px;
  gap: 12px;
  background: #f2eee8;
}

/* Styled on the element itself. See the note at the top of this block. */
.chatw__msg {
  max-width: 84%;
  padding: 11px 14px;
  font-size: 0.875rem;
  line-height: 1.55;
  color: var(--ink-2);
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 14px 14px 14px 5px;
  box-shadow: 0 1px 2px rgba(20, 15, 10, .04);
}

/* The customer's own words, in the same warm espresso as the header so the
   panel reads as one object. `--ink` here was the second half of the "blackish"
   problem: cold flat black bubbles on warm paper, disagreeing with everything
   around them. */
.chatw__row--user .chatw__msg {
  color: #fff;
  background: #2b231f;
  border-color: #2b231f;
  border-radius: 14px 14px 5px 14px;
  box-shadow: 0 1px 2px rgba(20, 15, 10, .10);
}

/* --- quick replies -------------------------------------------------------- */

/* Paper and hairline instead of a red wash. Four red-tinted chips plus a red
   send button was four too many things asking to be pressed. */
.chatw__quick {
  gap: 8px;
  padding: 13px 16px;
  background: #fff;
  border-top-color: var(--line);
}

.chatw__quick button {
  font-weight: 500;
  font-size: 0.75rem;
  color: var(--ink-2);
  background: var(--paper);
  border-color: var(--line);
  padding: 8px 14px;
  transition: background .14s var(--ease), border-color .14s var(--ease), color .14s var(--ease);
}

.chatw__quick button:hover {
  color: var(--ink);
  background: #fff;
  border-color: var(--line-2);
}

/* --- ask box -------------------------------------------------------------- */

.chatw__ask { padding: 12px 14px 0; }

.chatw__ask input {
  padding: 10px 14px;
  border-radius: var(--r-pill);
  border-color: var(--line-2);
  font-size: 0.85rem;
}

.chatw__ask input:focus {
  border-color: var(--ink);
  background: #fff;
}

.chatw__ask button {
  width: 38px;
  height: 38px;
  border-radius: 50%;
}

.chatw__disclaimer {
  margin: 8px 14px 0;
  font-size: 0.66rem;
  color: var(--faint);
}

/* --- product links -------------------------------------------------------- */

.chatw__link {
  background: #fff;
  border-color: var(--line);
  font-size: 0.78rem;
}

.chatw__link:hover { border-color: var(--line-2); }

/* --- the human handoff ---------------------------------------------------- */

.chatw__form {
  padding: 12px 14px;
  gap: 14px;
  border-top-color: var(--line);
}

.chatw__cta {
  margin-top: 0;
  font-size: 0.66rem;
  color: var(--muted);
}

.chatw__cta:hover { color: var(--brand-ink); }

/* --- phones --------------------------------------------------------------- */

/* A sheet anchored to the bottom, not a shrunken desktop panel. Below 480px the
   old rule left a 14px gutter all round and a rounded box floating over the
   page, which is the one thing that reads as a widget rather than as a
   conversation. */
@media (max-width: 480px) {

  .chatw__panel {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    height: min(86vh, 640px);
    border-radius: 18px 18px 0 0;
    border-left: 0;
    border-right: 0;
    border-bottom: 0;
  }

  .chatw__list { padding: 16px 14px; }
  .chatw__msg { max-width: 88%; }
}

/* The suggestion chips are an empty-state device. widgets.js sets .is-chatting
   on the first message sent; from then on the panel is all conversation. */
.chatw.is-chatting .chatw__quick { display: none; }

/* The handoff row is a footnote, not a second call to action. It was taking the
   same visual weight as the send button. */
.chatw__form {
  padding: 10px 14px;
  background: var(--paper);
  border-top-color: var(--line);
}

.chatw__cta {
  font-family: var(--f-body);
  font-weight: 500;
  text-transform: none;
  letter-spacing: 0;
  font-size: 0.72rem;
}

.chatw__disclaimer { margin-bottom: 10px; }

/* --------------------------------- chat: one focus ring, not two ------------
   The ask box was drawing its focus state twice. This block gives the input an
   ink border on focus; the theme's global rule independently gives every input
   `outline: 2px solid var(--brand-cta)` at 2px offset. Stacked, that is a black
   pill inside a red ring — which is what "red border on the search bar in the
   chatbot" was describing, and it looked like a validation error on a field
   that was simply focused.

   Red is the store's action colour. On a text field it reads as "something is
   wrong", not "you are here", and it fought the send button sitting beside it.

   The outline is therefore suppressed HERE ONLY, and replaced with a soft ink
   halo. That is still an unmistakable focus indicator — a 1px border darkening
   to ink plus a 3px surround — so nothing is traded away for keyboard users;
   it is the same information said once instead of twice. */

.chatw__ask input:focus,
.chatw__ask input:focus-visible {
  outline: none;
  border-color: var(--ink);
  box-shadow: 0 0 0 3px rgba(31, 31, 31, .10);
}

/* The send button keeps a ring, because it is a control you can tab to and it
   sits on brand red where an ink outline would disappear. White reads on it. */
.chatw__ask button:focus-visible {
  outline: 2px solid #fff;
  outline-offset: -4px;
  box-shadow: 0 0 0 2px var(--brand-cta);
}

/* Specificity, and the same trap as the account panel's focus ring.
   `.chatw__ask input:focus-visible` is (0,2,1) — identical to the theme's
   global `.mts input:focus-visible`, and the global rule sits ~400 lines later
   in the built stylesheet because the WordPress overrides are concatenated
   after this file. Equal specificity, later wins, so `outline: none` above did
   nothing at all. Adding `.chatw` takes it to (0,3,1), which decides it
   wherever the two files end up relative to each other. */

.chatw .chatw__ask input:focus,
.chatw .chatw__ask input:focus-visible {
  outline: none;
}

.chatw .chatw__ask button:focus-visible {
  outline: 2px solid #fff;
  outline-offset: -4px;
}

/* ===== Product card: colour dots =====================================
   A swatch row has to answer two questions at a glance — WHICH colours, and
   HOW MANY — and it has to do it without competing with the price above it or
   the CTA below.

   Earlier passes were too timid: 13px, then 18px discs with a hairline, which
   still read as bullets rather than as product information. What makes it feel
   considered:

     · 20px, the point where a swatch reads as a material sample rather than a
       dot, and close enough to the price's cap-height to share a baseline;
     · a 2px white keyline INSIDE a hairline ring — the keyline is what stops
       white / clear / silver dissolving into the card, and giving every swatch
       the same ring means a black one and a white one carry equal weight;
     · a -5px overlap, so the row reads as one RANGE. Evenly spaced discs read
       as unrelated items. Hover fans them apart to inspect individually;
     · a muted count beside them, so the row states a fact instead of leaving
       the shopper to count.

   px, not rem: build-css.sh byte-verifies every rem against the React source,
   and these are Shopify-only rules with no React counterpart. */
.pc__colours {
  display: flex;
  align-items: center;
  margin: -2px 0 12px;
  min-height: 20px;              /* reserved even when empty — keeps rows level */
  padding-left: 1px;
}

.pc__dot {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: inline-block;
  flex: 0 0 auto;
  margin-left: -5px;
  background-size: cover;
  background-position: center;
  box-shadow:
    inset 0 0 0 2px #fff,
    0 0 0 1px rgba(31, 31, 31, .18),
    0 1px 3px rgba(31, 31, 31, .16);
  transition: transform .16s var(--ease), margin-left .16s var(--ease);
}

.pc__dot:first-child { margin-left: 0; }

.pc:hover .pc__dot { margin-left: 1px; }
.pc:hover .pc__dot:first-child { margin-left: 0; }
.pc__dot:hover { transform: translateY(-2px) scale(1.1); }

.pc__dot-more {
  font-size: 11px;
  line-height: 1;
  font-weight: 700;
  color: var(--muted);
  margin-left: 7px;
}

.pc__colours-n {
  margin-left: 9px;
  font-size: 0.75rem;
  font-weight: 500;
  line-height: 1;
  color: var(--faint);
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .pc__dot { transition: none; }
}

@media (max-width: 640px) {
  .pc__dot { width: 17px; height: 17px; margin-left: -4px; }
  .pc__colours { min-height: 17px; }
  .pc__colours-n { margin-left: 7px; font-size: 0.7rem; }
}

/* ===== Policy pages: contents panel + legal typography ==================
   The privacy policy and terms pages were a single 70ch column of grey prose
   against an empty sidebar. Nothing was WRONG with it, which is exactly why it
   read as bland — there was no structure to look at, only text to wade through.

   What makes a long legal document feel considered is not decoration, it is
   navigability and rhythm: you can see how long it is, where you are in it,
   and where each section begins. */

.mts-policy__side {
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: sticky;
  top: 88px;                    /* clears the sticky header */
}

/* the help panel is now a child of the sticky column, not sticky itself */
.mts-policy__help { position: static; top: auto; }

.mts-policy__toc {
  padding: 20px 22px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
  /* A long policy must not push the help panel off-screen. */
  max-height: min(56vh, 520px);
  overflow-y: auto;
  overscroll-behavior: contain;
}

.mts-policy__toc-h {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: var(--muted);
  margin: 0 0 12px;
}

.mts-policy__toc-list {
  list-style: none;
  margin: 0;
  padding: 0;
  counter-reset: policytoc;
}

.mts-policy__toc-item { margin: 0; }

.mts-policy__toc-item > a {
  display: flex;
  gap: 10px;
  padding: 7px 0 7px 12px;
  font-size: 0.875rem;
  line-height: 1.45;
  color: var(--ink-2);
  text-decoration: none;
  /* The rail is the progress indicator: a hairline the active item lights up,
     which is far quieter than a filled pill and never fights the page. */
  border-left: 2px solid var(--line);
  transition: color .14s var(--ease), border-color .14s var(--ease);
}

.mts-policy__toc-item.is-sub > a {
  padding-left: 24px;
  font-size: 0.82rem;
  color: var(--faint);
}

.mts-policy__toc-item > a::before {
  counter-increment: policytoc;
  content: counter(policytoc);
  font-variant-numeric: tabular-nums;
  font-size: 0.72rem;
  color: var(--faint);
  min-width: 1.1em;
  padding-top: 1px;
}

.mts-policy__toc-item.is-sub > a::before { content: none; }

.mts-policy__toc-item > a:hover {
  color: var(--ink);
  border-left-color: var(--line-2);
}

.mts-policy__toc-item > a[aria-current] {
  color: var(--brand-cta);
  font-weight: 600;
  border-left-color: var(--brand-cta);
}

.mts-policy__toc-item > a[aria-current]::before { color: var(--brand-cta); }

/* --- the prose itself ---------------------------------------------------
   A rule ABOVE each h2 is what turns a run of paragraphs into a set of
   sections — it gives the eye a place to stop, and it costs no colour. */
.mts-policy__body h2 {
  padding-top: 26px;
  border-top: 1px solid var(--line);
}

.mts-policy__body h2:first-child { padding-top: 0; border-top: 0; }

/* Anchored headings must not hide under the sticky header when jumped to. */
.mts-policy__body h2,
.mts-policy__body h3 { scroll-margin-top: 96px; }

/* Legal text leans hard on lists; give them room and a real marker. */
.mts-policy__body ul,
.mts-policy__body ol { padding-left: 1.25rem; margin: 14px 0 18px; }
.mts-policy__body li { margin-bottom: 8px; }
.mts-policy__body li::marker { color: var(--faint); }

.mts-policy__body a {
  color: var(--brand-cta);
  text-decoration: underline;
  text-underline-offset: 2px;
  text-decoration-thickness: 1px;
}

@media (max-width: 940px) {
  /* Stacked: a sticky contents list would sit on top of the text it indexes. */
  .mts-policy__side { position: static; }
  .mts-policy__toc { max-height: none; }
}

/* ===== Shopify's OWN policy markup =====================================
   /policies/privacy-policy and friends do NOT go through
   templates/policy.liquid on this store — Shopify renders them itself into
   `.shopify-policy__container`, inside the theme's layout. Verified: both
   templates/policy.liquid and sections/mts-policy.liquid are present on the
   live theme and the section schema is valid, and Shopify still emits its own
   wrapper.

   So these pages are styled where they actually live. The alternative — a
   duplicate Page holding a second copy of the legal text — is worse: checkout
   links to /policies/* regardless, so the copy nobody maintains is the one
   customers would be shown.

   mts-theme.js adds `.mts-policy-shim` and injects the same sidebar the theme
   section would have rendered, so both routes look identical. */
.shopify-policy__container.mts-policy-shim {
  max-width: var(--maxw);
  width: 100%;
  margin-inline: auto;
  padding: 44px 24px 8px;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 280px;
  grid-template-areas:
    "title side"
    "body  side";
  gap: 10px 48px;
  align-items: start;
}

.mts-policy-shim .shopify-policy__title { grid-area: title; text-align: left; margin: 0 0 6px; }
.mts-policy-shim .shopify-policy__body  { grid-area: body;  max-width: 70ch; }
.mts-policy-shim .mts-policy__side      { grid-area: side; }

.mts-policy-shim .shopify-policy__title h1 {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: clamp(1.9rem, 4vw, 2.6rem);
  letter-spacing: -0.02em;
  color: var(--ink);
  margin: 0;
}

/* Long-form legal prose: looser leading, a real measure, quiet colour. */
.mts-policy-shim .shopify-policy__body,
.mts-policy-shim .shopify-policy__body .rte {
  color: var(--ink-2);
  font-size: 1.0625rem;
  line-height: 1.75;
}

.mts-policy-shim .shopify-policy__body p { margin: 0 0 16px; }

.mts-policy-shim .shopify-policy__body h2 {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 1.35rem;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin: 40px 0 12px;
  padding-top: 26px;
  border-top: 1px solid var(--line);   /* the rule that makes sections read as sections */
  scroll-margin-top: 96px;
}

.mts-policy-shim .shopify-policy__body h3 {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 1.1rem;
  color: var(--ink);
  margin: 30px 0 10px;
  scroll-margin-top: 96px;
}

.mts-policy-shim .shopify-policy__body ul,
.mts-policy-shim .shopify-policy__body ol { padding-left: 1.25rem; margin: 14px 0 18px; }
.mts-policy-shim .shopify-policy__body li { margin-bottom: 8px; }
.mts-policy-shim .shopify-policy__body li::marker { color: var(--faint); }

.mts-policy-shim .shopify-policy__body a {
  color: var(--brand-cta);
  text-decoration: underline;
  text-underline-offset: 2px;
}

.mts-policy-shim .shopify-policy__body table {
  width: 100%;
  border-collapse: collapse;
  margin: 18px 0;
  font-size: 0.95rem;
}

.mts-policy-shim .shopify-policy__body th,
.mts-policy-shim .shopify-policy__body td {
  border: 1px solid var(--line);
  padding: 10px 12px;
  text-align: left;
  vertical-align: top;
}

.mts-policy-shim .shopify-policy__body th { background: var(--panel); color: var(--ink); font-weight: 600; }

@media (max-width: 940px) {
  .shopify-policy__container.mts-policy-shim {
    grid-template-columns: 1fr;
    grid-template-areas: "title" "side" "body";
    gap: 22px;
  }
  .mts-policy-shim .mts-policy__side { position: static; }
  .mts-policy-shim .mts-policy__toc { max-height: none; }
}

/* The "last updated" line on a legal page — quiet, but the first thing a
   reader looks for, so it sits above the prose rather than buried at the end. */
.mts-policy__updated {
  display: inline-block;
  margin: 0 0 22px;
  padding: 5px 12px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--muted);
}

/* cache-bust 1786813197 */

/* ===== Themed sign-in (Storefront API) ================================ */
.mts-auth__tabs {
  display: flex;
  gap: 4px;
  padding: 4px;
  margin-bottom: 20px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.mts-auth__tab {
  flex: 1;
  padding: 9px 12px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 0.9rem;
  color: var(--muted);
  cursor: pointer;
  transition: background .14s var(--ease), color .14s var(--ease);
}

.mts-auth__tab.is-on { background: #fff; color: var(--ink); box-shadow: var(--sh-sm); }
.mts-auth__tab:focus-visible { outline: 2px solid var(--brand-cta); outline-offset: 1px; }

.mts-auth__form { display: flex; flex-direction: column; gap: 14px; }
.mts-auth__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

.mts-auth__hint { display: block; margin-top: 5px; font-size: 0.76rem; color: var(--faint); }

/* One status line for every outcome. A form that fails silently is the single
   most common way a login feels broken, so this is never left empty on error. */
.mts-auth__msg {
  margin: 0 0 14px;
  padding: 10px 13px;
  border-radius: 9px;
  font-size: 0.88rem;
  line-height: 1.45;
  background: var(--panel);
  border: 1px solid var(--line);
  color: var(--ink-2);
}

.mts-auth__msg.is-ok {
  background: color-mix(in srgb, var(--stock) 9%, #fff);
  border-color: color-mix(in srgb, var(--stock) 32%, #fff);
  color: #1f7a2e;
}

/* Red is reserved for a genuine fault — a rejected password is one. */
.mts-auth__msg.is-bad {
  background: color-mix(in srgb, #c0392b 7%, #fff);
  border-color: color-mix(in srgb, #c0392b 28%, #fff);
  color: #a33124;
}

.mts-auth__link {
  align-self: flex-start;
  padding: 0;
  border: 0;
  background: none;
  font-size: 0.85rem;
  color: var(--muted);
  text-decoration: underline;
  text-underline-offset: 2px;
  cursor: pointer;
}
.mts-auth__link:hover { color: var(--brand-cta); }

/* The checkout caveat. Quiet, but present BEFORE sign-in rather than
   discovered at checkout — the whole point is that it not be a surprise. */
.mts-auth__note {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  margin: 18px 0 0;
  padding-top: 14px;
  border-top: 1px solid var(--line);
  font-size: 0.78rem;
  line-height: 1.5;
  color: var(--faint);
}
.mts-auth__note svg { flex-shrink: 0; margin-top: 2px; }

.btn.is-busy { opacity: .62; pointer-events: none; }

@media (max-width: 560px) {
  .mts-auth__row { grid-template-columns: 1fr; }
}

/* ===== Themed sign-in: form layout ====================================
   THE BUG THIS FIXES
   `.mts-auth__form label` had no display rule, so the label text and its input
   sat on the same line and the input overflowed the card — "Email [input]" with
   the box running off the right edge. The contact form never had this because
   `.contact__form label` is display:block. Same treatment here, as a column so
   the gap is explicit rather than a margin guess. */
.mts-auth__form label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: var(--t-sm);
  color: var(--ink-2);
}

/* border-box matters: these inputs sit in a 1fr grid column, and with
   content-box the padding pushed them past the track and out of the card. */
.mts-auth__form input {
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
  padding: 11px 13px;
  font-family: var(--f-body);
  font-size: 0.95rem;
  color: var(--ink);
  background: #fff;
  border: 1px solid var(--line-2);
  border-radius: var(--r);
  transition: border-color .14s var(--ease), box-shadow .14s var(--ease);
}

.mts-auth__form input:focus {
  outline: none;
  border-color: var(--brand-cta);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-cta) 16%, transparent);
}

/* min-width:0 on the tracks as well — a grid item's default min-width:auto is
   what lets a padded input refuse to shrink and blow the column out. */
.mts-auth__row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.mts-auth__row > label { min-width: 0; }

/* ===== Storefront-session dashboard ===================================
   Reuses .acct / .acct__side / .acct__panel from the Liquid dashboard so both
   look identical; only the pieces with no Liquid counterpart are defined. */
.acct-orders { display: flex; flex-direction: column; gap: 12px; }

.acct-order {
  padding: 14px 16px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
}

.acct-order__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}

.acct-order__top > div:first-child { display: flex; flex-direction: column; }
.acct-order__date { font-size: 0.78rem; color: var(--faint); }
.acct-order__items { margin: 10px 0 0; font-size: 0.86rem; color: var(--muted); line-height: 1.5; }

.acct-order__link {
  display: inline-block;
  margin-top: 10px;
  font-size: 0.84rem;
  color: var(--brand-cta);
  text-decoration: underline;
  text-underline-offset: 2px;
}

/* The sidebar sign-out is a <button> here, not an <a> — reset it to match. */
button.acct__nav-item {
  width: 100%;
  border: 0;
  background: none;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.mts-acct__muted { color: var(--faint); font-size: 0.9rem; margin: 0; }


@media (max-width: 560px) {
  .mts-auth__row { grid-template-columns: 1fr; }
}

/* Dashboard shortcuts — the overview no longer contains the orders and
   addresses panels (each has its own page), so it needs a way through to them
   rather than ending on three stat tiles. */
.acct__quick { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }

/* ===== Cart: sticky mobile checkout ===================================
   Desktop keeps the sticky summary card. Below 860px that card goes static —
   deliberately — which buries the Checkout button under the line items. This
   is the phone equivalent of the sticky summary, and nothing more: same total,
   same action, no duplicated summary rows to get out of sync. */
.cart-stickybar { display: none; }

@media (max-width: 860px) {
  .cart-stickybar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: rgba(255, 255, 255, .97);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-top: 1px solid var(--line);
    box-shadow: 0 -4px 20px rgba(31, 31, 31, .10);
  }

  .cart-stickybar__total { display: flex; flex-direction: column; line-height: 1.2; }
  .cart-stickybar__total span { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .cart-stickybar__total b { font-size: 1.15rem; color: var(--ink); }

  .cart-stickybar form { margin-left: auto; }
  .cart-stickybar__cta { white-space: nowrap; padding-inline: 22px; }

  /* Clear the bar so the last thing on the page is never trapped under it. */
  .cart__layout { padding-bottom: 84px; }

  /* The floating call button (z-index 90) and chat widget (95) both outrank the
     sticky bar (40), so on the cart page they landed ON TOP of it: the call
     button covered the running total and the chat bubble clipped the end of
     "PROCEED TO CHECKOUT". Lift both above the bar rather than hiding them —
     phone and chat are how trade buyers ask about a bulk order, and the cart is
     exactly where they ask. */
  body.template-cart .callbtn,
  body.template-cart .chatw,
  body.template-cart #smart-bot-container {
    bottom: calc(84px + env(safe-area-inset-bottom)) !important;
  }

  /* The CTA was also simply too wide for a 360px screen once the total sat
     beside it, so the label was cut off rather than merely overlapped. Let it
     shrink and keep the words. */
  .cart-stickybar { gap: 10px; padding-inline: 12px; }
  .cart-stickybar form { min-width: 0; }
  .cart-stickybar__cta { padding-inline: 16px; min-width: 0; }
  .cart-stickybar__total { flex: 0 1 auto; min-width: 0; }
}

@media (max-width: 400px) {
  .cart-stickybar__cta { padding-inline: 12px; font-size: 0.9rem; }
  .cart-stickybar__total b { font-size: 1.02rem; }
}

/* ===== REVIEWS — the legacy Judge.me widget, restyled ==================
   WHY THIS BLOCK EXISTS ON TOP OF THE --jm-* WORK ABOVE
   That earlier block themes Judge.me's MODERN widget through its supported
   `--jm-*` custom properties. This store does not render that widget: a live
   product page carries 263 `jdgm-*` nodes and ZERO `jm-*` ones. So none of
   those variables were reaching anything, and the reviews section was arriving
   essentially unstyled — which is the misalignment being reported.

   The legacy widget also builds itself CLIENT-SIDE, so its markup is absent
   from the server HTML. These rules therefore target the documented legacy
   class structure directly and simply apply whenever Judge.me paints.

   Design intent: the summary reads as one aligned band (score | distribution |
   action), and each review is a card in the same hairline vocabulary as the
   product and account panels — not a run of bordered paragraphs. */

/* ---- summary band --------------------------------------------------- */
.jdgm-rev-widg__header {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  align-items: center;
  gap: 28px;
  padding: 22px 24px;
  margin-bottom: 22px;
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
}

.jdgm-rev-widg__title { grid-column: 1 / -1; margin: 0 0 4px; font-size: 1.15rem; }

/* The average is the headline number — it should read instantly, not as body
   copy with stars stuck beside it. */
.jdgm-rev-widg__summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  min-width: 132px;
}
.jdgm-rev-widg__summary-average {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 2.6rem;
  line-height: 1;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}
.jdgm-rev-widg__summary-stars { font-size: 1rem; }
.jdgm-rev-widg__summary-text { font-size: 0.8rem; color: var(--muted); }

/* ---- distribution histogram ------------------------------------------ */
.jdgm-histogram { display: flex; flex-direction: column; gap: 5px; min-width: 0; }

.jdgm-histogram__row {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) 3ch;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}

.jdgm-histogram__star { font-size: 0.8rem; white-space: nowrap; }

/* A track that is always visible is what makes the bars read as a
   distribution rather than as four disconnected slivers. */
.jdgm-histogram__bar {
  height: 8px;
  background: color-mix(in srgb, var(--ink) 8%, #fff);
  border-radius: 999px;
  overflow: hidden;
}
.jdgm-histogram__bar-content { height: 100%; background: var(--star); border-radius: 999px; }

.jdgm-histogram__frequency {
  font-size: 0.78rem;
  color: var(--muted);
  text-align: right;
  font-variant-numeric: tabular-nums;   /* counts line up column-wise */
}

.jdgm-histogram__row:hover .jdgm-histogram__bar-content { background: var(--brand-cta); }

/* ---- write-a-review action ------------------------------------------- */
.jdgm-write-rev-link {
  display: inline-flex !important;
  align-items: center;
  justify-content: center;
  padding: 11px 20px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 0.9rem;
  color: #fff !important;
  background: var(--brand-cta) !important;
  border: 1px solid var(--brand-cta) !important;
  border-radius: var(--r);
  text-decoration: none;
  white-space: nowrap;
  transition: background .14s var(--ease);
}
.jdgm-write-rev-link:hover { background: var(--brand-cta-hov) !important; border-color: var(--brand-cta-hov) !important; }

/* ---- the review list -------------------------------------------------- */
.jdgm-rev-widg__sort-wrapper { margin-bottom: 14px; }

.jdgm-rev-widg__reviews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }

.jdgm-rev {
  display: block;
  margin: 0 !important;
  padding: 18px 20px !important;
  background: #fff;
  border: 1px solid var(--line) !important;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-sm);
}

.jdgm-rev__header { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 8px; }

/* Same initials disc as the site header, so an avatar means one thing
   everywhere on the store. */
.jdgm-rev__icon {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--brand-cta);
  color: #fff;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 0.85rem;
}

.jdgm-rev__author { font-weight: 600; font-size: 0.92rem; }
.jdgm-rev__timestamp { font-size: 0.76rem; color: var(--faint); }

/* Verified is the one badge that changes how much weight a review carries,
   so it gets the design's real tag treatment rather than grey small print. */
.jdgm-rev__buyer-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  font-size: 0.68rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .04em;
  color: #1f7a2e;
  background: color-mix(in srgb, var(--stock) 10%, #fff);
  border: 1px solid color-mix(in srgb, var(--stock) 30%, #fff);
  border-radius: 999px;
}

.jdgm-rev__rating { display: block; margin-bottom: 6px; }
.jdgm-rev__title { font-family: var(--f-head); font-weight: 700; font-size: 0.98rem; color: var(--ink); margin-bottom: 5px; }
.jdgm-rev__body { font-size: 0.9rem; line-height: 1.6; color: var(--ink-2); }

.jdgm-rev__pics { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
.jdgm-rev__pic-link img,
.jdgm-rev__pic img { border-radius: 8px; border: 1px solid var(--line); object-fit: cover; }

/* ---- pagination ------------------------------------------------------- */
.jdgm-paginate { display: flex; justify-content: center; gap: 6px; margin-top: 22px; }
.jdgm-paginate__page {
  min-width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  padding: 0 10px;
  font-size: 0.88rem;
  color: var(--ink-2);
  border: 1px solid var(--line);
  border-radius: var(--r);
  background: #fff;
}
.jdgm-paginate__page--active,
.jdgm-paginate__page:hover { border-color: var(--brand-cta); color: var(--brand-cta); }

.jdgm-star { color: var(--star) !important; }

@media (max-width: 900px) {
  .jdgm-rev-widg__header { grid-template-columns: 1fr; gap: 18px; text-align: center; }
  .jdgm-rev-widg__summary { align-items: center; }
  .jdgm-write-rev-link { width: 100%; }
  .jdgm-rev-widg__reviews { grid-template-columns: 1fr; }
}

/* ===== Account / sign-in page ==========================================
   The page was a form card beside four one-line claims, both sitting on white
   with nothing holding them together. Three changes do the work:

     1. the columns are given a relationship — the form leads at a fixed
        measure, the benefits panel becomes a real surface rather than loose
        text floating in the gutter;
     2. each benefit gets a tinted icon badge and a label/description pair, so
        the eye lands on four short labels instead of four equal-weight
        sentences;
     3. vertical rhythm is set from one scale rather than per-element margins.

   Everything stays inside the existing token set — brand red, Inter/Sora,
   machined 7/12px radii. No new palette. */

.auth {
  align-items: stretch;                /* panel matches the card's height */
  padding-block: 4px 72px;
  max-width: 1010px;
}

/* --- the form card ---------------------------------------------------- */
.auth__card {
  padding: 32px 32px 28px;
  border-radius: var(--r-lg);
  box-shadow: 0 1px 2px rgba(31,31,31,.05), 0 12px 32px -12px rgba(31,31,31,.14);
}

/* --- the benefits panel ------------------------------------------------ */
.auth__aside {
  display: flex;
  flex-direction: column;
  gap: 18px;
  padding: 30px 30px 26px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
}

.auth__aside-h {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 1.32rem;
  line-height: 1.2;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 2px 0 2px;
}

.auth__perks { display: flex; flex-direction: column; gap: 16px; padding: 0; margin: 0; list-style: none; }

.auth__perks li {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: start;
  gap: 13px;
  font-size: inherit;
}

/* A tinted disc rather than a bare glyph: it gives each row a consistent
   optical weight, which a raw icon at 18px does not. */
.auth__perk-ic {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: color-mix(in srgb, var(--brand-cta) 10%, #fff);
  border: 1px solid color-mix(in srgb, var(--brand-cta) 22%, #fff);
  color: var(--brand-cta);
}
.auth__perk-ic svg { color: var(--brand-cta); }

.auth__perks li > div { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.auth__perks li b {
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--ink);
  line-height: 1.35;
}
.auth__perks li span { font-size: 0.86rem; line-height: 1.5; color: var(--muted); }

.auth__aside-foot {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid var(--line);
  font-size: 0.78rem;
  color: var(--faint);
}
.auth__aside-foot svg { flex-shrink: 0; color: var(--stock); }

@media (max-width: 860px) {
  /* Form first on a phone — the benefits are the reason to sign up, not the
     thing someone who came here to sign in wants to scroll past. */
  .auth__aside { order: 2; padding: 24px; }
  .auth__card { order: 1; }
}

/* ===== PDP thumbnails ==================================================
   Restored, and given a real active state. The previous strip read as four
   grey boxes; what makes a thumbnail column feel considered is that the
   CURRENT one is unmistakable and the rest recede without disappearing. */
.pdp-gallery__thumbs {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex-shrink: 0;
}

.pdp-gallery__thumb {
  width: 72px;
  height: 72px;
  padding: 4px;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--r);
  cursor: pointer;
  overflow: hidden;
  transition: border-color .14s var(--ease), box-shadow .14s var(--ease);
}

.pdp-gallery__thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }

.pdp-gallery__thumb:hover { border-color: var(--line-2); }

/* Two signals, not one: the brand keyline says "this is the current image",
   and the soft ring lifts it off the column so it reads at a glance. */
.pdp-gallery__thumb.is-active {
  border-color: var(--brand-cta);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--brand-cta) 18%, transparent);
}

.pdp-gallery__thumb:focus-visible { outline: 2px solid var(--brand-cta); outline-offset: 2px; }

@media (max-width: 760px) {
  /* A horizontal rail below the photo — a vertical column would eat a phone. */
  .pdp-gallery__row { flex-direction: column-reverse; }
  .pdp-gallery__thumbs {
    flex-direction: row;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  .pdp-gallery__thumbs::-webkit-scrollbar { display: none; }
  .pdp-gallery__thumb { width: 60px; height: 60px; }
}

/* ===== Intro splash ====================================================
   A title card, not a loading screen. Four things do the work:

   1. GROUND. Flat #1f1f1f reads as grey once it fills a whole viewport —
      there is nothing for the eye to resolve. A near-black base with a warm
      radial lift behind the mark gives depth, so it reads as an unlit room
      rather than a grey panel.
   2. REVEAL. The wordmark is wiped in left-to-right with a clip-path rather
      than faded. A fade is a state change; a wipe is a gesture.
   3. SHINE. A specular sweep MASKED to the logo artwork, so the highlight
      runs across the letterforms instead of over a rectangle.
   4. EXIT. The whole card lifts and scales fractionally as it clears, like a
      camera pulling through it, instead of dissolving in place.

   Still self-clearing without JavaScript, still once per session, still
   skipped entirely under prefers-reduced-motion. 1.35s total. */
.mts-splash {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: grid;
  place-items: center;
  overflow: hidden;
  background: #08080a;
  animation: mts-splash-out 1.35s cubic-bezier(.76, 0, .24, 1) forwards;
}

.mts-splash-done .mts-splash { display: none; }

/* The warm lift. Brand red at very low alpha — present as temperature, not as
   a visible colour wash. */
.mts-splash__glow {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(58% 42% at 50% 46%,
      color-mix(in srgb, var(--brand-cta) 13%, transparent) 0%,
      transparent 70%),
    radial-gradient(120% 90% at 50% 50%, #16161a 0%, #08080a 68%);
  opacity: 0;
  animation: mts-splash-glow 1.35s cubic-bezier(.22, 1, .36, 1) forwards;
}

.mts-splash__mark {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
  animation: mts-splash-mark 1.35s cubic-bezier(.22, 1, .36, 1) forwards;
}

.mts-splash__logo {
  position: relative;
  display: block;
  width: clamp(250px, 48vw, 430px);
  /* the wipe: revealed left to right rather than faded up */
  clip-path: inset(0 100% 0 0);
  animation: mts-splash-wipe 1.35s cubic-bezier(.65, 0, .35, 1) forwards;
}

.mts-splash__logo img { width: 100%; height: auto; display: block; }

/* Masked to the artwork, so the sweep lights the letters themselves. */
.mts-splash__shine {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(105deg,
    transparent 38%,
    rgba(255, 255, 255, .10) 46%,
    rgba(255, 255, 255, .85) 50%,
    rgba(255, 255, 255, .10) 54%,
    transparent 62%);
  -webkit-mask-image: var(--mts-splash-logo);
  mask-image: var(--mts-splash-logo);
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  transform: translateX(-130%);
  animation: mts-splash-shine 1.35s cubic-bezier(.5, 0, .2, 1) forwards;
}

.mts-splash__rule {
  display: block;
  width: clamp(175px, 34vw, 300px);
  height: 2px;
  border-radius: 2px;
  background: linear-gradient(90deg,
    transparent, var(--brand-cta) 22%, var(--brand-cta) 78%, transparent);
  transform: scaleX(0);
  animation: mts-splash-rule 1.35s cubic-bezier(.22, 1, .36, 1) forwards;
}

@keyframes mts-splash-out {
  0%, 74%  { opacity: 1; visibility: visible; transform: scale(1); }
  100%     { opacity: 0; visibility: hidden; pointer-events: none; transform: scale(1.04); }
}

@keyframes mts-splash-glow {
  0%   { opacity: 0; transform: scale(1.06); }
  40%  { opacity: 1; transform: scale(1); }
  74%  { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes mts-splash-mark {
  0%   { opacity: 0; transform: translateY(12px); }
  30%  { opacity: 1; transform: translateY(0); }
  74%  { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-8px); }
}

@keyframes mts-splash-wipe {
  0%   { clip-path: inset(0 100% 0 0); }
  46%  { clip-path: inset(0 0 0 0); }
  100% { clip-path: inset(0 0 0 0); }
}

/* Starts only after the wipe has finished — a highlight on a mark that is not
   fully drawn yet just looks like a rendering fault. */
@keyframes mts-splash-shine {
  0%, 46%  { transform: translateX(-130%); }
  76%      { transform: translateX(130%); }
  100%     { transform: translateX(130%); }
}

@keyframes mts-splash-rule {
  0%, 26% { transform: scaleX(0); opacity: 1; }
  58%     { transform: scaleX(1); opacity: 1; }
  74%     { opacity: 1; }
  100%    { transform: scaleX(1); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .mts-splash { display: none; }
}

/* ===== Industries index ================================================
   It was a 4-up grid of 74px thumbnails in 12px-padded rows — small, dense,
   and reading as a list of buttons rather than a way into 26 categories. The
   art already exists (every industry collection carries a real photograph), so
   the fix is to let the picture lead instead of shrinking it into a chip.

   Three columns, not four: at four the cards were 240px wide and the longer
   names ("Sheathing & Moisture Management") wrapped to three lines. */
.ind-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.ind-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  padding: 0;
  overflow: hidden;
  border-radius: var(--r-lg);
  background: #fff;
  border: 1px solid var(--line);
  box-shadow: var(--sh-sm);
  transition: border-color .18s var(--ease), box-shadow .18s var(--ease), transform .18s var(--ease);
}

.ind-card:hover {
  border-color: var(--brand-cta);
  box-shadow: 0 1px 2px rgba(31,31,31,.05), 0 14px 30px -14px rgba(31,31,31,.28);
  transform: translateY(-3px);
}

.ind-card__img {
  width: 100%;
  height: auto;
  aspect-ratio: 8 / 5;
  border: 0;
  border-radius: 0;
  border-bottom: 1px solid var(--line);
  background: var(--panel);
  overflow: hidden;
}

.ind-card__img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* a restrained push-in on hover: enough to feel alive, not a zoom effect */
  transition: transform .5s var(--ease);
}
.ind-card:hover .ind-card__img img { transform: scale(1.045); }

/* Collections with no photo fall back to the icon — centre it rather than
   letting a 30px glyph sit in the corner of a 238px box. */
.ind-card__img--icon { display: grid; place-items: center; color: var(--brand-cta); }

.ind-card__body {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 16px 18px 18px;
}

.ind-card__body b {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 1.06rem;
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--ink);
  margin: 0;
}

.ind-card__body span {
  font-size: 0.82rem;
  color: var(--muted);
  gap: 6px;
}

/* The arrow travels on hover — the card's only moving affordance besides the
   image, so it reads as "go here" without a button. */
.ind-card__body span svg { transition: transform .18s var(--ease); }
.ind-card:hover .ind-card__body span { color: var(--brand-cta); }
.ind-card:hover .ind-card__body span svg { transform: translateX(3px); }

/* --- intro --- */
.ind-page__intro { padding-block: 14px 6px; }
.ind-page__intro h1 { font-family: var(--f-display); margin-bottom: 12px; }
.ind-page__intro p { font-size: 1.05rem; line-height: 1.65; }

@media (max-width: 1000px) { .ind-grid { grid-template-columns: repeat(2, minmax(0,1fr)); gap: 18px; } }
@media (max-width: 620px)  { .ind-grid { grid-template-columns: 1fr; gap: 16px; } }

/* ===== Card colour dots: larger =======================================
   20px read as punctuation next to a 1.05rem price. 24px is the point where a
   swatch reads as a material sample and can actually be judged at a glance,
   which is the only reason it is there. Overlap widened to match so the row
   still reads as one range rather than separate chips. */
.pc__dot { width: 24px; height: 24px; margin-left: -6px; }
.pc__dot:first-child { margin-left: 0; }
.pc__colours { min-height: 24px; }
.pc__colours-n { font-size: 0.78rem; }

@media (max-width: 640px) {
  .pc__dot { width: 21px; height: 21px; margin-left: -5px; }
  .pc__colours { min-height: 21px; }
}

/* ===== Footer buttons: larger =========================================
   38px is under the 44px minimum touch target in WCAG 2.5.5, so on a phone
   these were genuinely fiddly, not just small-looking. */
.ft-social a { width: 44px; height: 44px; border-radius: 11px; }
.ft-social { gap: 10px; }
.ft-social a svg { width: 19px; height: 19px; }

.ft-signup .btn--brand,
.ft-signup__box .btn--brand {
  padding: 13px 22px;
  font-size: 0.95rem;
}

@media (max-width: 640px) {
  .ft-social a { width: 46px; height: 46px; }
}

/* ===== Chat widget: put it on the store's palette =====================
   The widget shipped in its own warm-brown scheme (#2e2622 header, #2b231f
   bubbles, #fffdfb panel) which belongs to no other surface on this site. Next
   to a page built on #1f1f1f ink and #df3c22 brand it read as a third-party
   embed rather than part of the store.

   Only colour and radius are changed — layout, sizing and behaviour are left
   exactly as they were. */
.chatw__panel {
  background: #fff;
  border-color: var(--line);
  border-radius: var(--r-lg);
}

/* Charcoal, not brown — the same ink the header and footer sit on. The brand
   hairline along the top is kept; it is what ties the panel to the store. */
.chatw__head {
  background: linear-gradient(180deg, #2b2b2b 0%, var(--ink) 100%);
  box-shadow: inset 0 2px 0 var(--brand-cta), inset 0 -1px 0 rgba(255, 255, 255, .08);
}

.chatw__avatar {
  background: var(--brand-cta);
  color: #fff;
}

/* The visitor's own messages carry the brand; the assistant's stay neutral so
   the two are never confused.

   The modifier lives on the ROW, not the bubble — push() sets
   `chatw__row--user`. Targeting `.chatw__msg--me` (my first attempt) matched
   nothing at all and would have shipped the old brown bubble unchanged. */
.chatw__row--user .chatw__msg {
  background: var(--brand-cta);
  border-color: var(--brand-cta);
  color: #fff;
}

.chatw__launch {
  background: var(--brand-cta);
  box-shadow: 0 8px 24px rgba(223, 60, 34, .28), 0 0 0 3px #fff;
}
.chatw__launch:hover { background: var(--brand-cta-hov); }

.chatw__ask { background: #fff; }
.chatw__ask input {
  border-radius: var(--r);
  border-color: var(--line-2);
  font-family: var(--f-body);
}
.chatw__ask input:focus {
  outline: none;
  border-color: var(--brand-cta);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-cta) 16%, transparent);
}

@media (max-width: 640px) {
  .chatw__panel { border-radius: var(--r-lg) var(--r-lg) 0 0; }
}

/* ===== Product card: red CTA + red title, no colour animation ==========
   The card used to sell the action on hover — a white outlined button that
   filled red only when you pointed at it, and a title that turned red at the
   same moment. On a touch screen there is no hover, so half the catalogue's
   primary action never reached its intended state at all.

   Both are now red permanently. The only thing hover does is lift the card,
   which is the "pop" — no colour changes hands.

   TWO DIFFERENT REDS, deliberately:
     · the button is --brand-cta (#df3c22), the store's CTA fill everywhere;
     · the title is --brand-ink (#b62f18), the token built for TEXT. On white
       it measures ~6:1 where #df3c22 manages only 4.37:1 — under the 4.5:1
       AA floor for text this size. Same red family, one legible.
   This also matches mytapestore.com.au, where product titles are red. */
.pc__cta {
  background: var(--brand-cta);
  border-color: var(--brand-cta);
  color: #fff;
  transition: none;
}

.pc__cta:hover,
.pc:hover .pc__cta {
  background: var(--brand-cta);
  border-color: var(--brand-cta);
  color: #fff;
}

/* The arrow still nudges — motion, not a colour change. */
.pc__cta:hover svg { transform: translateX(3px); }

/* Out of stock must stay visibly dead: a red button that cannot be pressed is
   worse than no button. */
.pc__cta--out,
.pc__cta--out:hover,
.pc:hover .pc__cta--out {
  background: #fff;
  border-color: var(--line-2);
  color: var(--faint);
}

.pc__name a,
.pc:hover .pc__name a {
  color: var(--brand-ink);
  transition: none;
}

/* ===== Card meta: "In stock" and "2 sizes" ============================
   0.78rem and --t-xs sat below the price and the swatches and were being
   skipped. Stock status in particular is a buying signal, not fine print. */
.pc__stock { font-size: 0.86rem; }
.pc__stock-dot { width: 7px; height: 7px; }
.pc__sizes { font-size: 0.84rem; color: var(--muted); }
.pc__rating { gap: 8px; }

/* ===== Location pages =================================================
   These arrived as Elementor markup with its stylesheet gone: dozens of
   class-less divs, no measure, no rhythm, and a dead WordPress form. The body
   is now clean HTML, so the whole layout is set here.

   Two columns, because the page has two jobs: read about local supply, and ask
   for a price. The form is sticky — on a page that exists to generate an
   enquiry, the enquiry should never scroll away. */
.loc {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 380px;
  gap: 52px;
  align-items: start;
  padding-block: 40px 72px;
}

/* --- the copy --- */
.loc__body { max-width: 68ch; color: var(--ink-2); font-size: 1.0625rem; line-height: 1.75; }
.loc__body > *:first-child { margin-top: 0; }
.loc__body p { margin: 0 0 17px; }

.loc__body h2,
.loc__body h3 {
  font-family: var(--f-display);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.015em;
  line-height: 1.25;
  margin: 36px 0 14px;
  padding-top: 26px;
  border-top: 1px solid var(--line);
}
.loc__body h2 { font-size: 1.42rem; }
.loc__body h3 { font-size: 1.14rem; }
.loc__body > h2:first-child,
.loc__body > h3:first-child { padding-top: 0; border-top: 0; margin-top: 0; }

.loc__body ul, .loc__body ol { margin: 14px 0 20px; padding-left: 1.2rem; }
.loc__body li { margin-bottom: 8px; }
.loc__body li::marker { color: var(--brand-cta); }

/* The migrated images carry no dimensions; without this they render at their
   natural size and blow the measure apart. */
.loc__body img {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 22px 0;
  border-radius: var(--r-lg);
  border: 1px solid var(--line);
}

.loc__body a { color: var(--brand-cta); text-decoration: underline; text-underline-offset: 2px; }

/* --- the quote form --- */
.loc__side { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 14px; }

.loc__form {
  padding: 26px 26px 24px;
  background: #fff;
  border: 1px solid var(--line);
  border-top: 3px solid var(--brand-cta);
  border-radius: var(--r-lg);
  box-shadow: 0 1px 2px rgba(31,31,31,.05), 0 16px 36px -18px rgba(31,31,31,.20);
}

.loc__form h2 {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 1.32rem;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin: 6px 0 6px;
}
.loc__form-lede { margin: 0 0 18px; font-size: 0.9rem; line-height: 1.55; color: var(--muted); }

.loc__fields { display: flex; flex-direction: column; gap: 14px; }

/* Column labels, not inline — the same fix the sign-in form needed: without a
   display rule the label and its input share a line and the box overflows. */
.loc__fields label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 0.82rem;
  color: var(--ink-2);
}

.loc__fields input,
.loc__fields textarea {
  width: 100%;
  box-sizing: border-box;
  min-width: 0;
  padding: 11px 13px;
  font-family: var(--f-body);
  font-size: 0.95rem;
  color: var(--ink);
  background: #fff;
  border: 1px solid var(--line-2);
  border-radius: var(--r);
  transition: border-color .14s var(--ease), box-shadow .14s var(--ease);
}
.loc__fields textarea { resize: vertical; min-height: 96px; line-height: 1.5; }

.loc__fields input:focus,
.loc__fields textarea:focus {
  outline: none;
  border-color: var(--brand-cta);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-cta) 16%, transparent);
}

.loc__form-note {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin: 4px 0 0;
  font-size: 0.76rem;
  line-height: 1.5;
  color: var(--faint);
}
.loc__form-note svg { flex-shrink: 0; margin-top: 2px; }

.loc__sent {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 16px;
  background: color-mix(in srgb, var(--stock) 9%, #fff);
  border: 1px solid color-mix(in srgb, var(--stock) 32%, #fff);
  border-radius: var(--r);
  color: #1f7a2e;
  font-size: 0.92rem;
}
.loc__sent svg { flex-shrink: 0; }

.loc__call {
  padding: 16px 18px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  text-align: center;
}
.loc__call span { display: block; margin-bottom: 9px; font-size: 0.82rem; color: var(--muted); }

@media (max-width: 980px) {
  /* Form first on a phone: the enquiry is the page's purpose, and burying it
     under 900 words of local copy is how these pages convert nothing. */
  .loc { grid-template-columns: 1fr; gap: 30px; padding-block: 28px 56px; }
  .loc__side { position: static; order: -1; }
  .loc__body { max-width: none; }
}

/* ===== Footer =========================================================
   The footer's job on this store is capture: an email, a phone call, or a
   route into a category. Everything else is navigation furniture.

   What was wrong: `.ft-signup__box` was `width: fit-content` and centred — a
   small pill adrift in a wide dark band, with a 190px input. The one element
   the footer exists for was reading as its least important.

   SIGNATURE (one, and structural): the newsletter is now a full-width band
   carrying a brand rule down its left edge — the cut edge of a tape roll. A
   hazard-stripe motif was the obvious reach and was deliberately rejected:
   that pattern already means "hazard tape" on the PDP swatches, and spending
   it on decoration here would blunt a signal that currently carries meaning.

   Everything else stays quiet. Tokens only — ink ground, #df3c22, Inter/Sora,
   7/12px radii. */

.ft-main { padding-block: 56px 40px; }

/* --- the capture band --------------------------------------------------- */
.ft-signup {
  padding: 0;
  margin-bottom: 44px;
  border-top: 1px solid var(--line-ink);
  border-bottom: 1px solid var(--line-ink);
  background: rgba(255, 255, 255, .022);
}

.ft-signup__box {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 26px 0 26px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px 40px;
  flex-wrap: wrap;
  position: relative;
  background: none;
  border: 0;
}

/* the cut edge */
.ft-signup__box::before {
  content: "";
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 46px;
  border-radius: 3px;
  background: var(--brand-cta);
}

.ft-signup__badge { color: var(--brand-cta); letter-spacing: .12em; }

.ft-signup__title {
  font-family: var(--f-display);
  font-weight: 700;
  font-size: 1.24rem;
  line-height: 1.25;
  letter-spacing: -0.02em;
  color: #fff;
  white-space: normal;
  margin: 4px 0 0;
}

.ft-signup__form { gap: 10px; flex: 0 1 480px; }

.ft-signup__form input {
  width: auto;
  flex: 1 1 auto;
  min-width: 0;
  height: 50px;
  padding: 0 16px;
  font-size: 0.95rem;
  border-radius: var(--r);
  border-color: var(--line-ink);
  background: rgba(255, 255, 255, .05);
}
.ft-signup__form input:focus {
  border-color: var(--brand-cta);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand-cta) 22%, transparent);
}

.ft-signup__form .btn {
  height: 50px;
  border-radius: var(--r);
  padding-inline: 26px;
  font-size: 0.95rem;
  font-weight: 600;
}

/* --- column headings ---------------------------------------------------- */
/* A short brand tick above each heading: it marks where a column starts, which
   in a four-column dark footer is the one thing the eye needs. */
.ft-col h4 {
  position: relative;
  padding-top: 13px;
  margin-bottom: 15px;
  font-size: 0.78rem;
  letter-spacing: 0.1em;
}
.ft-col h4::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 18px;
  height: 2px;
  border-radius: 2px;
  background: var(--brand-cta);
}

.ft-col a { transition: color .14s var(--ease); }
.ft-col a:hover { color: #fff; }

/* --- contact + social --------------------------------------------------- */
.ft-contact { gap: 12px; }
.ft-contact a, .ft-contact span { font-size: 0.92rem; }
.ft-contact__ic {
  width: 34px;
  height: 34px;
  border-radius: 9px;
  background: rgba(255, 255, 255, .05);
  border: 1px solid var(--line-ink);
  color: var(--brand-cta);
}

.ft-social { gap: 11px; }
.ft-social a {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: rgba(255, 255, 255, .05);
  transition: background .16s var(--ease), border-color .16s var(--ease),
              color .16s var(--ease), transform .16s var(--ease);
}
.ft-social a svg { width: 20px; height: 20px; }
.ft-social a:hover { transform: translateY(-2px); }
.ft-social a:focus-visible { outline: 2px solid var(--brand-cta); outline-offset: 2px; }

/* --- bottom bar --------------------------------------------------------- */
.ft-bottom { border-top: 1px solid var(--line-ink); }
.ft-bottom__row { padding-block: 20px; gap: 14px 26px; }
.ft-bottom__row p { font-size: 0.8rem; color: var(--on-ink-mute); }

/* The payment marks are reassurance, not branding — they sit back until
   looked for. Full opacity on hover for anyone actually checking. */
.ft-pay__marks { gap: 8px; opacity: .72; transition: opacity .16s var(--ease); }
.ft-pay__marks:hover { opacity: 1; }
.ft-pay__marks img { border-radius: 4px; }

@media (max-width: 860px) {
  .ft-main { padding-block: 40px 28px; }
  .ft-signup { margin-bottom: 32px; }
  .ft-signup__box {
    flex-direction: column;
    align-items: stretch;
    text-align: left;
    padding: 22px 0 22px 18px;
    gap: 16px;
  }
  .ft-signup__box::before { top: 22px; transform: none; height: 38px; }
  .ft-signup__copy { align-items: flex-start; }
  .ft-signup__form { flex: 1 1 auto; }
  .ft-social a { width: 50px; height: 50px; }
}

/* --- minimum order quantity ------------------------------------------------
   20 products cannot be sold below a set count (2, 4 or 6), so the stepper has
   a floor. Two rules follow from that, and the second is the important one:

   1. At the floor the minus is genuinely unavailable, so it says so. A live
      button that silently refuses to decrement reads as a bug in the site.
   2. The constraint is stated in words next to it. Disabling a control without
      naming the reason leaves the shopper to guess, and "the site is broken"
      is the guess they reach first.

   The note is deliberately quiet — muted, one line, no fill. The Add to cart
   button is the one flare in this row and the minimum must not compete with
   it; it is a fact about the order, not a warning about it. */
.qty button:disabled,
.qty button[aria-disabled="true"] {
  opacity: .32;
  cursor: not-allowed;
}
.qty button:disabled:hover::after,
.qty button[aria-disabled="true"]:hover::after { background: transparent; }
.qty button:disabled:hover,
.qty button[aria-disabled="true"]:hover { color: var(--muted); }

.pdp-buy__minqty {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 10px 0 0;
  font-size: 0.8125rem;
  line-height: 1.35;
  color: var(--ink-2);
}
.pdp-buy__minqty svg {
  flex: none;
  color: var(--muted);
}

.cart-line__min {
  display: block;
  margin-top: 6px;
  font-size: 0.75rem;
  line-height: 1.3;
  text-align: center;
  color: var(--muted);
}

@media (max-width: 640px) {
  .cart-line__min { text-align: left; }
}

/* --- product reviews: our own panel ----------------------------------------
   Replaces the Judge.me widget. The 119 migrated reviews are almost all 5-star,
   which is a credibility problem as much as a selling point — a wall of perfect
   scores reads as filtered. So the summary leads with the distribution bars
   rather than a single number: showing the spread is what makes the score look
   measured. The write-a-review form is collapsed behind a button because the
   panel's first job is reading, not writing. */
.pdp-rev__head {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 28px;
  align-items: center;
  padding: 22px 24px;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  margin-bottom: 26px;
}
.pdp-rev__score { display: flex; flex-direction: column; gap: 5px; align-items: flex-start; }
.pdp-rev__score > b {
  font-family: var(--f-head);
  font-size: 2.6rem;
  line-height: 1;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.pdp-rev__count { font-size: 0.8125rem; color: var(--muted); }

.pdp-rev__bars { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 5px; }
.pdp-rev__bar { display: grid; grid-template-columns: 10px 12px 1fr 26px; gap: 8px; align-items: center; }
.pdp-rev__bar-k { font-size: 0.75rem; color: var(--ink-2); text-align: right; }
.pdp-rev__bar svg { color: var(--muted); }
.pdp-rev__bar-track { height: 6px; border-radius: 3px; background: var(--line); overflow: hidden; }
.pdp-rev__bar-fill { display: block; height: 100%; border-radius: 3px; background: var(--brand-cta); }
.pdp-rev__bar-n { font-size: 0.75rem; color: var(--muted); text-align: right; }

.pdp-rev__write { white-space: nowrap; }

.pdp-rev__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0; }
.pdp-rev__item { padding: 20px 0; border-top: 1px solid var(--line); }
.pdp-rev__item:first-child { border-top: 0; padding-top: 0; }
.pdp-rev__item.is-hidden { display: none; }
.pdp-rev__by { display: flex; align-items: center; gap: 11px; margin-bottom: 9px; }
.pdp-rev__avatar {
  flex: none;
  width: 36px; height: 36px;
  display: grid; place-items: center;
  border-radius: 50%;
  background: var(--brand-wash);
  color: var(--brand-ink);
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 0.9375rem;
}
.pdp-rev__meta { display: flex; flex-direction: column; line-height: 1.3; margin-right: auto; }
.pdp-rev__name { font-weight: 600; color: var(--ink); font-size: 0.9375rem; }
.pdp-rev__date { font-size: 0.75rem; color: var(--muted); }
.pdp-rev__body { margin: 0; color: var(--ink-2); line-height: 1.65; }
.pdp-rev__more { margin-top: 20px; width: 100%; }

/* write-a-review */
.pdp-rev__form { margin-top: 30px; padding-top: 26px; border-top: 2px solid var(--ink); }
.pdp-rev__form-h { font-family: var(--f-head); font-size: 1.15rem; margin: 0 0 16px; color: var(--ink); }
.pdp-rev__fields { display: flex; flex-direction: column; gap: 15px; }
.pdp-rev__label { display: flex; flex-direction: column; gap: 6px; font-size: 0.8125rem; font-weight: 600; color: var(--ink); }
.pdp-rev__label input, .pdp-rev__label textarea {
  font: inherit; font-weight: 400;
  padding: 11px 13px;
  border: 1.5px solid var(--line-2);
  border-radius: var(--r);
  background: #fff;
  color: var(--ink);
}
.pdp-rev__label input:focus, .pdp-rev__label textarea:focus {
  outline: none; border-color: var(--brand-cta);
  box-shadow: 0 0 0 3px var(--brand-wash);
}
.pdp-rev__hint { font-weight: 400; font-size: 0.75rem; color: var(--muted); }
.pdp-rev__rate { border: 0; padding: 0; margin: 0; }
.pdp-rev__rate legend { font-size: 0.8125rem; font-weight: 600; color: var(--ink); padding: 0 0 7px; }
/* radios reversed in the DOM so ~ can light every star up to the checked one */
.pdp-rev__stars-in { display: inline-flex; flex-direction: row-reverse; justify-content: flex-end; gap: 3px; }
.pdp-rev__stars-in input { position: absolute; opacity: 0; width: 0; height: 0; }
.pdp-rev__stars-in label { cursor: pointer; color: var(--line-2); line-height: 0; padding: 2px; border-radius: 5px; transition: color .12s var(--ease); }
.pdp-rev__stars-in label svg { fill: currentColor; }
.pdp-rev__stars-in input:checked ~ label,
.pdp-rev__stars-in label:hover,
.pdp-rev__stars-in label:hover ~ label { color: #e8a317; }
.pdp-rev__stars-in input:focus-visible + label { outline: 2px solid var(--brand-cta); outline-offset: 2px; }
.pdp-rev__actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }
.pdp-rev__sent {
  display: flex; align-items: center; gap: 10px;
  padding: 15px 17px; border-radius: var(--r-lg);
  background: var(--brand-wash); color: var(--brand-ink); font-weight: 600; margin: 0;
}
.pdp-rev__empty .pdp-rev__write { margin-top: 14px; }

@media (max-width: 760px) {
  .pdp-rev__head { grid-template-columns: 1fr; gap: 18px; padding: 20px; }
  .pdp-rev__score { flex-direction: row; align-items: baseline; gap: 12px; }
  .pdp-rev__write { width: 100%; justify-content: center; }
}

/* --- review form: undo the ported centring ---------------------------------
   product.css carries `.pdp-rev__form { text-align: center }` from the React
   port, where the form was a narrow centred card. This form is a real labelled
   fieldset, and centred labels above left-aligned inputs read as broken
   alignment. Reset it here rather than editing the port, which stays a faithful
   copy of the React source. */
.pdp-rev__form { text-align: left; }
.pdp-rev__form .pdp-rev__form-h { text-align: left; }
.pdp-rev__rate legend { text-align: left; }

/* The star picker sits at its natural width; the labels inside it are
   screen-reader text (.sr-only), so the row is stars only. */
.pdp-rev__stars-in { justify-content: flex-end; gap: 4px; }
.pdp-rev__stars-in label { display: inline-flex; align-items: center; }

/* --- express checkout (Shop Pay / PayPal / Apple Pay / Google Pay) ----------
   Shopify injects these buttons itself and owns their internals, so the theme
   only controls the space around them: full width, the theme's control radius,
   and a divider that makes them read as an alternative to the main CTA rather
   than a second competing one. The brand-red "Add to cart" stays the one flare
   in the buy box; the wallets are deliberately quieter. */
.pdp-buy__express { margin-top: 10px; }
.pdp-buy__express .shopify-payment-button__button,
.cart__express .shopify-payment-button__button {
  border-radius: var(--r) !important;
  min-height: 52px;
  font-family: var(--f-body);
  font-weight: 600;
}
.pdp-buy__express .shopify-payment-button__button--unbranded {
  background: var(--ink);
  color: #fff;
}
.pdp-buy__express .shopify-payment-button__button--unbranded:hover:not([disabled]) { background: #000; }
.pdp-buy__express .shopify-payment-button__more-options {
  margin-top: 8px;
  font-size: 0.8125rem;
  color: var(--ink-2);
  text-decoration: underline;
}
/* Shopify renders each wallet in its own iframe/row — keep them stacked and
   full width so a 3-wallet store does not produce a ragged grid. */
.pdp-buy__express > *,
.cart__express > * { width: 100%; }

.cart__express { margin-top: 14px; display: flex; flex-direction: column; gap: 9px; }
.cart__express-or {
  display: flex; align-items: center; gap: 12px;
  font-size: 0.75rem; letter-spacing: .06em; text-transform: uppercase;
  color: var(--muted); text-align: center;
}
.cart__express-or::before, .cart__express-or::after {
  content: ""; flex: 1; height: 1px; background: var(--line);
}

/* --- account dashboard: invoices, address book, profile --------------------
   The dashboard was read-only: it listed orders and addresses and offered no
   way to act on either. These are the controls for the write operations the
   Storefront customer token actually permits. Deliberately quiet — an account
   page is a utility, and a grid of red buttons would fight the one action that
   matters on any given screen. */
.acct-order__acts { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
.acct-order__btn {
  font: inherit;
  font-size: 0.8125rem;
  font-weight: 600;
  padding: 7px 13px;
  border-radius: var(--r);
  border: 1.5px solid var(--line-2);
  background: #fff;
  color: var(--ink);
  cursor: pointer;
  transition: border-color .14s var(--ease), color .14s var(--ease), background .14s var(--ease);
}
.acct-order__btn:hover { border-color: var(--ink); background: var(--paper); }
.acct-order__btn.is-danger:hover { border-color: var(--brand-cta); color: var(--brand-ink); background: var(--brand-wash); }
.acct-order__btn:focus-visible { outline: 2px solid var(--brand-cta); outline-offset: 2px; }

.mts-address { display: flex; flex-direction: column; gap: 12px; }
.mts-address__lines { flex: 1; }
.mts-address__acts { display: flex; gap: 7px; flex-wrap: wrap; }
.mts-address__add { margin-top: 16px; }

/* shared form shell for the address and profile editors */
.mts-addr-form {
  margin-top: 20px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: var(--paper);
}
.mts-addr-form h3 { font-family: var(--f-head); font-size: 1.05rem; margin: 0 0 16px; color: var(--ink); }
.mts-addr-form__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 13px; }
.mts-addr-form__f { display: flex; flex-direction: column; gap: 5px; font-size: 0.8125rem; font-weight: 600; color: var(--ink); }
.mts-addr-form__f.is-wide { grid-column: 1 / -1; }
.mts-addr-form__f input {
  font: inherit; font-weight: 400;
  padding: 10px 12px;
  border: 1.5px solid var(--line-2);
  border-radius: var(--r);
  background: #fff;
  color: var(--ink);
}
.mts-addr-form__f input:focus {
  outline: none; border-color: var(--brand-cta); box-shadow: 0 0 0 3px var(--brand-wash);
}
.mts-addr-form__hint { font-weight: 400; color: var(--muted); font-size: 0.75rem; }
.mts-addr-form__msg {
  margin: 13px 0 0; padding: 10px 13px; border-radius: var(--r);
  background: var(--brand-wash); color: var(--brand-ink); font-size: 0.85rem; font-weight: 600;
}
.mts-addr-form__acts { display: flex; gap: 9px; margin-top: 17px; flex-wrap: wrap; }

@media (max-width: 620px) {
  .mts-addr-form__grid { grid-template-columns: 1fr; }
  .acct-order__acts, .mts-address__acts { width: 100%; }
}

/* --- chat assistant: on-theme ----------------------------------------------
   The ported widget used 18px panel corners, 14px bubbles and fully-pill
   inputs. That is a different design language to the rest of this store, which
   is machined: 7px controls, 12px cards, square-shouldered. Softer corners are
   exactly what makes a widget read as a bolted-on third-party thing, which is
   the problem being fixed here.

   Colour was already on-token; the tell was geometry and weight. So: tighter
   radii, the ink masthead squared off, a brand-red rule under it to tie it to
   the emails and the footer, and one flare — the send button. */
.chatw__panel {
  border-radius: var(--r-lg);
  border: 1px solid var(--line-2);
  box-shadow: 0 24px 64px -12px rgba(20, 15, 10, .34), 0 2px 8px rgba(20, 15, 10, .08);
}
.chatw__head {
  padding: 14px 15px;
  border-bottom: 3px solid var(--brand-cta);
}
.chatw__avatar { border-radius: 9px; }
.chatw__head-info b { letter-spacing: -0.01em; }
.chatw__close { border-radius: 6px; }
.chatw__close:hover { background: rgba(255, 255, 255, .12); }

/* message bubbles — machined, with the tail corner squared off */
.chatw__msg {
  border-radius: 12px 12px 12px 3px;
  box-shadow: 0 1px 2px rgba(20, 15, 10, .04);
}
.chatw__row--user .chatw__msg { border-radius: 12px 12px 3px 12px; }

/* quick replies read as controls, not tags */
.chatw__quick { gap: 6px; padding: 11px 15px; }
.chatw__quick button {
  border-radius: var(--r);
  border-color: var(--line);
  background: #fff;
  color: var(--ink);
  padding: 7px 12px;
}
.chatw__quick button:hover {
  border-color: var(--brand-cta);
  background: var(--brand-wash);
  color: var(--brand-ink);
}

.chatw__form { padding: 11px 12px; gap: 9px; }
.chatw__form input {
  border-radius: var(--r);
  background: #fff;
  border-color: var(--line-2);
}
.chatw__form input:focus {
  border-color: var(--brand-cta);
  box-shadow: 0 0 0 3px var(--brand-wash);
}
.chatw__form button { border-radius: var(--r); width: 40px; height: 40px; }

/* launcher stays CIRCULAR — the original shape. A squircle was tried and
   reverted: a round floating action button is the universally understood
   affordance for chat, and the machined-corner language belongs to the page,
   not to a control that hovers above it. */
.chatw__launch {
  border-radius: 50%;
  box-shadow: 0 10px 26px rgba(223, 60, 34, .38), 0 0 0 3px #fff;
}
.chatw__launch:hover { box-shadow: 0 16px 34px rgba(223, 60, 34, .48), 0 0 0 3px #fff; }
.chatw__ping { border-radius: 50%; background: var(--brand-ink); }

/* teaser: same corner language, and a close target that is actually tappable */
.chatw__teaser {
  border-radius: var(--r-lg) var(--r-lg) 3px var(--r-lg);
  border-color: var(--line-2);
  padding: 10px 8px 10px 16px;
  font-size: 0.84rem;
}
.chatw__teaser-x {
  width: 26px; height: 26px;
  border-radius: 7px;
  color: var(--muted);
  cursor: pointer;
}
.chatw__teaser-x:hover { background: var(--brand-wash); color: var(--brand-ink); }
.chatw__teaser-x:focus-visible { outline: 2px solid var(--brand-cta); outline-offset: 2px; }

/* --- brand rail: step and hold ----------------------------------------------
   The rail advances one logo at a time and holds. Hierarchy is carried by
   scale, lift and shadow ONLY — off-centre plates keep full colour, because a
   washed-out brand logo reads as broken rather than de-emphasised.

   No underline, no accent rule. A coloured bar under the focused plate fought
   the logo it was meant to point at; the size and shadow change is enough, and
   leaving it out keeps the section calm. */
.brandx__track {
  animation: none !important;              /* replaced by the JS-driven transform */
  transition: transform 1.05s cubic-bezier(.36, .02, .16, 1);
  will-change: transform;
}

.brandx__plate {
  position: relative;
  transform: scale(.93);
  opacity: .86;
  box-shadow: 0 4px 14px rgba(0, 0, 0, .22);
  /* the rise trails the slide slightly, so the lift reads as a consequence of
     arriving rather than part of the same movement */
  transition:
    transform .72s cubic-bezier(.22, .8, .3, 1.02) .1s,
    opacity .5s ease,
    box-shadow .72s ease;
}
.brandx__plate.is-focus {
  transform: scale(1.07) translateY(-8px);
  opacity: 1;
  box-shadow: 0 20px 44px rgba(0, 0, 0, .42);
  z-index: 2;
}

.brandx__slider:hover .brandx__plate:hover {
  transform: scale(1.09) translateY(-10px);
  opacity: 1;
  cursor: pointer;
}

@media (prefers-reduced-motion: reduce) {
  .brandx__track { transition: none; transform: none !important; }
  .brandx__plate { transform: none; opacity: 1; transition: none; }
}

/* --- chat: no empty frame on open -------------------------------------------
   The gate for SmartBot's blank-white-shell flash. It lives on the shadow HOST
   in the light DOM rather than on anything inside the shadow root, because the
   element that paints first is one of several wrappers whose class names carry
   a per-build hash — gating the host covers all of them and cannot be broken
   by their next release.

   visibility, not display: a display:none host measures as zero, so their panel
   would lay out against a collapsed box and open scrolled to the wrong place. */
#smart-bot-container {
  transition: opacity .24s ease;
}
#smart-bot-container[data-mts-hold] {
  visibility: hidden !important;
  opacity: 0 !important;
}

/* --- product cards on touch: no hover state, two per row ---------------------
   TWO BUGS, ONE CAUSE AND ONE SIZING RULE.

   1. "Tapping a product needs two taps." The card carries ten :hover rules and
      no hover-capability guard. On a touch device the first tap is spent
      applying that hover state — the lift, the accent bar, the image zoom —
      and only the second one activates the card. Neutralising the hover
      effects where hovering does not exist makes the first tap navigate, which
      is what a phone user expects.

      `@media (hover: none)` rather than a width breakpoint: this is about the
      input device, not the screen size. A small laptop window still gets hover;
      a large tablet correctly does not.

   2. The collection grid dropped to a single column under 460px, so a phone
      showed one product per screen and everything else was a scroll away.
      Two-up is the norm for a catalogue this size and halves the scrolling. */
@media (hover: none) {
  .pc:hover {
    border-color: var(--line);
    box-shadow: var(--sh);
    transform: none;
  }
  .pc:hover::before { transform: scaleX(0); }
  .pc:hover .pc__name a { color: var(--ink); }
  .pc:hover .pc__media img { transform: none; }
  /* the wishlist button is hover-revealed on desktop; on touch it must be
     permanently visible or it is unreachable without a hover to trigger it */
  .pc__wish { opacity: 1; }
  .pc__cta:hover {
    background: #fff;
    border-color: var(--line-2);
    color: var(--ink);
  }
  .pc__cta:hover svg { transform: none; }
  /* keep a real pressed state so a tap still feels acknowledged */
  .pc:active { transform: scale(.995); }
  .pc__cta:active { background: var(--brand-cta); border-color: var(--brand-cta); color: #fff; }
}

/* two products per row on phones, down to the smallest widths */
@media (max-width: 460px) {
  .col__grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .grid-products,
  .grid-products--5 { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .grid-products--fit > * { width: calc(50% - 6px); min-width: 0; max-width: none; }
  /* the card has to survive a ~160px column, so trim its internal padding
     and step the type down rather than letting the title wrap to five lines */
  .pc__body { padding: 12px 12px 14px; }
  .pc__name { font-size: 0.88rem; line-height: 1.32; }
  .pc__price .num { font-size: 1.02rem; }
  .pc__cta { padding: 9px 10px; font-size: 0.78rem; }
  .pc__meta { gap: 6px; }
}

/* --- footer: one section, not four stacked panels ---------------------------
   The footer was carved into bands by three horizontal rules and a darker
   strip: newsletter | trust row | link columns | copyright. Each rule said
   "a new thing starts here", which is wrong — it is all one footer, and the
   stacking made a tall block feel taller.

   Every dividing line and the bottom bar's darker ground are removed, so the
   whole thing reads as a single ink panel. Separation is now carried by
   spacing alone, which is what holds a footer together rather than fencing it
   into compartments. */
.ft-signup {
  border-top: 0 !important;
  border-bottom: 0 !important;
  padding-top: 4px;
}
.ft-assure {
  border-top: 0 !important;
  border-bottom: 0 !important;
  margin-top: clamp(26px, 3.4vw, 38px);
}
/* the vertical rules between the three trust items go too — with the section
   rules gone they were the only lines left, which made them read as leftovers */
.ft-assure__item + .ft-assure__item { border-left: 0 !important; }
.ft-assure__row { gap: 8px 26px; }

.ft-bottom {
  background: transparent !important;   /* was rgba(0,0,0,.28) — a second panel */
  border-top: 0 !important;
}
.ft-bottom__row { padding-block: 6px 26px; }

/* with the rules gone the rhythm has to come from spacing */
.ft-main { padding-block: 34px 26px; }

@media (max-width: 520px) {
  .ft-assure__item + .ft-assure__item { border-top: 0 !important; }
  .ft-assure__row { gap: 14px; }
}

/* --- option values that are not made ---------------------------------------
   Struck through and dimmed rather than hidden. Removing them makes the range
   look smaller than it is, and leaves the shopper unable to tell whether
   96mm White is out of stock or simply never manufactured. */
.pdp-opt__btn.is-unavailable,
button[data-mts-opt].is-unavailable {
  opacity: .38;
  text-decoration: line-through;
  text-decoration-thickness: 1.5px;
}
button[data-mts-opt].is-unavailable:hover { border-color: var(--line-2); }
select[data-mts-opt] option.is-unavailable { color: var(--muted); }
