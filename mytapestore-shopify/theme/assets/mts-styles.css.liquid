/* ================= tokens.css ================= */
/* ============================================================================
   MY TAPE STORE — design tokens.
   "Established trade-supplier": the palette is the store's own, sampled from the
   live theme (brand red-orange #df3c22 + charcoal + neutral greys). Every text
   pair is measured for WCAG AA. Type is the Barlow family in three widths
   (industrial signage lineage), self-hosted. Radii are tight & machined.
   ========================================================================== */
:root {
  /* — brand: MyTapeStore red-orange (live theme-color #df3c22) ————————————— */
  --brand:        #df3c22;   /* bright brand — the store's exact theme colour */
  --brand-cta:    #df3c22;   /* CTA fill w/ white text — exact brand (≈4.4:1)  */
  --brand-cta-hov:#c1301a;   /* CTA hover (darken)                             */
  --brand-ink:    #b62f18;   /* brand-coloured TEXT on white  → 6.16:1  ✓ AA  */
  --brand-on-dark:#fa3c22;   /* brand-coloured TEXT on charcoal → 4.50:1 ✓ AA */
  /* Was #ee5f3a, which read visibly ORANGE next to the red CTAs in the footer.
     The cause was its green channel: 95 against the brand's 60. #fa3c22 keeps
     the brand's green (60) and blue (34) exactly and only lifts red 223→250 —
     same hue, bright enough to clear AA on #1f1f1f, where the brand red itself
     manages just 3.77:1 and is why a separate token exists at all. */
  --brand-wash:   #fdefeb;   /* faint tint surface                            */
  --brand-wash-2: #fbe1da;   /* deeper tint                                   */

  /* — ink & neutrals ——————————————————————————————————————————————————————— */
  --ink:      #1f1f1f;   /* header/footer ground, headings; white on it 16.7:1 */
  --ink-2:    #333333;   /* strong body                       → 12.6:1        */
  --muted:    #555555;   /* secondary text                    → 7.46:1  ✓     */
  --faint:    #6b6b6b;   /* finest text on white              → 5.33:1  ✓     */
  --white:    #ffffff;
  --paper:    #f5f4f2;   /* warm-neutral section band                          */
  --paper-2:  #efedea;   /* deeper band                                        */
  --panel:    #faf9f7;   /* raised panel                                       */
  --line:     #e3e1dd;   /* hairline                                           */
  --line-2:   #d3cfc9;   /* stronger divider                                   */

  /* — on dark (charcoal) ——————————————————————————————————————————————————— */
  --on-ink:      #ffffff;         /* → 16.7:1                                  */
  --on-ink-soft: #c9c6c1;         /* body on charcoal → 9.1:1                  */
  --on-ink-mute: #9c9893;         /* muted on charcoal → 5.0:1                 */
  --line-ink:    rgba(255,255,255,0.13);

  /* — status ——————————————————————————————————————————————————————————————— */
  --stock:  #1f7a2e;   /* in stock          → 5.41:1  ✓                        */
  --sale:   #c1301a;   /* sale price                                          */
  --star:   #d98a15;   /* rating gold on white → 3.6:1 (icon, not text)       */

  /* — type: Sora (display) + Inter (body/UI), self-hosted ————————————————— */
  --f-display: "Sora", "Space Grotesk", "Inter", system-ui, sans-serif;   /* headings, prices */
  --f-head:    "Sora", "Space Grotesk", "Inter", system-ui, sans-serif;   /* subheads, labels, nav */
  --f-body:    "Inter", system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
  --f-num:     "Sora", "Space Grotesk", "Inter", system-ui, sans-serif;   /* tabular via tnum   */

  --t-hero:  clamp(2.6rem, 5.4vw, 4.6rem);
  --t-h1:    clamp(2rem, 3.6vw, 3rem);
  --t-h2:    clamp(1.5rem, 2.6vw, 2.1rem);
  --t-h3:    1.25rem;
  --t-lead:  1.125rem;
  --t-body:  1rem;
  --t-sm:    0.875rem;
  --t-xs:    0.75rem;
  --t-eyebrow: 0.72rem;

  /* — radii: softened for a premium, refined feel ————————————————————————— */
  --r:      7px;
  --r-lg:   12px;
  --r-pill: 999px;

  /* — spacing ——————————————————————————————————————————————————————————————— */
  --sp-1: 4px;  --sp-2: 8px;  --sp-3: 12px; --sp-4: 16px;
  --sp-5: 24px; --sp-6: 32px; --sp-7: 48px; --sp-8: 64px; --sp-9: 88px;

  /* — elevation (restrained — this system leans on borders, not shadow) ———— */
  --sh-sm:  0 1px 2px rgba(20,15,10,0.06);
  --sh-md:  0 2px 4px rgba(20,15,10,0.07), 0 8px 22px rgba(20,15,10,0.06);
  --sh-lg:  0 4px 10px rgba(20,15,10,0.10), 0 18px 40px rgba(20,15,10,0.12);

  --maxw: 1280px;
  --ease: cubic-bezier(0.22, 0.61, 0.24, 1);
}

/* ================= base.css ================= */
/* ============================================================================
   Base reset + primitives shared across the store.
   ========================================================================== */
*, *::before, *::after { box-sizing: border-box; }
* { margin: 0; }
html { -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--f-body);
  font-size: var(--t-body);
  line-height: 1.6;
  color: var(--ink-2);
  background: var(--white);
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
img, svg, picture, video { display: block; max-width: 100%; }
img { height: auto; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; background: none; border: none; }
a { color: inherit; text-decoration: none; }
ul, ol { list-style: none; padding: 0; }
h1, h2, h3, h4 { font-family: var(--f-head); line-height: 1.08; color: var(--ink); font-weight: 700; letter-spacing: -0.01em; text-wrap: balance; }
strong { font-weight: 700; color: var(--ink); }

/* numerals: tabular everywhere prices/specs appear */
.num { font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1; }

/* layout container */
.wrap { width: 100%; max-width: var(--maxw); margin-inline: auto; padding-inline: 24px; }
@media (max-width: 640px){ .wrap { padding-inline: 16px; } }

/* skip link */
.skip {
  position: absolute; left: 8px; top: -60px; z-index: 200;
  background: var(--ink); color: #fff; padding: 10px 16px; border-radius: var(--r);
  font-family: var(--f-head); font-weight: 600;
  transition: top .16s var(--ease);
}
.skip:focus { top: 8px; }

/* global focus ring.
   `[tabindex]` matches on attribute PRESENCE, so a bare `[tabindex]` also rings
   every `tabindex="-1"` element — and `-1` means the exact opposite of what a
   focus ring communicates: programmatically focusable, deliberately NOT in the
   tab order. Nobody can ever reach one with a keyboard, so a keyboard focus
   indicator on it is noise, not affordance.
   That is not hypothetical here: the account area moves focus to each panel's
   heading after a nav click so screen readers announce the new panel, and the
   bare selector drew a red rectangle around "Your orders", "Downloads",
   "Addresses", "Account details" and "Wishlist" every time. Excluding -1 keeps
   the ring on everything a keyboard can actually land on. */
:where(a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])):focus-visible {
  outline: 3px solid var(--brand);
  outline-offset: 2px;
  border-radius: 3px;
}

/* eyebrow / kicker label — structural, tracked, uppercase */
.eyebrow {
  display: inline-flex; align-items: center; gap: 8px;
  font-family: var(--f-head); font-weight: 700;
  font-size: var(--t-eyebrow); letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--brand-ink);
}
.eyebrow::before {
  content: ""; width: 22px; height: 3px; background: var(--brand); display: inline-block;
}
.eyebrow--onink { color: var(--brand-on-dark); }
.eyebrow--onink::before { background: var(--brand-on-dark); }

/* buttons ------------------------------------------------------------------ */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  font-family: var(--f-head); font-weight: 700; letter-spacing: 0.02em;
  font-size: var(--t-sm); text-transform: uppercase;
  padding: 12px 22px; border-radius: var(--r); border: 1.5px solid transparent;
  transition: background .16s var(--ease), color .16s var(--ease), border-color .16s var(--ease), transform .08s var(--ease);
  white-space: nowrap;
}
.btn:active { transform: translateY(1px); }
.btn--brand { background: var(--brand-cta); color: #fff; }
.btn--brand:hover { background: var(--brand-cta-hov); }
.btn--dark { background: var(--ink); color: #fff; }
.btn--dark:hover { background: #000; }
.btn--ghost { background: #fff; color: var(--ink); border-color: var(--line-2); }
.btn--ghost:hover { border-color: var(--ink); }
.btn--onink { background: var(--brand-cta); color: #fff; }
.btn--onink:hover { background: var(--brand-cta-hov); }
.btn--onink-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,0.42); }
.btn--onink-ghost:hover { border-color: #fff; background: rgba(255,255,255,0.08); }
.btn--block { width: 100%; }
.btn--lg { padding: 15px 30px; font-size: var(--t-body); }
.btn--sm { padding: 9px 14px; font-size: var(--t-xs); }

/* pill/tag ----------------------------------------------------------------- */
.tag {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--f-head); font-weight: 600; font-size: var(--t-xs);
  letter-spacing: 0.04em; text-transform: uppercase;
  padding: 3px 9px; border-radius: var(--r); border: 1px solid var(--line-2);
  color: var(--muted); background: #fff;
}
.tag--brand { color: #fff; background: var(--brand-cta); border-color: var(--brand-cta); }
.tag--best  { color: #fff; background: var(--ink); border-color: var(--ink); }
.tag--best svg { color: var(--brand-cta); fill: var(--brand-cta); }
.tag--sale  { color: #fff; background: var(--sale); border-color: var(--sale); }
.tag--stock { color: var(--stock); border-color: color-mix(in srgb, var(--stock) 40%, #fff); background: color-mix(in srgb, var(--stock) 8%, #fff); }
.tag--out   { color: var(--faint); background: var(--paper); }
.tag--processing { color: var(--brand-ink); border-color: var(--brand-wash-2); background: var(--brand-wash); }

/* spec tag — the width×length identity of a tape, monospaced-tabular ------- */
.spectag {
  font-family: var(--f-head); font-weight: 600; font-size: var(--t-xs);
  letter-spacing: 0.02em; color: var(--ink-2);
  border: 1px solid var(--line-2); border-radius: var(--r);
  padding: 2px 7px; background: var(--panel);
  font-variant-numeric: tabular-nums;
}

/* section rhythm ----------------------------------------------------------- */
.section { padding-block: clamp(40px, 6vw, 76px); }
.section--tight { padding-block: clamp(28px, 4vw, 48px); }
.section--paper { background: var(--paper); }
.section--panel { background: var(--panel); }
.section--ink { background: var(--ink); color: var(--on-ink-soft); }

.section-head { display: flex; flex-direction: column; align-items: center; text-align: center; margin-bottom: 40px; }
.section-head h2 { font-size: var(--t-h2); letter-spacing: -0.01em; }
.section-head .eyebrow { margin-bottom: 13px; }
.section-title-wrap { max-width: 680px; }
.section-head p { color: var(--muted); margin-top: 10px; }

/* screen-reader only */
.sr-only {
  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
}

/* floating call-us button */
.callbtn { position: fixed; left: 20px; bottom: 20px; z-index: 90; display: inline-flex; align-items: center; gap: 11px; background: var(--brand-cta); color: #fff; padding: 11px 20px 11px 12px; border-radius: var(--r-pill); box-shadow: 0 12px 30px rgba(223,60,34,0.42);
  opacity: 0; transform: translateY(16px) scale(.94); pointer-events: none;
  transition: opacity .3s var(--ease), transform .3s var(--ease), background .16s var(--ease), box-shadow .22s var(--ease); }
.callbtn.is-visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
.callbtn:hover { background: var(--brand-cta-hov); transform: translateY(-3px) scale(1.02); box-shadow: 0 18px 42px rgba(223,60,34,0.5); }
.callbtn__ic { width: 38px; height: 38px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,0.16); position: relative; }
.callbtn__ic::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid rgba(255,255,255,0.55); animation: callpulse 2.4s var(--ease) infinite; }
@keyframes callpulse { 0% { transform: scale(1); opacity: .7; } 70% { transform: scale(1.7); opacity: 0; } 100% { opacity: 0; } }
.callbtn__txt { display: flex; flex-direction: column; line-height: 1.14; }
.callbtn__tag { font-style: normal; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.09em; font-size: 0.56rem; opacity: .9; max-height: 0; overflow: hidden; transition: max-height .24s var(--ease), margin .24s var(--ease); }
.callbtn:hover .callbtn__tag { max-height: 16px; margin-bottom: 2px; }
.callbtn__txt b { font-family: var(--f-head); font-weight: 700; font-size: 0.86rem; }
.callbtn__num { font-style: normal; font-size: 0.74rem; opacity: .92; }
@media (prefers-reduced-motion: reduce){ .callbtn { transition: opacity .2s linear; transform: none; } .callbtn.is-visible { transform: none; } .callbtn:hover { transform: none; } .callbtn__ic::after { animation: none; } }
@media (max-width: 560px){ .callbtn { padding: 10px; left: 16px; bottom: 16px; } .callbtn__txt { display: none; } }

@media (prefers-reduced-motion: reduce) {
  * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; scroll-behavior: auto !important; }
}

/* ================= header.css ================= */
/* ===== Header: utility bar · masthead · dark mega-nav · mobile drawer ===== */
/* display:contents so the sticky block's containing block is the full page
   (not the short header wrapper) — otherwise the sticky header unsticks early. */
.hd { display: contents; }

/* branding strip (original red bar) — centred facilities */
.hd-util {
  background: linear-gradient(115deg, #e2472c 0%, var(--brand) 45%, #c1301a 100%);
  color: #fff; font-family: var(--f-head);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.18), inset 0 -1px 0 rgba(0,0,0,.1);
}
.hd-util.grain::after { opacity: .09; z-index: 1; }
.hd-util__row { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; min-height: 42px; }
.hd-util__feats { display: flex; gap: 0; align-items: center; flex-wrap: wrap; justify-content: center; }
.hd-util li { display: inline-flex; align-items: center; gap: 8px; padding-inline: 20px; font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.02em; color: rgba(255,255,255,.94); }
.hd-util li svg { color: #fff; flex-shrink: 0; }
.hd-util__ic { display: inline-flex; align-items: center; justify-content: center; width: 20px; height: 20px; flex-shrink: 0; }
/* No background chip. The source icons are full-colour (shared with "Buy with
   confidence") but some are brand-red toned and disappear against this red strip
   without one — rendered as clean white silhouettes instead so every icon reads
   clearly against the gradient. */
.hd-util__ic img { display: block; filter: brightness(0) invert(1); opacity: .96; }
.hd-util__lead { font-weight: 700 !important; font-size: var(--t-sm); letter-spacing: 0.01em; color: #fff; padding-left: 0; }
.hd-util__sep { position: relative; }
.hd-util__sep::before { content: ""; position: absolute; left: 0; top: 50%; transform: translateY(-50%); width: 1px; height: 14px; background: rgba(255,255,255,.3); }
@media (max-width: 900px){ .hd-util .hd-util__sep:nth-child(n+3) { display: none; } }
@media (max-width: 560px){ .hd-util .hd-util__sep { display: none; } .hd-util__feats { gap: 0; } .hd-util__lead { padding-inline: 16px; } }

/* sticky block */
.hd-stick { position: sticky; top: 0; z-index: 100; background: #fff; box-shadow: var(--sh-sm); }

/* masthead */
.hd-mast { background: #fff; border-bottom: 1px solid var(--line); }
.hd-mast__row { display: flex; align-items: center; gap: 28px; min-height: 78px; }
.hd-logo { display: inline-flex; align-items: center; gap: 14px; flex-shrink: 0; }
.hd-logo__img { width: auto; height: 34px; display: block; }
.hd-logo__tag {
  display: none; padding-left: 14px; border-left: 1px solid var(--line-2);
  font-family: var(--f-head); font-weight: 600; font-size: 0.7rem; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--faint); max-width: 8ch; line-height: 1.25;
}
@media (min-width: 1120px){ .hd-logo__tag { display: block; } }

/* search + live autosuggest */
.search-ac { position: relative; flex: 1; max-width: 640px; margin-inline: auto; }
.hd-search { display: flex; align-items: center; width: 100%; height: 50px; padding: 0 6px 0 18px; background: var(--panel); border: 1.5px solid var(--line-2); border-radius: var(--r-pill); transition: border-color .16s var(--ease), box-shadow .16s var(--ease), background .16s var(--ease); }
.hd-search:focus-within { border-color: var(--brand); background: #fff; box-shadow: 0 0 0 3px var(--brand-wash); }
.hd-search__pre { color: var(--faint); flex-shrink: 0; }
.hd-search input { flex: 1; min-width: 0; height: 100%; border: none; background: transparent; padding: 0 12px; font-size: var(--t-body); }
.hd-search input:focus { outline: none; }
.hd-search__btn { height: 38px; padding: 0 22px; background: var(--brand-cta); color: #fff; border-radius: var(--r-pill); font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); flex-shrink: 0; transition: background .16s var(--ease); }
.hd-search__btn:hover { background: var(--brand-cta-hov); }

.search-ac__panel { position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 70; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-lg); overflow: hidden; max-height: 70vh; overflow-y: auto; }
.search-ac__group { padding: 8px; border-bottom: 1px solid var(--line); }
.search-ac__group:last-of-type { border-bottom: none; }
.search-ac__label { display: block; padding: 6px 10px 4px; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.66rem; color: var(--faint); }
.search-ac__cat, .search-ac__prod { display: flex; align-items: center; width: 100%; gap: 11px; padding: 9px 10px; border-radius: 9px; text-align: left; transition: background .12s var(--ease); }
.search-ac__cat:hover, .search-ac__cat.is-active, .search-ac__prod:hover, .search-ac__prod.is-active { background: var(--paper); }
.search-ac__cat svg { color: var(--faint); flex-shrink: 0; }
.search-ac__cat span { flex: 1; min-width: 0; font-size: 0.9rem; color: var(--ink-2); font-weight: 500; }
.search-ac__cat em { font-style: normal; font-size: var(--t-xs); color: var(--faint); }
.search-ac__prod img { width: 36px; height: 36px; object-fit: contain; border: 1px solid var(--line); border-radius: 6px; background: #fff; flex-shrink: 0; padding: 3px; }
.search-ac__prod-info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.search-ac__prod-info b { font-size: 0.88rem; font-weight: 600; color: var(--ink); line-height: 1.25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.search-ac__prod-info em { font-style: normal; font-size: var(--t-xs); color: var(--brand-ink); font-weight: 600; }
.search-ac__all { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 12px; background: var(--paper); font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--brand-ink); }
.search-ac__all:hover { background: var(--brand-wash); }

.hd-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
.hd-act { display: inline-flex; flex-direction: column; align-items: center; gap: 3px; padding: 6px 10px; color: var(--ink-2); border-radius: var(--r); }
.hd-act span { font-family: var(--f-head); font-size: var(--t-xs); font-weight: 600; letter-spacing: 0.03em; }
.hd-act:hover { color: var(--brand-ink); }
.hd-act__cart-icon { position: relative; display: inline-block; }
.hd-cart-badge {
  position: absolute; top: -7px; right: -9px; min-width: 18px; height: 18px; padding: 0 4px;
  background: var(--brand-cta); color: #fff; border-radius: var(--r-pill);
  font-size: 0.68rem; font-weight: 700; display: grid; place-items: center; line-height: 1;
}
.hd-burger { display: none; padding: 8px; color: var(--ink); }

/* mega-nav */
.hd-nav { background: var(--ink); }
.hd-nav__row { display: flex; align-items: center; justify-content: center; position: relative; }
.hd-nav__list { display: flex; align-items: stretch; }
.hd-nav__item { position: relative; }
.hd-nav__link {
  display: inline-flex; align-items: center; gap: 5px; height: 48px; padding: 0 18px;
  font-family: var(--f-head); font-weight: 600; font-size: 0.94rem; letter-spacing: 0.03em;
  text-transform: uppercase; color: #fff; position: relative;
  transition: background .16s var(--ease), color .16s var(--ease);
}
.hd-nav__link svg { opacity: .7; transition: transform .16s var(--ease); }
.hd-nav__item:hover .hd-nav__link, .hd-nav__item.is-open .hd-nav__link,
.hd-nav__link:focus-visible { background: rgba(255,255,255,.09); }
.hd-nav__item.is-open .hd-nav__link svg { transform: rotate(180deg); }

/* mega dropdown */
.hd-mega {
  position: absolute; top: 100%; left: 0; z-index: 60;
  background: #fff; border: 1px solid var(--line); border-top: none;
  box-shadow: var(--sh-lg); border-radius: 0 0 var(--r-lg) var(--r-lg);
  padding: 20px 24px; min-width: 320px;
  opacity: 0; visibility: hidden; pointer-events: none; transform: translateY(8px) scale(0.98); transform-origin: top center;
  transition: opacity .22s var(--ease), transform .24s var(--ease), visibility .22s;
}
/* Reveal is driven ONLY by the single-valued React state (.is-open) — never :hover or
   :focus-within, which can each stay true independently and let two panels show at once
   (e.g. a clicked button keeps DOM focus while the mouse opens a sibling via hover).
   openMenu is single-valued, onFocus/onBlur in JS keep keyboard nav in sync with it,
   so exactly one mega can ever be visible. */
.hd-nav__item.is-open .hd-mega {
  opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0) scale(1);
}
.hd-mega__cols { display: flex; gap: 34px; }
.hd-mega__cols ul { min-width: 190px; }
.hd-mega__cols a {
  display: block; padding: 6px 0; font-size: 0.95rem; color: var(--ink-2); border-bottom: 1px solid transparent;
}
.hd-mega__cols a:hover { color: var(--brand-ink); }
.hd-mega__all {
  display: inline-flex; align-items: center; gap: 6px; margin-top: 16px; padding-top: 14px;
  border-top: 1px solid var(--line); font-family: var(--f-head); font-weight: 700; text-transform: uppercase;
  font-size: var(--t-xs); letter-spacing: 0.05em; color: var(--brand-ink);
}
.hd-mega__all:hover { gap: 10px; }
/* right-side nav items open their dropdown leftward so it never overflows the viewport */
.hd-nav__item--right .hd-mega { left: auto; right: 0; }
/* never let a panel exceed the viewport */
.hd-mega { max-width: calc(100vw - 24px); }
/* the wide multi-column menu is centred on its button so its right edge can't run off
   the screen at narrow desktop widths (it overflowed ~66px at 920px before) */
.hd-nav__item--wide .hd-mega { left: 50%; right: auto; transform: translateX(-50%) translateY(8px) scale(0.98); }
.hd-nav__item--wide.is-open .hd-mega { transform: translateX(-50%) translateY(0) scale(1); }

.hd-nav__trade {
  position: absolute; right: 0; top: 50%; transform: translateY(-50%);
  display: inline-flex; align-items: center; gap: 7px; height: 34px; padding: 0 14px;
  border: 1.5px solid rgba(255,255,255,.28); border-radius: var(--r);
  font-family: var(--f-head); font-weight: 700; font-size: var(--t-xs); letter-spacing: 0.05em;
  text-transform: uppercase; color: #fff;
}
.hd-nav__trade svg { color: var(--brand); }
.hd-nav__trade:hover { background: var(--brand-cta); border-color: var(--brand-cta); }
.hd-nav__trade:hover svg { color: #fff; }

/* mobile drawer */
.hd-drawer { position: fixed; inset: 0; z-index: 200; }
.hd-drawer__scrim { position: absolute; inset: 0; background: rgba(15,12,10,.55); }
.hd-drawer__panel {
  position: absolute; top: 0; right: 0; height: 100%; width: min(390px, 88vw);
  background: #fff; display: flex; flex-direction: column; box-shadow: var(--sh-lg);
  animation: drawerIn .22s var(--ease);
}
@keyframes drawerIn { from { transform: translateX(100%); } to { transform: translateX(0); } }
.hd-drawer__top { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; background: var(--ink); color: #fff; }
.hd-drawer__top b { font-family: var(--f-head); text-transform: uppercase; letter-spacing: 0.08em; }
.hd-drawer__search { padding: 14px 16px; border-bottom: 1px solid var(--line); }
.hd-drawer__search .search-ac { max-width: none; margin: 0; }
.hd-drawer__nav { overflow-y: auto; padding: 6px 0 40px; }
.hd-drawer__acc, .hd-drawer__link {
  display: flex; align-items: center; justify-content: space-between; width: 100%; text-align: left;
  padding: 14px 18px; font-family: var(--f-head); font-weight: 600; font-size: 1rem; text-transform: uppercase;
  letter-spacing: 0.03em; color: var(--ink); border-bottom: 1px solid var(--line);
}
.hd-drawer__sub { background: var(--paper); border-bottom: 1px solid var(--line); }
.hd-drawer__sub a { display: block; padding: 11px 18px 11px 30px; font-size: 0.94rem; color: var(--ink-2); border-bottom: 1px solid var(--line); }
.hd-drawer__sub a:last-child { border-bottom: none; }

/* responsive: collapse nav into burger */
@media (max-width: 900px){
  .hd-nav, .hazard-rule--thin { display: none; }
  .hd-burger { display: inline-flex; }
  .hd-act:not(.hd-act--cart) { display: none; }
  .hd-mast__row { gap: 14px; min-height: 64px; }
  .hd-logo__img { height: 28px; }
}
@media (max-width: 620px){
  .search-ac { order: 3; flex-basis: 100%; max-width: none; margin: 0 0 12px; }
  .hd-mast__row { flex-wrap: wrap; padding-top: 12px; }
}

/* ================= home.css ================= */
/* ===== Home ===== */

/* shared product grid — roomy cards */
.grid-products { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.grid-products--5 { grid-template-columns: repeat(4, 1fr); }
@media (max-width: 1100px){ .grid-products, .grid-products--5 { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 720px){ .grid-products, .grid-products--5 { grid-template-columns: repeat(2, 1fr); gap: 14px; } }

/* Two cards sit side by side on a phone; if one card's meta row wraps to two
   lines and its neighbour's fits on one, every row beneath them is out of step
   again. Reserving the taller of the two keeps the pair locked together. */
@media (max-width: 720px) {
  .pc__rating { min-height: 38px; align-content: flex-start; }
}

/* Belt and braces: a long price, a long SKU or a wide swatch row must never be
   able to push the document wider than the screen. Nothing here is clipped —
   the elements shrink instead. */
@media (max-width: 720px) {
  html, body { overflow-x: hidden; }
  .cart-line, .cart__list, .cart__layout { max-width: 100%; min-width: 0; }
  .cart-line__sku, .cart-line__variant { overflow-wrap: anywhere; }
  .cart__head { flex-wrap: wrap; row-gap: 6px; }
}

/* Grid items default to min-width:auto, which means a single long unbreakable
   string inside a card can push its column wider than the 1fr it was given and
   shove the whole grid past the viewport. That is exactly what happened on the
   wishlist: collection pages hide .pc__cat, so nothing there was long enough to
   trigger it, but the wishlist shows it and "AIRCONDITIONING REFRIGERATION
   TAPES" blew the second column off screen. Allowing the items to be narrower
   than their content fixes this class of bug everywhere, not just here. */
.grid-products > *, .grid-products--5 > * { min-width: 0; }
.pc { min-width: 0; }

.pc__cat, .pc__name a { overflow-wrap: anywhere; }

/* The wishlist is a list of things the shopper already chose, so the category
   kicker earns nothing and costs three lines on a half-width card. Collection
   pages already hide it for the same reason. */
[data-mts-wish-grid] .pc__cat { display: none; }

/* fixed-width, centred cards — for short rows (related products, cart cross-sell) that
   shouldn't stretch to fill 4 columns when there are fewer than 4 items */
.grid-products--fit { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px; }
.grid-products--fit > * { flex: 0 1 auto; width: calc(25% - 15px); min-width: 240px; max-width: 300px; }
@media (max-width: 1100px){ .grid-products--fit > * { width: calc(33.333% - 14px); } }
@media (max-width: 720px){ .grid-products--fit { gap: 14px; } .grid-products--fit > * { width: calc(50% - 7px); min-width: 160px; } }
@media (max-width: 460px){ .grid-products--fit > * { width: calc(50% - 6px); max-width: none; } }

.section-cta { display: flex; justify-content: center; margin-top: 36px; }
.section-head__link { display: inline-flex; align-items: center; gap: 7px; margin-top: 18px; padding: 9px 20px; border: 1.5px solid var(--line-2); border-radius: var(--r-pill); font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--ink); }
.section-head__link:hover { border-color: var(--brand); color: var(--brand-ink); }

/* grain overlay for dark sections (subtle premium texture) */
.grain { position: relative; }
.grain::after { content: ""; position: absolute; inset: 0; background: url({{ 'mts-grain.png' | asset_url }}) repeat; background-size: 140px 140px; opacity: .35; pointer-events: none; z-index: 4; }

/* ---- hero slider (carousel) ---- */
.hslide { position: relative; overflow: hidden; background: var(--ink); }
.hslide__track { position: relative; min-height: clamp(440px, 46vw, 600px); }
.hslide__slide { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity .8s var(--ease); }
.hslide__slide.is-active { opacity: 1; pointer-events: auto; z-index: 1; }
.hslide__media { position: absolute; inset: 0; }
.hslide__media img { width: 100%; height: 100%; object-fit: cover; object-position: center right; }
.hslide__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14,11,9,.86) 0%, rgba(14,11,9,.55) 34%, rgba(14,11,9,.12) 62%, transparent 82%); }
.hslide__inner { position: relative; z-index: 2; min-height: clamp(440px, 46vw, 600px); display: flex; align-items: center; padding-block: 56px; }
.hslide__content { max-width: 560px; color: #fff; }
.hslide__eyebrow { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--t-xs); color: var(--brand-on-dark); }
.hslide__title { font-family: var(--f-display); font-weight: 700; font-size: clamp(2rem, 4.2vw, 3.4rem); line-height: 1.03; letter-spacing: -0.02em; color: #fff; margin: 14px 0 16px; }
.hslide__text { font-size: var(--t-lead); color: var(--on-ink-soft); margin-bottom: 28px; max-width: 46ch; }
.hslide__cta { display: flex; gap: 12px; flex-wrap: wrap; }
/* fade-up the active slide's content */
.hslide__slide.is-active .hslide__content > * { animation: slideUp .6s var(--ease) both; }
.hslide__slide.is-active .hslide__title { animation-delay: .06s; }
.hslide__slide.is-active .hslide__text { animation-delay: .12s; }
.hslide__slide.is-active .hslide__cta { animation-delay: .18s; }
@keyframes slideUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }

.hslide__arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; border: 1px solid rgba(255,255,255,.28); backdrop-filter: blur(4px); transition: background .16s var(--ease); }
.hslide__arrow:hover { background: var(--brand-cta); border-color: var(--brand-cta); }
.hslide__arrow--prev { left: 20px; }
.hslide__arrow--prev svg { transform: rotate(180deg); }
.hslide__arrow--next { right: 20px; }
.hslide__dots { position: absolute; bottom: 22px; left: 0; right: 0; z-index: 5; display: flex; justify-content: center; gap: 10px; }
.hslide__dot { width: 30px; height: 4px; border-radius: var(--r-pill); background: rgba(255,255,255,.4); transition: background .16s var(--ease), width .16s var(--ease); }
.hslide__dot:hover { background: rgba(255,255,255,.7); }
.hslide__dot.is-active { background: var(--brand); width: 44px; }
@media (max-width: 860px){
  .hslide__media img { object-position: center; }
  .hslide__media::after { background: linear-gradient(0deg, rgba(14,11,9,.9) 12%, rgba(14,11,9,.5) 55%, rgba(14,11,9,.2)); }
  .hslide__inner { align-items: flex-end; padding-bottom: 54px; }
  .hslide__arrow { display: none; }
}
@media (max-width: 480px){ .hslide__cta { flex-direction: column; } .hslide__cta .btn { width: 100%; } }

/* ---- hero (full-bleed banner + overlay card) ---- */
.hero { position: relative; overflow: hidden; background: var(--ink); }
.hero__media { position: absolute; inset: 0; }
.hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.hero__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(100deg, rgba(15,12,10,.44) 0%, rgba(15,12,10,.14) 40%, rgba(15,12,10,0) 62%); }
.hero__wrap { position: relative; min-height: clamp(430px, 44vw, 560px); display: flex; align-items: center; justify-content: flex-end; padding-block: 48px; }
.hero__card { width: min(470px, 100%); background: rgba(255,255,255,.98); border-radius: 18px; border-top: 4px solid var(--brand); padding: clamp(26px, 3vw, 42px); box-shadow: var(--sh-lg); }
.hero__eyebrow { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.16em; font-size: var(--t-xs); color: var(--brand-ink); }
.hero__title { font-family: var(--f-display); font-weight: 700; font-size: clamp(1.9rem, 3.1vw, 2.8rem); line-height: 1.05; letter-spacing: -0.02em; color: var(--ink); margin: 12px 0 14px; }
.hero__lead { font-size: var(--t-lead); color: var(--muted); margin-bottom: 26px; max-width: 42ch; }
.hero__cta { display: flex; gap: 12px; flex-wrap: wrap; }
@media (max-width: 860px){
  .hero__media { position: relative; height: 230px; }
  .hero__media::after { background: linear-gradient(0deg, rgba(15,12,10,.28), transparent 55%); }
  .hero__wrap { justify-content: center; min-height: 0; padding-block: 0 40px; }
  .hero__card { width: 100%; margin-top: -64px; box-shadow: var(--sh-md); }
}
@media (max-width: 480px){ .hero__cta { flex-direction: column; } .hero__cta .btn { width: 100%; } }

/* ---- trust strip ---- */
.trust { background: var(--ink); }
.trust__row { display: grid; grid-template-columns: repeat(4, 1fr); }
.trust__item { display: flex; align-items: center; gap: 13px; padding: 18px 22px; color: #fff; }
.trust__item + .trust__item { border-left: 1px solid var(--line-ink); }
.trust__item svg { color: var(--brand); flex-shrink: 0; }
.trust__item b { display: block; font-family: var(--f-display); font-size: 1.35rem; letter-spacing: -0.01em; line-height: 1; }
.trust__item span { display: block; font-size: var(--t-xs); color: var(--on-ink-mute); }
@media (max-width: 780px){ .trust__row { grid-template-columns: 1fr 1fr; } .trust__item:nth-child(3){ border-left: none; } .trust__item:nth-child(n+3){ border-top: 1px solid var(--line-ink); } }
@media (max-width: 440px){ .trust__row { grid-template-columns: 1fr; } .trust__item + .trust__item { border-left: none; border-top: 1px solid var(--line-ink); } }

/* ---- intro band (editorial two-column) ---- */
.intro__grid { display: grid; grid-template-columns: 0.82fr 1.18fr; gap: clamp(32px, 5vw, 60px); align-items: start; }
.intro__title { font-family: var(--f-display); font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -0.02em; line-height: 1.08; margin: 12px 0 22px; }
.intro__cta { align-self: flex-start; }
.intro__body { padding-top: 4px; }
.intro__lead { font-size: var(--t-lead); color: var(--muted); line-height: 1.72; }
.intro__brands { margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--line); }
.intro__brands-label { display: block; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--t-xs); color: var(--faint); margin-bottom: 13px; }
.intro__chips { display: flex; flex-wrap: wrap; gap: 9px; }
.intro__chip { font-family: var(--f-head); font-weight: 600; font-size: 0.9rem; color: var(--ink-2); background: #fff; border: 1px solid var(--line-2); border-radius: var(--r-pill); padding: 8px 16px; transition: border-color .16s var(--ease), color .16s var(--ease), background .16s var(--ease); }
.intro__chip:hover { border-color: var(--brand); color: var(--brand-ink); background: var(--brand-wash); }
.intro__stats { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: clamp(40px, 5vw, 56px); border: 1px solid var(--line); border-radius: 16px; overflow: hidden; background: linear-gradient(180deg, var(--panel), #fff); box-shadow: 0 1px 2px rgba(20,15,10,.04); }
.intro__stats > div { padding: 24px 18px; text-align: center; }
.intro__stats > div + div { border-left: 1px solid var(--line); }
.intro__stats b { display: block; font-family: var(--f-display); font-size: clamp(1.7rem, 2.6vw, 2.15rem); color: var(--brand-ink); line-height: 1; letter-spacing: -0.01em; }
.intro__stats span { display: block; margin-top: 8px; font-size: var(--t-sm); color: var(--muted); }
@media (max-width: 820px){ .intro__grid { grid-template-columns: 1fr; gap: 24px; } }
@media (max-width: 620px){ .intro__stats { grid-template-columns: 1fr 1fr; } .intro__stats > div:nth-child(3){ border-left: none; } .intro__stats > div:nth-child(n+3){ border-top: 1px solid var(--line); } }

/* ---- category showcase ---- */
.catx { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
.catx__card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; position: relative; box-shadow: 0 1px 2px rgba(20,15,10,.05); transition: transform .18s var(--ease), box-shadow .18s var(--ease), border-color .18s var(--ease); }
.catx__card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform .24s var(--ease); z-index: 2; }
.catx__card:hover { transform: translateY(-5px); box-shadow: var(--sh-lg); border-color: var(--line-2); }
.catx__card:hover::before { transform: scaleX(1); }
.catx__imgwrap { position: relative; aspect-ratio: 4 / 3; background: radial-gradient(circle at 50% 34%, #ffffff 0%, var(--paper) 78%); border-bottom: 1px solid var(--line); overflow: hidden; }
.catx__imgwrap img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .4s var(--ease); }
.catx__card:hover .catx__imgwrap img { transform: scale(1.07); }
.catx__body { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; }
.catx__text b { display: block; font-family: var(--f-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); line-height: 1.15; }
.catx__text span { font-size: var(--t-xs); color: var(--faint); }
.catx__arrow { width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--brand-wash); color: var(--brand-ink); transition: background .16s var(--ease), color .16s var(--ease); }
.catx__card:hover .catx__arrow { background: var(--brand-cta); color: #fff; }
@media (max-width: 1000px){ .catx { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 680px){ .catx { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

/* ---- brand wall ---- */
.brandx { position: relative; overflow: hidden; text-align: center; color: #fff; padding-block: clamp(44px, 5vw, 68px); background: radial-gradient(120% 130% at 50% -20%, #2a2a2a 0%, var(--ink) 55%, #131313 100%); }
.brandx__title { font-family: var(--f-display); font-size: clamp(1.5rem, 2.6vw, 2rem); color: #fff; letter-spacing: -0.015em; margin: 12px 0 10px; }
.brandx__sub { color: var(--on-ink-soft); font-size: var(--t-sm); max-width: 60ch; margin: 0 auto 30px; }
.brandx__slider { position: relative; margin-top: 8px; overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent); }
.brandx__track { display: flex; gap: 22px; width: max-content; padding: 6px 8px; animation: brandscroll 34s linear infinite; }
.brandx__slider:hover .brandx__track { animation-play-state: paused; }
@keyframes brandscroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.brandx__plate { flex-shrink: 0; width: 244px; height: 124px; display: grid; place-items: center; padding: 16px 26px; border-radius: 14px; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,.25); border: 1px solid rgba(0,0,0,.04); transition: transform .25s var(--ease), box-shadow .25s var(--ease); }
.brandx__slider:hover .brandx__plate:hover { transform: translateY(-6px); box-shadow: 0 16px 36px rgba(0,0,0,.42); }
.brandx__logo { max-width: 100%; max-height: 84px; width: auto; height: auto; object-fit: contain; }

/* premium trust stats under the marquee */
.brandx__stats { display: flex; justify-content: center; align-items: center; margin-top: clamp(30px, 4vw, 44px); }
.brandx__stat { text-align: center; padding: 4px clamp(22px, 5vw, 58px); }
.brandx__stat + .brandx__stat { border-left: 1px solid var(--line-ink); }
.brandx__stat b { display: block; font-family: var(--f-display); font-weight: 700; font-size: clamp(1.7rem, 3vw, 2.3rem); color: #fff; line-height: 1; letter-spacing: -0.01em; }
.brandx__stat span { display: block; margin-top: 8px; font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--t-xs); color: var(--on-ink-mute); }
@media (max-width: 480px){ .brandx__stat { padding: 4px 16px; } .brandx__stat span { letter-spacing: 0.04em; } }
@media (prefers-reduced-motion: reduce){ .brandx__track { animation: none; flex-wrap: wrap; justify-content: center; } }

/* ---- comprehensive range ---- */
.range__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 52px; align-items: center; }
.range__copy h2 { font-family: var(--f-display); font-size: var(--t-h2); letter-spacing: -0.02em; margin: 12px 0 24px; }
.range__blocks { display: flex; flex-direction: column; gap: 20px; margin-bottom: 28px; }
.range__block { display: flex; gap: 15px; }
.range__ic { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; border-radius: 12px; background: var(--brand-wash); color: var(--brand-ink); }
.range__block h3 { font-size: 1.1rem; margin-bottom: 4px; }
.range__block p { color: var(--muted); font-size: var(--t-sm); line-height: 1.6; }
.range__media { position: relative; border-radius: 18px; overflow: hidden; background: radial-gradient(circle at 50% 40%, #fff, var(--paper)); border: 1px solid var(--line); aspect-ratio: 1/1; box-shadow: var(--sh-md); }
.range__media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.range__chip { position: absolute; left: 20px; bottom: 20px; background: #fff; border: 1px solid var(--line); border-left: 4px solid var(--brand); border-radius: 10px; padding: 9px 14px; font-family: var(--f-display); font-weight: 700; color: var(--brand-ink); box-shadow: var(--sh-sm); }
.range__chip em { font-style: normal; font-size: 0.6rem; color: var(--faint); text-transform: uppercase; letter-spacing: 0.04em; }
@media (max-width: 860px){ .range__grid { grid-template-columns: 1fr; gap: 32px; } .range__media { max-width: 420px; margin-inline: auto; } }

/* ---- seal the deal ---- */
.seal { position: relative; overflow: hidden; }
.seal__media { position: absolute; inset: 0; }
.seal__media img { width: 100%; height: 100%; object-fit: cover; filter: brightness(.42) saturate(.9); }
.seal__media::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,12,10,.55), rgba(15,12,10,.7)); }
.seal__inner { position: relative; z-index: 5; text-align: center; color: #fff; padding-block: clamp(56px, 8vw, 104px); max-width: 720px; margin: 0 auto; }
.seal__title { font-family: var(--f-display); font-size: clamp(2rem, 4vw, 3.2rem); color: #fff; letter-spacing: -0.02em; margin: 14px 0 14px; }
.seal__lead { color: var(--on-ink-soft); font-size: var(--t-lead); margin: 0 auto 28px; max-width: 54ch; }
.seal__cta { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

/* ---- industries showcase ---- */
.indx-hero { position: relative; border-radius: var(--r-lg); overflow: hidden; margin-bottom: 30px; min-height: clamp(340px, 43vw, 496px); display: grid; place-items: center; padding: 30px; border: 1px solid var(--line); box-shadow: var(--sh-lg); isolation: isolate; }
.indx-hero__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; z-index: -1; }
.indx-hero__panel { text-align: center; max-width: 540px; padding: clamp(24px, 3.4vw, 40px) clamp(24px, 3.4vw, 44px); background: rgba(255,253,250,0.9); backdrop-filter: blur(3px) saturate(1.05); -webkit-backdrop-filter: blur(3px) saturate(1.05); border: 1px solid rgba(255,255,255,0.85); border-radius: var(--r-lg); box-shadow: 0 22px 60px -18px rgba(28,18,10,0.4), 0 2px 8px rgba(28,18,10,0.08); }
.indx-hero__panel .eyebrow { color: var(--brand-ink); }
.indx-hero__panel h2 { margin: 12px 0 10px; }
.indx-hero__panel p { color: var(--muted); max-width: 42ch; margin: 0 auto; }
.indx-hero__cta { margin-top: 22px; }
@media (max-width: 560px){ .indx-hero { padding: 20px; min-height: 380px; } .indx-hero__panel { background: rgba(255,253,250,0.94); } }

/* premium photo tiles — the original store shows a flat photo-per-industry grid;
   this keeps that but adds card chrome, an image-reveal gradient, and hover the original lacks */
.indx-tile { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 1px 2px rgba(20,15,10,.06); transition: transform .2s var(--ease), box-shadow .2s var(--ease), border-color .2s var(--ease); }
.indx-tile:hover { transform: translateY(-4px); box-shadow: var(--sh-lg); border-color: var(--brand); }
.indx-tile__media { position: absolute; inset: 0; background: var(--paper); }
.indx-tile__media img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s var(--ease); }
.indx-tile:hover .indx-tile__media img { transform: scale(1.06); }
.indx-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(18,13,10,.9) 0%, rgba(18,13,10,.45) 40%, rgba(18,13,10,.04) 72%); }
.indx-tile__body { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 14px 16px; }
.indx-tile__name { display: block; font-family: var(--f-display); font-weight: 600; font-size: 1.02rem; line-height: 1.18; letter-spacing: -0.01em; color: #fff; }
.indx-tile__num { display: inline-flex; align-items: center; gap: 6px; margin-top: 5px; font-size: var(--t-xs); color: rgba(255,255,255,.82); transition: color .16s var(--ease); }
.indx-tile__num svg { transition: transform .16s var(--ease); }
.indx-tile:hover .indx-tile__num { color: #fff; }
.indx-tile:hover .indx-tile__num svg { transform: translateX(3px); }

/* auto-advancing strip — shows 4–5 industries at a time, slides to the next set every ~2.8s */
.indx-strip__viewport { overflow: hidden; }
.indx-strip__track { display: flex; transition: transform .65s cubic-bezier(.65,0,.35,1); }
.indx-strip__page { flex: 0 0 100%; display: grid; gap: 16px; }
.indx-strip__dots { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 22px; }
.indx-strip__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--line-2); transition: background .2s var(--ease), width .2s var(--ease); }
.indx-strip__dot:hover { background: var(--faint); }
.indx-strip__dot.is-on { background: var(--brand); width: 24px; border-radius: 5px; }
@media (prefers-reduced-motion: reduce){ .indx-strip__track { transition: none; } }

/* ---- testimonials ---- */
.tmx { position: relative; overflow: hidden; color: #fff; padding-block: clamp(40px, 4.5vw, 64px); background: radial-gradient(120% 120% at 50% -10%, #2a2a2a 0%, var(--ink) 55%, #131313 100%); }
.tmx .section-head { position: relative; z-index: 5; }
.tmx__title { color: #fff; font-family: var(--f-display); letter-spacing: -0.015em; }
.tmx__lead { color: var(--on-ink-soft); }
/* single-row infinite review strip */
.tmx__marquee { position: relative; z-index: 5; overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent);
  mask-image: linear-gradient(90deg, transparent, #000 5%, #000 95%, transparent); }
.tmx__track { display: flex; gap: 16px; width: max-content; padding: 6px 8px; animation: tmxscroll 64s linear infinite; }
.tmx__marquee:hover .tmx__track { animation-play-state: paused; }
@keyframes tmxscroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
.tmx__card { width: 366px; flex-shrink: 0; background: #fff; border-radius: 14px; padding: 22px; display: flex; flex-direction: column; gap: 12px; box-shadow: var(--sh-md); }
.tmx__starrow { display: inline-flex; gap: 2px; }
.tmx__starrow .on { color: var(--star); }
.tmx__starrow .off { color: var(--line-2); }
.tmx__card blockquote { color: var(--ink-2); line-height: 1.58; font-size: 0.96rem; flex: 1; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.tmx__card figcaption { display: flex; align-items: center; gap: 11px; padding-top: 12px; border-top: 1px solid var(--line); }
.tmx__ava { width: 36px; height: 36px; }
.tmx__ava { width: 40px; height: 40px; flex-shrink: 0; display: grid; place-items: center; border-radius: 50%; background: var(--brand-wash); color: var(--brand-ink); font-family: var(--f-display); font-weight: 700; }
.tmx__who b { display: block; font-family: var(--f-head); color: var(--ink); font-size: 0.98rem; }
.tmx__who em { font-style: normal; font-size: var(--t-xs); color: var(--faint); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
@media (max-width: 520px){ .tmx__card { width: 300px; } }
@media (prefers-reduced-motion: reduce){ .tmx__track { animation: none; } }

/* ---- wholesale / bulk ---- */
.wholesale__grid { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 48px; align-items: center; }
.wholesale__media { border-radius: 18px; overflow: hidden; border: 1px solid var(--line); box-shadow: var(--sh-md); }
.wholesale__media img { width: 100%; height: 100%; object-fit: cover; display: block; aspect-ratio: 4 / 3.4; }
.wholesale__title { font-family: var(--f-display); font-size: var(--t-h2); letter-spacing: -0.02em; margin: 12px 0 12px; max-width: 20ch; }
.wholesale__intro { color: var(--muted); font-size: var(--t-lead); margin-bottom: 24px; max-width: 54ch; }
.wholesale__perks { display: flex; flex-direction: column; gap: 16px; margin-bottom: 28px; }
.wholesale__perks li { display: flex; gap: 14px; }
.wholesale__ic { width: 40px; height: 40px; flex-shrink: 0; display: grid; place-items: center; border-radius: 11px; background: var(--brand-wash); color: var(--brand-ink); }
.wholesale__perks b { display: block; font-family: var(--f-head); font-weight: 700; color: var(--ink); font-size: 1rem; margin-bottom: 2px; }
.wholesale__perks span { color: var(--muted); font-size: var(--t-sm); line-height: 1.55; }
@media (max-width: 860px){ .wholesale__grid { grid-template-columns: 1fr; gap: 30px; } .wholesale__media { max-width: 520px; } }

/* ---- faq + delivery map ---- */
/* map card is vertically centred against the FAQ list so the two columns read as a
   balanced, symmetric pair (and the map sits a little below the first question) */
.faq__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 40px; align-items: center; }
.faq__map { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: #fff; box-shadow: var(--sh-md); }
.faq__map img { width: 100%; display: block; aspect-ratio: 4 / 3; object-fit: cover; background: #f4f3f0; }
.faq__map-copy { padding: 22px 24px 24px; }
.faq__map-badge { display: inline-flex; align-items: center; gap: 6px; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--t-xs); color: var(--brand-ink); }
.faq__map-badge svg { color: var(--brand); }
.faq__map-copy b { display: block; font-family: var(--f-display); font-size: 1.25rem; letter-spacing: -0.01em; margin: 10px 0 8px; color: var(--ink); }
.faq__map-copy p { color: var(--muted); font-size: var(--t-sm); line-height: 1.6; }
@media (max-width: 860px){ .faq__grid { grid-template-columns: 1fr; gap: 28px; } .faq__map { position: static; max-width: 460px; margin-inline: auto; } }
.faq__list { display: flex; flex-direction: column; gap: 10px; }
.faq__item { border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: #fff; transition: border-color .16s var(--ease), box-shadow .16s var(--ease); }
.faq__item.is-open { border-color: var(--line-2); box-shadow: var(--sh-sm); }
.faq__q { display: flex; align-items: center; justify-content: space-between; gap: 16px; width: 100%; text-align: left; padding: 18px 20px; font-family: var(--f-head); font-weight: 600; font-size: 1.02rem; color: var(--ink); }
.faq__q svg { flex-shrink: 0; color: var(--brand-ink); }
.faq__a { padding: 0 20px 20px; }
.faq__a p { color: var(--muted); line-height: 1.7; }

/* ---- value props ---- */
.vprops { display: grid; grid-template-columns: repeat(4, 1fr); gap: 22px; }
.vprop { position: relative; text-align: center; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 42px 26px 34px; overflow: hidden; box-shadow: 0 1px 2px rgba(20,15,10,.05); transition: transform .24s var(--ease), box-shadow .24s var(--ease), border-color .24s var(--ease); }
.vprop::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform .3s var(--ease); }
.vprop:hover::before { transform: scaleX(1); }
.vprop:hover { transform: translateY(-6px); box-shadow: var(--sh-lg); border-color: var(--line-2); }
/* icons stand on their own — no circular badge, just soft depth + a lift on hover */
.vprop__icon { display: grid; place-items: center; height: 72px; margin-bottom: 20px; transition: transform .28s var(--ease); }
.vprop__icon svg { width: 46px; height: 46px; stroke-width: 1.85; color: var(--brand-ink); }
.vprop__icon img { width: 64px; height: 64px; object-fit: contain; filter: drop-shadow(0 8px 16px rgba(20,15,10,.14)); }
.vprop:hover .vprop__icon { transform: translateY(-3px) scale(1.06); }
.vprop h3 { font-family: var(--f-display); font-weight: 600; font-size: 1.18rem; letter-spacing: -0.01em; line-height: 1.22; margin-bottom: 10px; }
.vprop p { color: var(--muted); font-size: 0.92rem; line-height: 1.6; max-width: 25ch; margin-inline: auto; }
@media (max-width: 900px){ .vprops { grid-template-columns: 1fr 1fr; } }
@media (max-width: 480px){ .vprops { grid-template-columns: 1fr; } }

/* ================= product-card.css ================= */
/* ===== Product card + rating stars ===== */
.stars { display: inline-flex; align-items: center; gap: 7px; }
.stars__row { display: inline-flex; }
.stars__on { color: var(--star); }
.stars__off { color: var(--line-2); }
.stars__count { font-size: var(--t-xs); color: var(--faint); }

.pc {
  display: flex; flex-direction: column; background: #fff; position: relative;
  border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
  cursor: pointer; box-shadow: 0 1px 2px rgba(20,15,10,.05);
  transition: border-color .18s var(--ease), box-shadow .18s var(--ease), transform .18s var(--ease);
}
/* signature: brand top-accent reveals on hover */
.pc::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform .24s var(--ease); z-index: 3; }
.pc:hover { border-color: var(--line-2); box-shadow: var(--sh-lg); transform: translateY(-5px); }
.pc:hover::before { transform: scaleX(1); }
.pc:hover .pc__name a { color: var(--brand-ink); }

.pc__media { position: relative; aspect-ratio: 1 / 1; background: #fff; border-bottom: 1px solid var(--line); overflow: hidden; }
.pc__media img { width: 100%; height: 100%; object-fit: contain; padding: 20px; transition: transform .35s var(--ease); }
.pc:hover .pc__media img { transform: scale(1.045); }
.pc__badges { position: absolute; top: 10px; left: 10px; display: flex; flex-direction: column; gap: 6px; z-index: 2; }
.pc__wish {
  position: absolute; top: 9px; right: 9px; width: 36px; height: 36px; display: grid; place-items: center; z-index: 2;
  background: rgba(255,255,255,.94); border: 1px solid var(--line); border-radius: 50%; color: var(--faint);
  opacity: 0; transition: opacity .16s var(--ease), color .16s var(--ease);
}
.pc:hover .pc__wish { opacity: 1; }
.pc__wish:hover { color: var(--brand-ink); border-color: var(--line-2); }
.pc__wish.is-on { opacity: 1; color: var(--brand); }
.pc__wish.is-on svg { fill: var(--brand); }

.pc__body { display: flex; flex-direction: column; gap: 8px; padding: 15px 16px 16px; flex: 1; }
/* The kicker is ONE line, always.
   As inline-flex it wrapped to three lines on "HOOK AND LOOP TAPE/VELCRO®
   BRAND TAPE" and two on its neighbour, so every row below it — title, rating,
   sizes, price — sat at a different height in each card and the pair looked
   broken. The rule also drifted to the middle of the block, because a flex
   item centres against wrapped text. Clamping to one line fixes the alignment
   and puts the rule back at the start of the line where it reads as a marker. */
.pc__cat {
  display: block; min-width: 0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  font-family: var(--f-head); font-size: var(--t-xs); font-weight: 700;
  letter-spacing: 0.08em; text-transform: uppercase; color: var(--brand-ink);
}
.pc__cat::before {
  content: ""; display: inline-block; width: 15px; height: 2px;
  background: var(--brand); vertical-align: middle;
  margin-right: 8px; position: relative; top: -1px;
}
.pc__name { font-size: 1.02rem; line-height: 1.25; font-weight: 600; font-family: var(--f-head); }
.pc__name a { color: var(--ink); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.5em; transition: color .16s var(--ease); }
.pc__rating { display: flex; align-items: center; gap: 8px; min-height: 18px; }
.pc__sizes { font-size: var(--t-xs); color: var(--faint); }

.pc__foot { margin-top: auto; padding-top: 8px; }
.pc__price { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; line-height: 1; margin-bottom: 12px; }
.pc__from { font-size: var(--t-xs); color: var(--faint); text-transform: uppercase; letter-spacing: 0.04em; font-weight: 600; }
.pc__price b { font-family: var(--f-display); font-weight: 700; font-size: 1.65rem; color: var(--ink); }
.pc__gst { font-size: 0.62rem; color: var(--faint); text-transform: uppercase; letter-spacing: 0.04em; }
.pc__cta {
  display: flex; align-items: center; justify-content: center; gap: 7px; width: 100%; padding: 11px 12px;
  border: 1.5px solid var(--ink); border-radius: 10px; background: #fff; color: var(--ink);
  font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs);
  transition: background .16s var(--ease), color .16s var(--ease), border-color .16s var(--ease);
}
.pc__cta svg { transition: transform .16s var(--ease); }
.pc__cta:hover { background: var(--brand-cta); border-color: var(--brand-cta); color: #fff; }
.pc__cta:hover svg { transform: translateX(3px); }
.pc__cta--out { border-color: var(--line-2); color: var(--faint); cursor: not-allowed; }
.pc__cta--out:hover { background: #fff; color: var(--faint); border-color: var(--line-2); }

@media (max-width: 520px){
  .pc__body { padding: 12px 12px 13px; gap: 7px; }
  .pc__price b { font-size: 1.4rem; }
  .pc__cta { padding: 9px 10px; }
}

/* ================= footer.css ================= */
/* ===== Footer (premium) ===== */
.ft { position: relative; overflow: hidden; color: var(--on-ink-soft); background: radial-gradient(130% 100% at 50% 0%, #272727 0%, var(--ink) 46%, #101010 100%); }
.ft > * { position: relative; z-index: 1; }

/* newsletter — compact self-contained box, centred at the foot (doesn't span the footer) */
.ft-signup { padding-top: 4px; }
.ft-signup__box { display: flex; align-items: center; justify-content: space-between; gap: 12px 26px; flex-wrap: wrap; width: fit-content; max-width: 100%; margin: 14px auto; padding: 13px 18px; background: rgba(255,255,255,0.04); border: 1px solid var(--line-ink); border-radius: 14px; }
.ft-signup__copy { display: flex; flex-direction: column; gap: 3px; }
.ft-signup__badge { display: inline-flex; align-items: center; gap: 6px; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-size: var(--t-xs); color: var(--brand-on-dark); }
.ft-signup__badge svg { flex-shrink: 0; }
.ft-signup__title { font-family: var(--f-display); font-weight: 600; font-size: 0.96rem; letter-spacing: -0.01em; color: #fff; line-height: 1.25; white-space: nowrap; }
.ft-signup__form { display: flex; gap: 8px; }
.ft-signup__form input { width: 190px; height: 42px; border: 1px solid var(--line-ink); background: rgba(255,255,255,0.06); border-radius: 9px; padding: 0 13px; color: #fff; font-size: var(--t-sm); }
.ft-signup__form input::placeholder { color: var(--on-ink-mute); }
.ft-signup__form input:focus { outline: none; border-color: var(--brand); background: rgba(255,255,255,0.1); }
.ft-signup__form .btn { border-radius: 9px; height: 42px; white-space: nowrap; }
.ft-signup__done { display: inline-flex; align-items: center; gap: 8px; color: #7ed08a; font-weight: 600; font-size: var(--t-sm); }
.ft-signup__done svg { flex-shrink: 0; }
@media (max-width: 480px){ .ft-signup__box { width: 100%; flex-direction: column; align-items: stretch; text-align: center; } .ft-signup__copy { align-items: center; } .ft-signup__form { width: 100%; } .ft-signup__form input { width: auto; flex: 1; } }

/* reassurance strip */
.ft-assure { margin-top: clamp(40px, 5vw, 58px); border-top: 1px solid var(--line-ink); border-bottom: 1px solid var(--line-ink); }
.ft-assure__row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; padding-block: 24px; }
.ft-assure__item { display: flex; align-items: center; gap: 13px; padding: 4px 12px; }
.ft-assure__item + .ft-assure__item { border-left: 1px solid var(--line-ink); }
.ft-assure__item svg { color: var(--brand); flex-shrink: 0; }
.ft-assure__item b { display: block; color: #fff; font-family: var(--f-head); font-weight: 600; font-size: 0.98rem; }
.ft-assure__item span { display: block; font-size: var(--t-xs); color: var(--on-ink-mute); line-height: 1.35; }
@media (max-width: 860px){ .ft-assure__row { grid-template-columns: 1fr 1fr; } .ft-assure__item:nth-child(3){ border-left: none; } }
@media (max-width: 520px){ .ft-assure__row { grid-template-columns: 1fr; } .ft-assure__item + .ft-assure__item { border-left: none; border-top: 1px solid var(--line-ink); } }

/* main columns */
.ft-main { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 36px; padding-block: 30px 22px; }
.ft-logo { display: inline-flex; align-items: center; margin-bottom: 13px; }
.ft-logo__img { width: auto; height: 30px; display: block; }
.ft-blurb { font-size: var(--t-sm); color: var(--on-ink-mute); max-width: 44ch; margin-bottom: 14px; line-height: 1.55; }
.ft-contact { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
.ft-contact li { display: flex; align-items: center; gap: 10px; font-size: var(--t-sm); }
.ft-contact__ic { width: 30px; height: 30px; flex-shrink: 0; display: grid; place-items: center; border-radius: 8px; background: rgba(255,255,255,0.06); border: 1px solid var(--line-ink); color: var(--brand); }
.ft-contact a:hover { color: #fff; }
.ft-col .ft-social { display: flex; flex-direction: row; flex-wrap: wrap; gap: 8px; }
.ft-social a { width: 38px; height: 38px; display: grid; place-items: center; border: 1px solid var(--line-ink); border-radius: 10px; color: var(--on-ink-soft); transition: background .16s var(--ease), border-color .16s var(--ease), color .16s var(--ease); }
.ft-social a:hover { background: var(--brand-cta); border-color: var(--brand-cta); color: #fff; }

.ft-col h4 { color: #fff; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.8rem; margin-bottom: 13px; }
.ft-col ul { display: flex; flex-direction: column; gap: 9px; }
.ft-col ul a { font-size: var(--t-sm); color: var(--on-ink-soft); transition: color .14s var(--ease), padding-left .14s var(--ease); }
.ft-col ul a:hover { color: var(--brand-on-dark); padding-left: 4px; }
.ft-more { color: var(--brand-on-dark) !important; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs) !important; }
@media (max-width: 860px){ .ft-main { grid-template-columns: 1fr 1fr; gap: 32px; } .ft-col--brand { grid-column: 1 / -1; } }
@media (max-width: 440px){ .ft-main { grid-template-columns: 1fr; } }

/* bottom bar */
.ft-bottom { background: rgba(0,0,0,0.28); border-top: 1px solid var(--line-ink); }
.ft-bottom__row { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 13px; flex-wrap: wrap; }
.ft-bottom p { font-size: var(--t-xs); color: var(--on-ink-mute); }
/* Legal line — the ABN is one identifier and must never break mid-number.
   It stays nowrap, and on narrow screens moves onto its own line rather than
   wrapping, so "ABN 93 878 995 217" always reads as a single unit. */
.ft-legal__abn { white-space: nowrap; }
.ft-legal__sep { margin-inline: 5px; }
@media (max-width: 600px) {
  .ft-legal__sep { display: none; }
  .ft-legal__abn { display: block; margin-top: 4px; }
}
.ft-pay__marks { display: flex; gap: 6px; flex-wrap: wrap; }
.ft-pay__marks img { height: 24px; background: #fff; border-radius: 4px; padding: 2px 4px; }

/* ================= ui.css ================= */
/* ===== Shared UI primitives (used across pages) ===== */

/* breadcrumbs */
.crumbs { padding-block: 16px; }
.crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 4px; }
.crumbs li { display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-sm); color: var(--faint); }
.crumbs a { color: var(--muted); }
.crumbs a:hover { color: var(--brand-ink); }
.crumbs [aria-current="page"] { color: var(--ink-2); font-weight: 600; }
.crumbs__sep { color: var(--line-2); }

/* quantity stepper */
.qty { display: inline-flex; align-items: stretch; border: 1.5px solid var(--line-2); border-radius: var(--r); overflow: hidden; background: #fff; }
.qty button { width: 40px; display: grid; place-items: center; color: var(--ink-2); transition: background .12s var(--ease); }
.qty button:hover { background: var(--paper); color: var(--brand-ink); }
.qty input { width: 46px; text-align: center; border: none; border-inline: 1.5px solid var(--line); font-family: var(--f-head); font-weight: 700; font-size: 1rem; }
.qty input:focus { outline: none; background: var(--brand-wash); }

/* spec table */
.spec-table { width: 100%; border-collapse: collapse; font-size: var(--t-sm); }
.spec-table tr { border-bottom: 1px solid var(--line); }
.spec-table tr:last-child { border-bottom: none; }
.spec-table th { text-align: left; font-family: var(--f-head); font-weight: 600; color: var(--muted); padding: 10px 14px 10px 0; white-space: nowrap; vertical-align: top; width: 38%; }
.spec-table td { padding: 10px 0; color: var(--ink-2); vertical-align: top; }

/* empty state */
.col__empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; text-align: center; padding: 60px 20px; color: var(--faint); }
.col__empty svg { color: var(--line-2); }
.col__empty p { color: var(--muted); max-width: 42ch; }

/* page hero (content pages) */
.page-hero { background: var(--ink); color: var(--on-ink-soft); padding-block: clamp(40px, 5vw, 66px); text-align: center; }
.page-hero h1 { color: #fff; font-family: var(--f-head); font-weight: 700; font-size: var(--t-h1); letter-spacing: -0.015em; margin: 14px 0 14px; }
.page-hero p { max-width: 62ch; margin: 0 auto; color: var(--on-ink-soft); font-size: var(--t-lead); }
.page-hero__cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 26px; }
.page-hero--plain { background: transparent; color: inherit; padding-block: 32px 4px; }
.page-hero--plain h1 { color: var(--ink); }
.page-prose { margin-inline: auto; }

/* prose */
.page-prose { padding-block: 44px 64px; max-width: 760px; }
.page-prose p { color: var(--ink-2); font-size: var(--t-lead); margin-bottom: 18px; }
.page-note { font-size: var(--t-sm) !important; color: var(--faint) !important; border-left: 3px solid var(--brand); padding-left: 14px; background: var(--paper); padding-block: 12px; border-radius: 0 var(--r) var(--r) 0; }

/* policy pages (shipping / returns / privacy / terms) */
.page-hero__intro { margin-top: 6px; }
.page-prose--policy { max-width: 820px; }
.policy-block { margin-bottom: 28px; }
.policy-block:last-of-type { margin-bottom: 0; }
.policy-block__h { font-family: var(--f-display); font-weight: 700; font-size: 1.32rem; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 10px; }
.policy-block p { margin-bottom: 0; }
.policy-list { list-style: none; display: flex; flex-direction: column; gap: 11px; margin: 2px 0 0; padding: 0; }
.policy-list li { display: flex; align-items: flex-start; gap: 11px; color: var(--ink-2); font-size: var(--t-lead); line-height: 1.6; }
.policy-list li svg { color: var(--stock); flex-shrink: 0; margin-top: 5px; }
.policy-help { display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; margin-top: 38px; padding: 22px 26px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); }
.policy-help b { display: block; font-family: var(--f-head); font-weight: 700; font-size: 1.06rem; color: var(--ink); margin-bottom: 4px; }
.policy-help > div span { font-size: var(--t-sm); color: var(--muted); }
.policy-help a[href^="tel"], .policy-help a[href^="mailto"] { color: var(--brand-ink); font-weight: 600; }
.policy-help a[href^="tel"]:hover, .policy-help a[href^="mailto"]:hover { text-decoration: underline; }

/* account / sign-in page */
.auth { display: grid; grid-template-columns: minmax(0, 440px) 1fr; gap: clamp(28px, 5vw, 60px); align-items: start; padding-block: 8px 64px; max-width: 940px; margin-inline: auto; }
.auth__card { border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; box-shadow: var(--sh-md); overflow: hidden; }
.auth__tabs { display: grid; grid-template-columns: 1fr 1fr; }
.auth__tab { padding: 15px; font-family: var(--f-head); font-weight: 700; font-size: 0.95rem; color: var(--muted); background: var(--panel); border-bottom: 2px solid var(--line); transition: color .16s var(--ease), background .16s var(--ease); }
.auth__tab.is-active { color: var(--ink); background: #fff; border-bottom-color: var(--brand); }
.auth__tab:not(.is-active):hover { color: var(--ink); }
.auth__form { display: flex; flex-direction: column; gap: 16px; padding: 26px 26px 24px; }
.auth__field { display: flex; flex-direction: column; gap: 7px; }
.auth__field > span { display: flex; align-items: baseline; justify-content: space-between; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--ink-2); }
.auth__forgot { font-size: var(--t-xs); font-weight: 600; color: var(--brand-ink); }
.auth__forgot:hover { text-decoration: underline; }
.auth__field input { height: 46px; border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 0 14px; font-size: var(--t-body); background: #fff; transition: border-color .14s var(--ease), box-shadow .14s var(--ease); }
.auth__field input:focus { outline: none; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-wash); }
.auth__form .btn { margin-top: 4px; }
.auth__alt { text-align: center; font-size: var(--t-sm); color: var(--muted); padding: 0 26px 24px; }
.auth__alt button { font-weight: 600; color: var(--brand-ink); }
.auth__alt button:hover { text-decoration: underline; }
.auth__done { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 10px; padding: 34px 26px; }
.auth__done-ic { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: color-mix(in srgb, var(--stock) 12%, #fff); color: var(--stock); margin-bottom: 4px; }
.auth__done b { font-family: var(--f-display); font-size: 1.3rem; color: var(--ink); }
.auth__done p { color: var(--muted); font-size: var(--t-sm); }
.auth__done .btn { margin-top: 10px; }
.auth__perks { display: flex; flex-direction: column; gap: 16px; padding-top: 12px; }
.auth__perks li { display: flex; align-items: center; gap: 13px; font-size: var(--t-body); color: var(--ink-2); }
.auth__perks svg { flex-shrink: 0; color: var(--brand); }
@media (max-width: 720px){ .auth { grid-template-columns: 1fr; } .auth__perks { order: -1; padding: 0 0 8px; } }

/* wishlist page */
.wishlist__count { color: var(--muted); font-size: var(--t-sm); margin-top: 8px; }
.wishlist__foot { margin-top: 30px; display: flex; justify-content: center; }
/* The fixed call and chat buttons hover over the bottom of every page, and on
   the wishlist the bottom is "Continue shopping" — the one control there. Give
   it room to sit clear of them. */
@media (max-width: 860px) {
  .wishlist__foot { margin-bottom: calc(72px + env(safe-area-inset-bottom)); }
}
.wishlist__back { transform: rotate(180deg); }
.wishlist__empty-ic { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: var(--brand-wash); color: var(--brand-ink); }
.page-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin: 30px 0; }
.page-stats { max-width: 100%; }
.page-stats > div { min-width: 0; }
.page-stats b, .page-stats span { overflow-wrap: anywhere; }
.page-stats > div { border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: var(--r-lg); padding: 18px; text-align: center; }
.page-stats b { display: block; font-family: var(--f-display); font-size: 2rem; color: var(--brand-ink); line-height: 1; }
.page-stats span { font-size: var(--t-sm); color: var(--muted); }
@media (max-width: 620px){ .page-stats { grid-template-columns: 1fr 1fr; } }
.page__crumbs, .search__crumbs, .ind-page__crumbs { }

/* account dashboard */
/* ---------------------------------------------------------------- password
   Every password field in the theme gets a Show/Hide control, injected by
   initPasswordToggles rather than repeated across six templates. A word reads
   faster than an eye glyph and needs no explaining, and it sits inside the
   field so it never widens the form. */
.pw-wrap { position: relative; display: block; }
.pw-wrap > input { width: 100%; padding-right: 68px; }
.pw-toggle {
  position: absolute; top: 50%; right: 6px; transform: translateY(-50%);
  background: none; border: 0; cursor: pointer;
  padding: 6px 9px; border-radius: 6px;
  font-family: var(--f-head); font-weight: 700; font-size: 0.74rem;
  letter-spacing: 0.04em; text-transform: uppercase; color: var(--brand-ink);
  transition: background .12s var(--ease);
}
.pw-toggle:hover { background: var(--brand-wash); }
.pw-toggle:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; }

.acct { display: grid; grid-template-columns: 256px 1fr; gap: 32px; align-items: start; padding-block: 8px 64px; }
/* Grid children default to min-width:auto, so the nowrap nav strip below was
   able to push its own column — and therefore the whole page — wider than the
   viewport. That is what cut the stat tiles and the tabs off at the right edge
   on a phone. The strip must scroll inside its column, not widen it. */
.acct > *, .acct__side, .acct__main { min-width: 0; }
.acct__nav { max-width: 100%; }
.acct__side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 24px; }
.acct__profile { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 24px 18px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); }
.acct__avatar { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--brand-cta); color: #fff; font-family: var(--f-display); font-weight: 700; font-size: 1.25rem; }
.acct__profile b { font-family: var(--f-head); font-size: 0.98rem; color: var(--ink); word-break: break-word; }
.acct__profile > span { font-size: var(--t-xs); color: var(--faint); word-break: break-all; }
.acct__nav { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: #fff; }
.acct__nav-item { display: flex; align-items: center; gap: 11px; padding: 13px 16px; font-family: var(--f-head); font-weight: 600; font-size: 0.9rem; color: var(--ink-2); border-bottom: 1px solid var(--line); transition: background .12s var(--ease), color .12s var(--ease); }
.acct__nav-item:last-child { border-bottom: none; }
.acct__nav-item svg { color: var(--faint); flex-shrink: 0; transition: color .12s var(--ease); }
.acct__nav-item:hover { background: var(--paper); }
.acct__nav-item.is-active { color: var(--brand-ink); background: var(--brand-wash); }
.acct__nav-item.is-active svg { color: var(--brand-ink); }
.acct__nav-item--out { color: var(--faint); }
.acct__nav-item--out:hover { color: var(--sale); }

.acct__panel { min-width: 0; }
.acct__panel h2 { font-family: var(--f-display); font-weight: 600; font-size: 1.5rem; color: var(--ink); margin-bottom: 6px; }
.acct__lede { color: var(--muted); margin-bottom: 0; }
.acct__stats { margin-top: 24px; margin-bottom: 34px; }
.acct__panel-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 14px; }
.acct__panel-head h3 { font-family: var(--f-head); font-weight: 700; font-size: 1rem; color: var(--ink); margin: 0; }
.acct__viewall { display: inline-flex; align-items: center; gap: 4px; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--brand-ink); }
.acct__viewall:hover { text-decoration: underline; }

.acct-orders { display: flex; flex-direction: column; gap: 10px; }
.acct-order { border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: #fff; }
.acct-order.is-open { border-color: var(--line-2); }
.acct-order__row { display: grid; grid-template-columns: 90px 1fr auto 90px 20px; align-items: center; gap: 14px; width: 100%; padding: 14px 16px; text-align: left; }
.acct-order__row:hover { background: var(--paper); }
.acct-order__id { color: var(--ink); font-weight: 600; }
.acct-order__date { color: var(--muted); font-size: var(--t-sm); }
.acct-order__total { color: var(--ink); font-weight: 700; text-align: right; }
.acct-order__chev { color: var(--faint); transition: transform .16s var(--ease); justify-self: end; }
.acct-order.is-open .acct-order__chev { transform: rotate(180deg); }
.acct-order__detail { padding: 4px 16px 18px; border-top: 1px solid var(--line); }
.acct-order__items { display: flex; flex-direction: column; gap: 10px; margin: 14px 0; }
.acct-order__items li { display: flex; align-items: center; gap: 12px; }
.acct-order__items img { border: 1px solid var(--line); border-radius: 6px; object-fit: contain; background: var(--panel); flex-shrink: 0; }
.acct-order__item-name { flex: 1; min-width: 0; font-size: 0.9rem; color: var(--ink-2); font-weight: 500; }
.acct-order__item-name:hover { color: var(--brand-ink); text-decoration: underline; }
.acct-order__item-qty { color: var(--faint); }
@media (max-width: 640px){ .acct-order__row { grid-template-columns: auto 1fr auto 16px; grid-template-areas: "id date . chev" "status status total total"; row-gap: 8px; } .acct-order__date { grid-area: date; } .acct-order__id { grid-area: id; } .acct-order__chev { grid-area: chev; } }

.acct__form { max-width: 420px; }
.acct__form-actions { display: flex; align-items: center; gap: 12px; }
.acct__saved { display: inline-flex; align-items: center; gap: 5px; color: var(--stock); font-weight: 600; font-size: var(--t-sm); }
/* The nav used to wrap: six destinations across two ragged lines, each item
   stretched to a different width. One horizontally scrollable strip keeps every
   item on a single line at its natural width and reads as tabs, which is what
   it is. */
@media (max-width: 860px) {
  .acct { grid-template-columns: 1fr; gap: 22px; }
  .acct__side { position: static; }
  .acct__nav {
    flex-direction: row; flex-wrap: nowrap;
    overflow-x: auto; -webkit-overflow-scrolling: touch;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  .acct__nav::-webkit-scrollbar { display: none; }
  .acct__nav-item {
    flex: 0 0 auto; white-space: nowrap; justify-content: center;
    border-bottom: none; border-right: 1px solid var(--line);
  }
  .acct__nav-item:last-child { border-right: none; }
}

@media (max-width: 640px) {
  .acct { padding-block: 4px 40px; }
  /* Three tiles at 2rem across a phone leaves ~105px each, so the figure and
     its label both truncate. Two up, one wide, with a smaller figure. */
  .page-stats { grid-template-columns: repeat(2, 1fr); gap: 10px; margin: 20px 0; }
  .page-stats > div { padding: 14px 10px; }
  .page-stats b { font-size: 1.45rem; }
  .page-stats span { font-size: 0.76rem; line-height: 1.3; }
  .page-stats > div:last-child:nth-child(odd) { grid-column: 1 / -1; }

  /* the panels ran together with nothing between them — give each a rule */
  .acct__panel + .acct__panel { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); }
  .acct__panel h2 { font-size: 1.22rem; }
  .acct__panel h3 { font-size: 1.02rem; }
  .acct__profile { padding: 18px 14px; }
  .acct__nav-item { padding: 11px 14px; font-size: 0.84rem; }
  .mts-address-grid { grid-template-columns: 1fr; }
  .acct__form { max-width: none; }
  .acct__form > div { flex-wrap: wrap; row-gap: 2px; }
}

/* ================= collection.css ================= */
/* ===== Collection / shop: banner + rail + grid ===== */
.col__crumbs { padding-top: 4px; }
.col__layout { display: grid; grid-template-columns: 256px 1fr; gap: 32px; align-items: start; padding-top: 34px; padding-bottom: 64px; }
/* Sticky: on sparse categories the sidebar (category rail + filters) is naturally
   taller than a 1–2 product grid. A plain static sidebar would leave a tall dead
   gap below the grid before the next section starts — sticking it keeps the
   (still useful) filters in view while scrolling instead of leaving blank space.
   No max-height/overflow cap — that previously clipped legitimate filter options
   (colour swatches, sizes) on categories with lots of them. Sticky elements taller
   than the viewport release gracefully on their own once their bottom is reached,
   so no explicit cap is needed. */
.col__side { display: flex; flex-direction: column; gap: 16px; position: sticky; top: 143px; align-self: start; }
@media (max-width: 900px){ .col__side { position: static; } }

/* filter panel (price + colour) */
.filt-card { border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: #fff; }
.filt-card__head { display: flex; align-items: center; gap: 8px; background: var(--ink); color: #fff; font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--t-xs); padding: 12px 16px; }
.filt-card__head svg { color: var(--brand); }
.filt { padding: 15px 16px; border-bottom: 1px solid var(--line); }
.filt__title { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--t-xs); color: var(--faint); margin-bottom: 11px; }
.filt__radio, .filt__check { display: flex; align-items: center; gap: 9px; padding: 5px 0; font-size: 0.9rem; color: var(--ink-2); cursor: pointer; transition: color .12s var(--ease); }
.filt__radio input, .filt__check input { accent-color: var(--brand); width: 15px; height: 15px; flex-shrink: 0; }
.filt__radio:hover, .filt__check:hover { color: var(--brand-ink); }
.filt__cats { display: flex; flex-direction: column; max-height: 240px; overflow-y: auto; padding-right: 4px; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
.filt__cats .filt__check span { font-size: 0.88rem; }
.filt__colours { display: flex; flex-wrap: wrap; gap: 7px; }
.filt__colour { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px 5px 7px; border: 1px solid var(--line-2); border-radius: var(--r-pill); font-size: var(--t-xs); font-weight: 500; color: var(--ink-2); background: #fff; transition: border-color .14s var(--ease), color .14s var(--ease), background .14s var(--ease); }
.filt__colour:hover { border-color: var(--ink); }
.filt__colour.is-on { border-color: var(--brand); color: var(--brand-ink); background: var(--brand-wash); }
.filt__colour-dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(0,0,0,.15); flex-shrink: 0; }
.filt__select { position: relative; display: flex; align-items: center; }
.filt__select select { width: 100%; appearance: none; border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 10px 34px 10px 13px; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--ink-2); background: var(--panel); cursor: pointer; }
.filt__select select:hover { background: #fff; }
.filt__select select:focus { outline: none; border-color: var(--ink); background: #fff; }
.filt__select svg { position: absolute; right: 11px; pointer-events: none; color: var(--muted); }
.filt__clear { display: block; width: 100%; padding: 12px; background: var(--paper); font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--brand-ink); border-top: 1px solid var(--line); transition: background .14s var(--ease); }
.filt__clear:hover { background: var(--brand-wash); }

/* collection banner — clean, visual hero: title + trust row only (SEO copy now lives on-page below) */
.colban { position: relative; overflow: hidden; display: flex; align-items: center;
  background-color: var(--ink);
  background-image: radial-gradient(120% 140% at 50% -10%, #2c2c2c 0%, var(--ink) 58%, #141414 100%); }
.colban--img { background-size: cover; background-position: center; background-repeat: no-repeat; }
.colban__scrim { position: absolute; inset: 0; z-index: 1; background: radial-gradient(120% 130% at 50% 42%, rgba(11,9,7,.66) 0%, rgba(11,9,7,.8) 55%, rgba(11,9,7,.9) 100%); }
.colban__inner { position: relative; z-index: 3; padding-block: 68px; color: #fff; text-align: center; max-width: 840px; margin: 0 auto; }
.colban__inner .crumbs { padding: 0 0 16px; }
.colban__inner .crumbs ol { justify-content: center; }
.colban__inner .crumbs li { color: rgba(255,255,255,.6); }
.colban__inner .crumbs a { color: rgba(255,255,255,.82); }
.colban__inner .crumbs a:hover { color: #fff; }
.colban__inner .crumbs [aria-current="page"] { color: #fff; }
.colban__inner .crumbs__sep { color: rgba(255,255,255,.35); }
.colban__inner .eyebrow--onink { margin-bottom: 14px; }
.colban__title { font-family: var(--f-display); font-weight: 700; font-size: clamp(2.1rem, 4.2vw, 3.4rem); letter-spacing: -0.02em; color: #fff; line-height: 1.05; }
.colban__desc { margin-top: 16px; color: rgba(255,255,255,.86); font-size: var(--t-sm); line-height: 1.65; max-width: 62ch; margin-inline: auto; }
.colban__count { display: inline-block; margin-top: 24px; font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--t-xs); color: #fff; border: 1px solid rgba(255,255,255,.28); border-radius: var(--r-pill); padding: 6px 16px; }

/* category rail */
.rail { border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; background: #fff; }
.rail__head { display: flex; align-items: center; gap: 8px; background: var(--ink); color: #fff; font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; font-size: var(--t-xs); padding: 12px 16px; }
.rail__head svg { color: var(--brand); }
.rail__search { position: relative; display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--line); transition: box-shadow .16s var(--ease); }
.rail__search:focus-within { box-shadow: inset 0 -2px 0 var(--brand); }
.rail__search > svg { color: var(--faint); flex-shrink: 0; }
.rail__search input { flex: 1; min-width: 0; border: none; background: none; font-family: var(--f-body); font-size: 0.9rem; color: var(--ink); padding: 3px 0; }
.rail__search input:focus { outline: none; }
.rail__search input::placeholder { color: var(--faint); }
.rail__search-clear { width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; background: var(--paper); color: var(--muted); flex-shrink: 0; transition: background .14s var(--ease), color .14s var(--ease); }
.rail__search-clear:hover { background: var(--line); color: var(--ink); }
.rail__none { padding: 18px 16px; font-size: var(--t-sm); color: var(--muted); }
.rail__list { padding-bottom: 6px; max-height: 236px; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
.rail__list::-webkit-scrollbar { width: 8px; }
.rail__list::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 100px; border: 2px solid #fff; }
.rail__list::-webkit-scrollbar-track { background: transparent; }
.rail__sect-label { position: sticky; top: 0; z-index: 1; background: #fff; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.66rem; color: var(--faint); padding: 11px 16px 6px; border-bottom: 1px solid var(--line); }
.rail__link { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 8px 16px; font-size: 0.9rem; color: var(--ink-2); border-left: 3px solid transparent; transition: background .14s var(--ease), color .14s var(--ease); }
.rail__link:hover { background: var(--paper); color: var(--brand-ink); }
.rail__link b { font-size: var(--t-xs); color: var(--faint); font-weight: 600; }
.rail__link.is-active { border-left-color: var(--brand); background: var(--brand-wash); color: var(--brand-ink); font-weight: 600; }
.rail__link.is-active b { color: var(--brand-ink); }
.rail__all { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 13px; background: var(--paper); font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--brand-ink); border-top: 1px solid var(--line); }
.rail__all:hover { background: var(--brand-wash); }

/* main */
.col__head { margin-bottom: 20px; text-align: center; }
.col__title { font-family: var(--f-head); font-weight: 700; font-size: clamp(1.75rem, 3.2vw, 2.5rem); letter-spacing: -0.015em; color: var(--ink); }
.col__desc { color: var(--muted); max-width: 70ch; margin: 10px auto 0; font-size: var(--t-sm); }

.col__toolbar { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 13px 18px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 1px 2px rgba(20,15,10,.05); margin-bottom: 24px; flex-wrap: wrap; }
.col__count { font-family: var(--f-head); font-weight: 700; color: var(--ink-2); text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-sm); }
.col__tools { display: flex; align-items: center; gap: 16px; }
.col__stock { display: inline-flex; align-items: center; gap: 8px; font-size: var(--t-sm); color: var(--ink-2); font-weight: 500; cursor: pointer; }
.col__stock input { width: 16px; height: 16px; accent-color: var(--brand-cta); }
.col__sort { display: inline-flex; align-items: center; gap: 8px; position: relative; }
.col__sort > span { font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--faint); }
.col__sort select { appearance: none; border: 1.5px solid var(--line-2); border-radius: 8px; padding: 9px 34px 9px 13px; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); background: var(--panel); cursor: pointer; }
.col__sort select:hover { background: #fff; }
.col__sort select:focus { outline: none; border-color: var(--ink); background: #fff; }
.col__sort svg { position: absolute; right: 11px; pointer-events: none; color: var(--muted); }
@media (max-width: 520px){ .col__toolbar { padding: 12px; } .col__tools { width: 100%; justify-content: space-between; gap: 10px; } }

/* roomy cards inside the narrower rail layout */
.col__grid { grid-template-columns: repeat(3, 1fr); }
@media (max-width: 1240px){ .col__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 900px){ .col__grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 720px){ .col__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 460px){ .col__grid { grid-template-columns: 1fr; } }

@media (max-width: 900px){
  .col__layout { grid-template-columns: 1fr; }
  .rail { display: none; }
}

/* category SEO content — the original store's full below-grid copy, rendered in original
   order as generic blocks so nothing gets silently dropped or restructured. Content is
   untouched here; only the presentation is elevated (card frame, type hierarchy,
   feature-card item lists, refined FAQ + closing band). */
.catseo { border-top: 1px solid var(--line); background: var(--paper); }
.catseo__main { max-width: 920px; margin: 0 auto; }
.catseo__card { background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: var(--sh-sm); padding: clamp(28px, 4.5vw, 56px); color: var(--ink-2); line-height: 1.75; font-size: var(--t-sm); }

.catseo__heading { display: flex; align-items: center; gap: 12px; font-family: var(--f-display); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.012em; color: var(--ink); margin: 40px 0 16px; }
.catseo__heading::before { content: ''; display: inline-block; width: 26px; height: 3px; border-radius: 2px; background: var(--brand); flex-shrink: 0; }
.catseo__heading:first-child { margin-top: 0; }
.catseo__main > .catseo__card > p { max-width: 68ch; margin-bottom: 15px; }

/* intro — the original banner copy, now a distinct lead-in card instead of overlaid on the hero image */
.catseo__intro { margin-bottom: 8px; padding: 24px 28px; background: var(--brand-wash); border-left: 3px solid var(--brand); border-radius: 4px var(--r-lg) var(--r-lg) 4px; }
.catseo__intro-eyebrow { display: block; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--t-xs); color: var(--brand-ink); margin-bottom: 12px; }
.catseo__intro p { font-family: var(--f-display); font-weight: 500; font-size: 1.18rem; line-height: 1.55; color: var(--ink); margin-bottom: 0; max-width: none; }
.catseo__intro p + p { margin-top: 10px; }

/* titled item lists (product breakdowns, why-choose perks) — presented as a feature-card grid */
.catseo__items { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin: 8px 0 28px; }
.catseo__items li { display: flex; flex-direction: column; align-items: flex-start; gap: 11px; padding: 20px; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--paper); transition: border-color .16s var(--ease), box-shadow .16s var(--ease), transform .16s var(--ease); }
.catseo__items li:hover { border-color: var(--line-2); box-shadow: var(--sh-sm); transform: translateY(-2px); background: #fff; }
.catseo__items svg { width: 30px; height: 30px; padding: 7px; box-sizing: border-box; border-radius: 50%; background: var(--brand-cta); color: #fff; flex-shrink: 0; }
.catseo__items span { display: block; font-size: 0.92rem; line-height: 1.6; }
.catseo__items b { display: block; font-family: var(--f-head); font-weight: 700; font-size: 0.98rem; color: var(--ink); margin-bottom: 4px; }

/* plain bullet lists — compact two-column checklist */
.catseo__list { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 11px 22px; margin: 8px 0 26px; }
.catseo__list li { display: flex; align-items: flex-start; gap: 9px; font-size: 0.92rem; line-height: 1.6; }
.catseo__list svg { color: var(--stock); flex-shrink: 0; margin-top: 3px; }
@media (max-width: 640px){ .catseo__list { grid-template-columns: 1fr; } }

.catseo__faqs { margin-top: 36px; padding-top: 32px; border-top: 1px solid var(--line); }
/* The FAQ block now opens with a real h2, sized to match .catseo__heading so it
   reads as a peer of the other section headings in the copy card rather than a
   small label. .faq__qh only exists to put each question in the outline, so it
   resets the UA heading styles and lets .faq__q keep doing the visual work. */
.catseo__faqs-title { display: flex; align-items: center; gap: 12px; font-family: var(--f-display); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.012em; color: var(--ink); margin: 40px 0 16px; }
.catseo__faqs-title::before { content: ''; display: inline-block; width: 26px; height: 3px; border-radius: 2px; background: var(--brand); flex-shrink: 0; }
.faq__qh { margin: 0; padding: 0; font: inherit; font-weight: inherit; letter-spacing: inherit; color: inherit; }
.catseo__faqs-eyebrow { display: block; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--t-xs); color: var(--brand-ink); margin-bottom: 8px; }
.catseo__faqs h3 { font-family: var(--f-display); font-weight: 600; font-size: 1.4rem; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 18px; }

.catseo__close { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--line); text-align: center; }
.catseo__close p { font-family: var(--f-display); font-weight: 500; font-size: 1.15rem; color: var(--ink); margin-bottom: 18px; }
.catseo__contact { display: inline-flex; }

/* ================= product.css ================= */
/* ===== Product page ===== */
.pdp__crumbs { padding-top: 4px; }
.pdp__top { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 54px; padding-bottom: 56px; align-items: start; }

/* gallery — vertical thumb rail + large image, plus a short key-specs strip
   underneath so the column has something useful to hold rather than trailing
   into blank space next to the (usually taller) buy column. */
.pdp-gallery { align-self: start; display: flex; flex-direction: column; gap: 20px; }
.pdp-gallery__row { display: flex; gap: 14px; }
.pdp-gallery__specs { display: flex; flex-direction: column; gap: 10px; padding: 18px 20px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); }
.pdp-gallery__specs li { display: flex; align-items: flex-start; gap: 10px; color: var(--ink-2); font-size: 0.9rem; line-height: 1.5; min-width: 0; }
.pdp-gallery__specs li span { min-width: 0; }
.pdp-gallery__specs svg { color: var(--stock); flex-shrink: 0; margin-top: 3px; }
.pdp-gallery__thumbs { display: flex; flex-direction: column; gap: 10px; width: 74px; flex-shrink: 0; }
.pdp-gallery__thumb { width: 74px; height: 74px; border: 1.5px solid var(--line); border-radius: var(--r); background: #fff; padding: 7px; overflow: hidden; transition: border-color .14s var(--ease); }
.pdp-gallery__thumb img { width: 100%; height: 100%; object-fit: contain; }
.pdp-gallery__thumb:hover { border-color: var(--line-2); }
.pdp-gallery__thumb.is-active { border-color: var(--brand); box-shadow: 0 0 0 1px var(--brand); }
.pdp-gallery__main { flex: 1; width: 100%; padding: 0; appearance: none; position: relative; border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; aspect-ratio: 1/1; display: grid; place-items: center; overflow: hidden; box-shadow: var(--sh-sm); cursor: zoom-in; }
.pdp-gallery__main img { width: 100%; height: 100%; object-fit: contain; padding: 44px; transition: transform .45s var(--ease); }
.pdp-gallery__main:hover img { transform: scale(1.16); }
.pdp-gallery__badges { position: absolute; top: 14px; left: 14px; z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.pdp-gallery__zoom { position: absolute; bottom: 12px; right: 12px; width: 36px; height: 36px; display: grid; place-items: center; background: rgba(255,255,255,.94); border: 1px solid var(--line); border-radius: var(--r); color: var(--ink-2); opacity: 0; transform: translateY(4px); transition: opacity .16s var(--ease), transform .16s var(--ease), background .16s var(--ease), color .16s var(--ease); }
.pdp-gallery__main:hover .pdp-gallery__zoom, .pdp-gallery__main:focus-visible .pdp-gallery__zoom { opacity: 1; transform: translateY(0); }
.pdp-gallery__main:hover .pdp-gallery__zoom { background: var(--brand-cta); color: #fff; border-color: var(--brand-cta); }

/* buy column — open, airy layout */
.pdp-buy { display: flex; flex-direction: column; }
.pdp-buy__cat { align-self: flex-start; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--t-xs); color: var(--brand-ink); margin-bottom: 10px; }
.pdp-buy__cat:hover { text-decoration: underline; }
.pdp-buy__title { font-family: var(--f-head); font-weight: 700; font-size: clamp(1.5rem, 2.5vw, 2.05rem); line-height: 1.15; letter-spacing: -0.015em; color: var(--ink); margin-bottom: 14px; }
.pdp-buy__rating { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
.pdp-buy__ratebtn { background: none; display: inline-flex; }
.pdp-buy__ratebtn:hover { opacity: .85; }
.pdp-buy__revlink { font-size: var(--t-sm); color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
.pdp-buy__revlink:hover { color: var(--brand-ink); }

/* Brand + SKU — highlighted identity chips, sat right under the rating row */
.pdp-buy__idline { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
.pdp-buy__idchip { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; background: var(--brand-wash); border: 1px solid var(--brand-wash-2); border-radius: 7px; font-size: var(--t-sm); color: var(--ink-2); }
.pdp-buy__idchip b { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--brand-ink); margin-right: 1px; }

.pdp-buy__pricerow { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.pdp-buy__price { font-family: var(--f-display); font-weight: 700; font-size: clamp(1.9rem, 3.2vw, 2.4rem); color: var(--ink); line-height: 1; }
.pdp-buy__from { font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-sm); color: var(--faint); }
.pdp-buy__gst { font-size: var(--t-xs); color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; background: var(--panel); border: 1px solid var(--line); border-radius: 5px; padding: 3px 8px; align-self: center; }
.pdp-buy__quote { margin-top: 18px; padding: 13px 16px; background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--brand); border-radius: 0 var(--r) var(--r) 0; }
.pdp-buy__quote p { font-size: var(--t-sm); color: var(--ink-2); line-height: 1.55; margin: 8px 0; font-style: italic; }
.pdp-buy__quote cite { display: inline-flex; align-items: center; gap: 9px; font-style: normal; font-size: var(--t-xs); font-weight: 600; color: var(--muted); }
.pdp-buy__quote-verified { display: inline-flex; align-items: center; gap: 3px; color: var(--stock); }
@media (min-width: 921px){ .pdp-gallery { position: sticky; top: 118px; align-self: start; } }
.pdp-buy__saved-tag { font-family: var(--f-head); font-weight: 700; font-size: var(--t-xs); color: #fff; background: var(--stock); border-radius: var(--r-pill); padding: 3px 11px; }
.pdp-buy__tax { font-size: var(--t-sm); color: var(--faint); margin-top: 8px; }
.pdp-buy__blurb { font-size: var(--t-body); color: var(--muted); line-height: 1.65; margin-top: 16px; max-width: 54ch; }

/* buy card — options, volume pricing, stock and actions grouped into one cohesive premium panel */
.pdp-buybox { margin-top: 26px; padding: 24px 24px 26px; border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; box-shadow: var(--sh-sm); }

/* section separators — hairline, airy */
.pdp-buy__section { margin-top: 26px; padding-top: 26px; border-top: 1px solid var(--line); }
.pdp-buybox > .pdp-buy__section:first-child { margin-top: 0; padding-top: 0; border-top: none; }

/* options */
.pdp-opt { margin-bottom: 20px; }
.pdp-opt:last-child { margin-bottom: 0; }
.pdp-opt__label { display: flex; align-items: baseline; gap: 8px; margin-bottom: 10px; }
.pdp-opt__label > span { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--t-xs); color: var(--faint); }
.pdp-opt__label b { font-family: var(--f-head); color: var(--ink); font-weight: 600; font-size: var(--t-sm); }
.pdp-opt__select { position: relative; display: inline-flex; align-items: center; max-width: 340px; width: 100%; }
.pdp-opt__select select { appearance: none; width: 100%; border: 1.5px solid var(--line-2); border-radius: 8px; padding: 12px 40px 12px 14px; font-family: var(--f-head); font-weight: 600; font-size: 0.95rem; background: #fff; cursor: pointer; }
.pdp-opt__select select:focus { outline: none; border-color: var(--ink); }
.pdp-opt__select svg { position: absolute; right: 12px; pointer-events: none; color: var(--muted); }
.pdp-opt__swatches { display: flex; flex-wrap: wrap; gap: 10px; }
.pdp-swatch { width: 42px; height: 42px; border-radius: 8px; border: 1.5px solid var(--line-2); display: grid; place-items: center; padding: 3px; transition: border-color .14s var(--ease), box-shadow .14s var(--ease); }
.pdp-swatch:hover { border-color: var(--ink); }
.pdp-swatch.is-active { border-color: var(--brand); box-shadow: 0 0 0 2px var(--brand-wash); }
.pdp-swatch__dot { width: 100%; height: 100%; border-radius: 5px; border: 1px solid rgba(0,0,0,.12); }
.pdp-swatch__txt { font-family: var(--f-head); font-weight: 600; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--ink-2); padding: 0 8px; }
.pdp-swatch:has(.pdp-swatch__txt) { width: auto; min-width: 48px; }

/* volume tiers — refined cards */
.pdp-vol__head { display: flex; align-items: center; gap: 7px; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--brand-ink); margin-bottom: 12px; }
.pdp-vol__head svg { color: var(--brand); }
.pdp-vol__head span { color: var(--faint); font-weight: 500; text-transform: none; letter-spacing: 0; }
.pdp-vol__row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
.pdp-vtier { display: flex; flex-direction: column; align-items: center; gap: 3px; padding: 13px 6px; border: 1.5px solid var(--line); border-radius: 10px; background: #fff; transition: border-color .14s var(--ease), background .14s var(--ease); }
.pdp-vtier:hover { border-color: var(--line-2); background: var(--panel); }
.pdp-vtier.is-active { border-color: var(--brand); background: var(--brand-wash); }
.pdp-vtier__lbl { font-size: 0.68rem; color: var(--faint); text-transform: uppercase; letter-spacing: 0.02em; font-weight: 600; }
.pdp-vtier b { font-family: var(--f-head); font-weight: 700; font-size: 1.05rem; color: var(--ink); }
.pdp-vtier.is-active b { color: var(--brand-ink); }
.pdp-vtier__off { font-family: var(--f-head); font-weight: 700; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--stock); }
.pdp-vtier__off--muted { color: var(--faint); }

/* purchase */
.pdp-buy__stock { margin-bottom: 14px; }
.pdp-buy__instock { display: inline-flex; align-items: center; gap: 9px; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--stock); }
.pdp-buy__dot { width: 8px; height: 8px; border-radius: 50%; background: var(--stock); box-shadow: 0 0 0 3px color-mix(in srgb, var(--stock) 18%, #fff); }
.pdp-buy__oos { font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--faint); }
.pdp-buy__actions { display: flex; align-items: stretch; gap: 10px; margin-bottom: 10px; }
.pdp-buy__actions .qty { border-radius: 10px; }
.pdp-buy__actions .qty button { width: 46px; }
.pdp-buy__add { flex: 1; border-radius: 10px; transition: background .16s var(--ease), color .16s var(--ease); }
.pdp-buy__add:disabled { opacity: .5; cursor: not-allowed; }
.pdp-buy__add.is-added { background: var(--stock) !important; }
.pdp-buy__wish { width: 54px; border: 1.5px solid var(--line-2); border-radius: 10px; display: grid; place-items: center; color: var(--faint); transition: color .14s var(--ease), border-color .14s var(--ease); }
.pdp-buy__wish:hover { color: var(--brand-ink); border-color: var(--ink); }
.pdp-buy__wish.is-on { color: var(--brand); border-color: var(--brand); }
.pdp-buy__wish.is-on svg { fill: var(--brand); }
.pdp-buy__buynow { border-radius: 10px; }
.pdp-buy__buynow:disabled { opacity: .5; cursor: not-allowed; }
.pdp-buy__added { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; background: color-mix(in srgb, var(--stock) 9%, #fff); border: 1px solid color-mix(in srgb, var(--stock) 34%, #fff); color: var(--stock); border-radius: 10px; padding: 11px 14px; font-weight: 600; font-size: var(--t-sm); margin-top: 12px; }
.pdp-buy__added a { color: var(--brand-ink); text-decoration: underline; }

/* quiet line total at the commit point */
.pdp-buy__linetotal { margin: 12px 0 14px; font-size: var(--t-sm); color: var(--muted); }
.pdp-buy__linetotal b { font-family: var(--f-display); font-weight: 700; color: var(--ink); font-size: 1.06rem; }
.pdp-buy__linetotal-save { color: var(--stock); font-weight: 700; }

/* one calm trust band — replaces the reassure + pay + meta stacking */
.pdp-trust { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 15px; }
.pdp-trust__row { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px 18px; }
.pdp-trust__row li { display: inline-flex; align-items: center; gap: 9px; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--ink-2); }
.pdp-trust__row svg { color: var(--brand); flex-shrink: 0; }
.pdp-trust__pay { display: flex; align-items: center; gap: 12px; }
.pdp-trust__pay-label { font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--t-xs); color: var(--faint); }
.pdp-buy__pay-marks { display: flex; gap: 6px; flex-wrap: wrap; }
.pdp-buy__pay-marks img { height: 20px; border: 1px solid var(--line); border-radius: 3px; padding: 1px 3px; background: #fff; }
.pdp-buy__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 24px; margin-top: 2px; padding-top: 14px; border-top: 1px solid var(--line); font-size: var(--t-sm); color: var(--muted); }
.pdp-buy__meta a { display: inline-flex; align-items: center; gap: 2px; color: var(--brand-ink); font-weight: 600; }
.pdp-buy__meta a svg { color: var(--brand-ink); opacity: .7; }
.pdp-buy__meta a:hover { text-decoration: underline; }
@media (max-width: 420px){ .pdp-trust__row { grid-template-columns: 1fr; } }
.pdp-buy__meta a:hover { text-decoration: underline; }

/* details — tabbed */
.pdp__tabs { padding-block: 46px 24px; border-top: 1px solid var(--line); scroll-margin-top: 140px; }
.pdp-tabnav { display: flex; flex-wrap: wrap; justify-content: center; gap: 2px; border-bottom: 1px solid var(--line); margin-bottom: 30px; }
.pdp-tabnav__btn { position: relative; padding: 13px 24px; font-family: var(--f-head); font-weight: 700; font-size: 0.98rem; letter-spacing: 0.01em; color: var(--muted); transition: color .16s var(--ease); }
.pdp-tabnav__btn::after { content: ""; position: absolute; left: 16px; right: 16px; bottom: -1px; height: 3px; background: var(--brand); transform: scaleX(0); transition: transform .18s var(--ease); }
.pdp-tabnav__btn:hover { color: var(--ink); }
.pdp-tabnav__btn.is-active { color: var(--ink); }
.pdp-tabnav__btn.is-active::after { transform: scaleX(1); }
.pdp-tabpanel { max-width: 860px; margin: 0 auto; }

/* image lightbox */
.pdp-lightbox { position: fixed; inset: 0; z-index: 200; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; padding: clamp(16px, 4vw, 48px); background: rgba(16, 12, 10, 0.86); backdrop-filter: blur(4px); animation: pdp-lb-in .18s var(--ease); }
@keyframes pdp-lb-in { from { opacity: 0; } to { opacity: 1; } }
.pdp-lightbox__stage { grid-column: 2; display: flex; flex-direction: column; align-items: center; gap: 14px; max-height: 100%; }
.pdp-lightbox__stage img { max-width: 100%; max-height: 82vh; object-fit: contain; background: #fff; border-radius: var(--r-lg); padding: clamp(20px, 4vw, 52px); box-shadow: 0 30px 80px rgba(0,0,0,.5); }
.pdp-lightbox__stage figcaption { color: rgba(255,255,255,.8); font-size: var(--t-sm); letter-spacing: .04em; }
.pdp-lightbox__close { position: absolute; top: clamp(14px, 3vw, 26px); right: clamp(14px, 3vw, 26px); width: 46px; height: 46px; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.12); color: #fff; transition: background .16s var(--ease); }
.pdp-lightbox__close:hover { background: rgba(255,255,255,.24); }
.pdp-lightbox__nav { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 50%; background: rgba(255,255,255,.12); color: #fff; transition: background .16s var(--ease); }
.pdp-lightbox__nav:hover { background: rgba(255,255,255,.26); }
.pdp-lightbox__nav--prev { grid-column: 1; transform: scaleX(-1); }
.pdp-lightbox__nav--next { grid-column: 3; }
@media (max-width: 620px){ .pdp-lightbox__nav { width: 44px; height: 44px; } .pdp-lightbox__stage img { max-height: 74vh; } }

.pdp-desc p { color: var(--ink-2); margin-bottom: 15px; line-height: 1.7; }
.pdp-desc h3 { font-size: 1.2rem; margin: 26px 0 12px; }
.pdp-desc h3:first-child { margin-top: 0; }
.pdp-desc__features { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 26px; margin: 6px 0 22px; }
.pdp-desc__features li { display: flex; align-items: flex-start; gap: 10px; color: var(--ink-2); font-size: 0.97rem; min-width: 0; }
.pdp-desc__features li span { min-width: 0; }
.pdp-desc__features svg { color: var(--stock); flex-shrink: 0; margin-top: 3px; }
.pdp-desc__img { border: 1px solid var(--line); border-radius: var(--r-lg); margin: 8px 0 20px; max-width: 100%; }
.pdp-desc__table-wrap { overflow-x: auto; margin-bottom: 20px; }
@media (max-width: 620px){ .pdp-desc__features { grid-template-columns: 1fr; } }

/* specs tab */
.pdp-specgrid { max-width: 720px; margin: 0 auto; }
.pdp-specgrid .spec-table th { width: 40%; }
.pdp-specgrid__ind { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line); }
.pdp-specgrid__ind h4 { font-family: var(--f-head); text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--t-xs); color: var(--faint); margin-bottom: 12px; }
.pdp-specbox__chips { display: flex; flex-wrap: wrap; gap: 7px; }
.pdp-specbox__chips a { font-size: var(--t-xs); font-family: var(--f-head); font-weight: 600; padding: 5px 11px; border: 1px solid var(--line-2); border-radius: var(--r); color: var(--ink-2); background: #fff; }
.pdp-specbox__chips a:hover { border-color: var(--brand); color: var(--brand-ink); }

/* reviews tab */
.pdp-rev__head { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 28px; }
.pdp-rev__summary { flex: 1 1 380px; display: grid; grid-template-columns: auto 1fr; gap: 34px; align-items: center; padding: 26px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); }
.pdp-rev__avg { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 6px; padding-right: 34px; border-right: 1px solid var(--line); }
.pdp-rev__avg b { font-family: var(--f-display); font-size: 3.4rem; line-height: 1; color: var(--ink); }
.pdp-rev__avg > span { font-size: var(--t-sm); color: var(--muted); }
.pdp-rev__bars { display: flex; flex-direction: column; gap: 7px; }
.pdp-rev__bar { display: flex; align-items: center; gap: 10px; font-size: var(--t-sm); color: var(--muted); }
.pdp-rev__bar > span:first-child { width: 28px; }
.pdp-rev__track { flex: 1; height: 8px; background: var(--line); border-radius: var(--r-pill); overflow: hidden; }
.pdp-rev__fill { height: 100%; background: var(--star); border-radius: var(--r-pill); }
.pdp-rev__n { width: 22px; text-align: right; }
.pdp-rev__list { display: flex; flex-direction: column; gap: 20px; }
.pdp-rev__item { border-bottom: 1px solid var(--line); padding-bottom: 20px; }
.pdp-rev__item:last-child { border-bottom: none; padding-bottom: 0; }
.pdp-rev__meta { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
.pdp-rev__who { display: inline-flex; align-items: center; gap: 9px; font-family: var(--f-head); font-weight: 600; color: var(--ink); }
.pdp-rev__ava { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; background: var(--brand-wash); color: var(--brand-ink); font-weight: 700; font-size: 0.8rem; }
.pdp-rev__verified { display: inline-flex; align-items: center; gap: 4px; font-size: var(--t-xs); font-weight: 600; color: var(--stock); }
.pdp-rev__date { font-size: var(--t-xs); color: var(--faint); }
.pdp-rev__item p { margin-top: 8px; color: var(--ink-2); line-height: 1.65; }
.pdp-rev__empty { flex: 1 1 380px; text-align: center; padding: 40px; color: var(--faint); display: flex; flex-direction: column; align-items: center; gap: 12px; background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); }
.pdp-rev__empty svg { color: var(--line-2); }
@media (max-width: 560px){ .pdp-rev__summary { grid-template-columns: 1fr; gap: 20px; } .pdp-rev__avg { border-right: none; border-bottom: 1px solid var(--line); padding: 0 0 18px; } }

/* write-a-review CTA + form — button lives in the summary header, not floating
   below it; the form card spans the full section width but its fields stay
   centered within it rather than hugging the left edge. */
.pdp-rev__write-btn { flex-shrink: 0; }
.pdp-rev__thanks { display: flex; align-items: center; justify-content: center; gap: 9px; background: color-mix(in srgb, var(--stock) 9%, #fff); border: 1px solid color-mix(in srgb, var(--stock) 34%, #fff); color: var(--stock); border-radius: var(--r-lg); padding: 13px 16px; font-weight: 600; font-size: var(--t-sm); margin-bottom: 28px; }
.pdp-rev__form { background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 32px; margin-bottom: 32px; text-align: center; }
.pdp-rev__form h4 { font-family: var(--f-display); font-weight: 600; font-size: 1.15rem; color: var(--ink); margin-bottom: 22px; }
.pdp-rev__form-row { margin-bottom: 18px; max-width: 460px; margin-inline: auto; }
.pdp-rev__form-row:last-of-type { margin-bottom: 0; }
.pdp-rev__form-row label { display: block; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: var(--t-xs); color: var(--faint); margin-bottom: 9px; }
.pdp-rev__form-row input, .pdp-rev__form-row textarea { width: 100%; border: 1.5px solid var(--line-2); border-radius: 8px; padding: 11px 13px; font-family: var(--f-body); font-size: 0.95rem; color: var(--ink); background: #fff; resize: vertical; text-align: left; transition: border-color .14s var(--ease); }
.pdp-rev__form-row input:focus, .pdp-rev__form-row textarea:focus { outline: none; border-color: var(--brand); }
.pdp-rev__pick { display: flex; justify-content: center; gap: 4px; }
.pdp-rev__pickstar { color: var(--line-2); padding: 2px; transition: color .12s var(--ease), transform .12s var(--ease); }
.pdp-rev__pickstar:hover { transform: scale(1.12); }
.pdp-rev__pickstar.is-on { color: var(--star); }
.pdp-rev__form-error { color: var(--sale); font-size: var(--t-sm); font-weight: 600; margin: 14px 0 0; }
.pdp-rev__form-actions { display: flex; justify-content: center; gap: 10px; margin-top: 24px; max-width: 460px; margin-inline: auto; }

.pdp-missing { text-align: center; padding: 80px 20px; display: flex; flex-direction: column; align-items: center; gap: 20px; }

@media (max-width: 920px){
  .pdp__top { grid-template-columns: minmax(0, 1fr); gap: 30px; }
  .pdp-gallery { width: 100%; min-width: 0; max-width: 100%; }
  .pdp-gallery__row { flex-direction: column-reverse; width: 100%; min-width: 0; }
  .pdp-gallery__main { min-width: 0; width: 100%; }
  .pdp-gallery__thumbs { min-width: 0; }
  .pdp-gallery__thumbs { flex-direction: row; width: 100%; max-width: 100%; overflow-x: auto; flex-wrap: nowrap; padding-bottom: 4px; }
  .pdp-gallery__thumb { flex-shrink: 0; }
}
@media (max-width: 460px){
  .pdp-buy__reassure { grid-template-columns: repeat(2, 1fr); gap: 16px 8px; }
  .pdp-vol__row { gap: 6px; }
  .pdp-vtier { padding: 11px 4px; }
}

/* ================= cart.css ================= */
/* ===== Cart ===== */
.cart__crumbs { padding-top: 4px; }
.cart__layout { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 32px; align-items: start; padding-bottom: 64px; }

.cart__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 14px; border-bottom: 2px solid var(--ink); margin-bottom: 18px; }
.cart__head h1 { font-family: var(--f-head); font-weight: 700; font-size: 2rem; letter-spacing: -0.015em; }
.cart__head h1 span { color: var(--faint); font-size: 1.1rem; }
.cart__clear { font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--faint); }
.cart__clear:hover { color: var(--sale); }

/* free-shipping progress — the single highest-converting cart nudge */
.cart-ship { padding: 16px 18px; margin-bottom: 20px; background: var(--brand-wash); border: 1px solid color-mix(in srgb, var(--brand) 30%, var(--line)); border-radius: var(--r-lg); }
.cart-ship__msg { display: flex; align-items: center; gap: 8px; font-size: var(--t-sm); color: var(--ink-2); margin-bottom: 10px; }
.cart-ship__msg svg { color: var(--brand-ink); flex-shrink: 0; }
.cart-ship__msg b { color: var(--brand-ink); font-weight: 700; }
.cart-ship__track { height: 7px; border-radius: 999px; background: #fff; overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
.cart-ship__fill { height: 100%; border-radius: 999px; background: linear-gradient(90deg, var(--brand) 0%, var(--brand-cta) 100%); transition: width .5s var(--ease); }
.cart-ship.is-done { background: color-mix(in srgb, var(--stock) 10%, #fff); border-color: color-mix(in srgb, var(--stock) 35%, var(--line)); }
.cart-ship.is-done .cart-ship__msg svg, .cart-ship.is-done .cart-ship__msg b { color: var(--stock); }
.cart-ship.is-done .cart-ship__fill { background: var(--stock); }

.cart__list { display: flex; flex-direction: column; gap: 12px; }
.cart-line { display: grid; grid-template-columns: 90px 1fr auto auto auto; gap: 16px; align-items: center; padding: 16px; border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; transition: box-shadow .16s var(--ease), border-color .16s var(--ease); }
.cart-line:hover { box-shadow: var(--sh-sm); border-color: var(--line-2); }
.cart-line__img { border: 1px solid var(--line); border-radius: var(--r); background: #fff; padding: 6px; }
.cart-line__img img { width: 100%; height: 100%; object-fit: contain; }
.cart-line__info { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.cart-line__name { font-family: var(--f-head); font-weight: 600; color: var(--ink); font-size: 1.02rem; line-height: 1.2; }
.cart-line__name:hover { color: var(--brand-ink); }
.cart-line__variant { font-size: var(--t-sm); color: var(--muted); }
.cart-line__sku { font-size: var(--t-xs); color: var(--faint); }
.cart-line__unit { font-size: var(--t-sm); color: var(--muted); margin-top: 2px; }
.cart-line__unit em { font-style: normal; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.04em; }
.cart-line__total { font-family: var(--f-display); font-size: 1.4rem; color: var(--ink); text-align: right; min-width: 80px; }
.cart-line__remove { color: var(--faint); padding: 6px; }
.cart-line__remove:hover { color: var(--sale); }
.cart__continue { display: inline-flex; align-items: center; gap: 6px; margin-top: 20px; font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-sm); color: var(--brand-ink); }
.cart__continue-icon { transform: rotate(180deg); }

/* cross-sell — the classic AOV lift, shown below the line items */
.cart-upsell { margin-top: 44px; padding-top: 28px; border-top: 1px solid var(--line); }
.cart-upsell h2 { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 1rem; color: var(--ink); margin-bottom: 16px; }
.cart-empty .cart-upsell { text-align: left; margin-top: 56px; max-width: 920px; }
/* the cart items column sits beside a 350px summary sidebar, so it's narrower than the
   grid-products--fit default was tuned for — shrink the card floor so 4 fit in one row */
.cart-upsell .grid-products--fit > * { min-width: 0; max-width: none; }
@media (max-width: 1100px){ .cart-upsell .grid-products--fit > * { width: calc(50% - 10px); } }
/* Two per row on a phone, not one.
   This rule used to force width:100%, and because `.cart-upsell .grid-products--fit > *`
   outranks the generic 2-up rule further down the sheet, it won — so the cart's
   bestsellers stacked one per screen while every other product grid in the
   store showed two. */
@media (max-width: 560px){ .cart-upsell .grid-products--fit > * { width: calc(50% - 7px); max-width: none; } }

/* summary */
.cart__summary { position: sticky; top: 138px; border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: var(--r-lg); padding: 24px; background: var(--panel); }
.cart__summary h2 { font-family: var(--f-head); text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.1rem; margin-bottom: 18px; }
/* The saving is the one number in the summary a shopper actively wants, so it
   gets the only colour in the block. Green rather than brand red: red reads as
   an error or a price rise next to a column of charges. */
/* The saving is the one number in the summary a shopper actively wants, so it
   is the only coloured thing in the block and sits on its own tinted ground.
   Green rather than brand red: red reads as an error or a price rise next to a
   column of charges. */
.cart__saved { background: #eaf5ee; border: 1px solid #cfe6d8; border-radius: var(--r); padding: 10px 12px !important; margin: 4px 0; }
.cart__saved dt, .cart__saved dd { color: #1d6b3d !important; font-weight: 700 !important; }
.cart__saved dd { font-variant-numeric: tabular-nums; font-size: 1.06rem; }
.cart__saved[hidden] { display: none !important; }

/* per-line badge — same green family so the eye links line saving to total */
/* A 999px radius only reads as a pill while the text stays on ONE line. As
   soon as it wrapped in the narrow mobile column the radius swallowed the box
   and it rendered as a circle, so this is a rounded rectangle that survives
   wrapping, with the amount pinned right. */
/* A small rectangle that hugs its text and never wraps.
   Two earlier attempts were wrong: a 999px radius turned into a circle the
   moment the text ran to a second line, and width:100% turned it into a slab
   across the whole row. It is a label, so it should be exactly as wide as the
   words and one line tall — the label ellipsises rather than wrapping if a
   narrow screen ever runs out of room. */
.cart-line__discount {
  display: inline-flex; align-items: center; gap: 5px;
  align-self: flex-start; width: auto; max-width: 100%;
  white-space: nowrap;
  background: #eaf5ee; color: #1d6b3d; border: 1px solid #cfe6d8;
  border-radius: var(--r); padding: 3px 8px; margin-top: 4px;
  font-size: 0.76rem; font-weight: 600; line-height: 1.3;
}
.cart-line__discount-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.cart-line__discount b { font-variant-numeric: tabular-nums; }
/* the nudge is information, not a reward — muted, no colour, no icon */
.cart-line__nudge {
  align-self: flex-start; margin-top: 3px;
  font-size: 0.78rem; color: var(--muted); font-weight: 500;
}
.cart__sum-rows { display: flex; flex-direction: column; gap: 12px; padding-bottom: 16px; border-bottom: 1px solid var(--line); }
.cart__sum-rows > div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.cart__sum-rows dt { color: var(--muted); font-size: var(--t-sm); }
.cart__sum-rows dt span { color: var(--faint); }
.cart__sum-rows dd { font-weight: 600; color: var(--ink-2); font-size: var(--t-sm); }
.cart__sum-note { color: var(--faint) !important; font-weight: 400 !important; font-size: var(--t-xs) !important; }
.cart__total { display: flex; align-items: baseline; justify-content: space-between; padding: 16px 0; }
.cart__total span { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
.cart__total b { font-family: var(--f-display); font-size: 2rem; color: var(--brand-ink); }
.cart__free-tag { font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--stock); }

/* ---- cart discount code ----
   Sits between the summary rows and the total. Shopify only applies manual
   codes at checkout, so the note under the field says so rather than implying
   the total above it is about to move. Input and button share one row and the
   input carries min-width:0 so a long code cannot widen the sticky summary. */
.cart__coupon { padding: 16px 0; border-bottom: 1px solid var(--line); }
.cart__coupon-lbl { display: block; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); color: var(--muted); margin-bottom: 8px; }
.cart__coupon-row { display: flex; gap: 8px; align-items: stretch; }
.cart__coupon-input { flex: 1 1 auto; min-width: 0; border: 1px solid var(--line-2); border-radius: var(--r); padding: 10px 12px; font: inherit; font-size: var(--t-sm); text-transform: uppercase; letter-spacing: 0.02em; background: #fff; color: var(--ink); }
.cart__coupon-input::placeholder { text-transform: none; letter-spacing: 0; color: var(--faint); }
.cart__coupon-input:focus-visible { outline: 2px solid var(--brand); outline-offset: 1px; border-color: var(--brand); }
.cart__coupon-btn { flex: 0 0 auto; padding-inline: 18px; white-space: nowrap; }
.cart__coupon-note { margin-top: 8px; font-size: var(--t-xs); color: var(--faint); line-height: 1.45; }
.cart__coupon-note.is-ok { color: #1d6b3d; font-weight: 600; }
.cart__coupon-note.is-err { color: var(--brand-ink); font-weight: 600; }
.cart__cutoff { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 12px; font-size: var(--t-xs); color: var(--muted); text-align: center; }
.cart__cutoff svg { color: var(--brand-ink); flex-shrink: 0; }
.cart__cutoff b { color: var(--ink-2); }
.cart__trust { display: flex; flex-direction: column; gap: 9px; margin: 18px 0; }
.cart__trust li { display: flex; align-items: center; gap: 9px; font-size: var(--t-sm); color: var(--muted); }
.cart__trust svg { color: var(--stock); flex-shrink: 0; }
.cart__pay { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; padding-top: 14px; border-top: 1px solid var(--line); }
.cart__pay img { height: 22px; background: #fff; border: 1px solid var(--line); border-radius: 3px; padding: 1px 3px; }
.cart__pay-badge { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; font-size: var(--t-xs); color: var(--faint); font-weight: 500; }
.cart__pay-badge svg { color: var(--stock); }

/* empty / done */
.cart-empty, .cart-done { text-align: center; padding: 70px 20px 90px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
.cart-empty__icon, .cart-done__tick { display: grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; background: var(--brand-wash); color: var(--brand-ink); }
.cart-done__tick { background: color-mix(in srgb, var(--stock) 12%, #fff); color: var(--stock); }
.cart-empty h1, .cart-done h1 { font-family: var(--f-head); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.2rem); letter-spacing: -0.015em; margin-top: 8px; }
.cart-empty p, .cart-done p { color: var(--muted); max-width: 52ch; }
.cart-done__cta { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 10px; }
.cart-done__steps { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; margin: 8px 0 4px; padding: 18px 24px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--r-lg); }
.cart-done__steps li { display: flex; align-items: center; gap: 10px; font-size: var(--t-sm); color: var(--ink-2); }
.cart-done__step-ic { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: color-mix(in srgb, var(--stock) 14%, #fff); color: var(--stock); flex-shrink: 0; }
.cart-done__optin { display: inline-flex; align-items: center; gap: 7px; font-size: var(--t-xs); color: var(--brand-ink); }
.cart-done__optin svg { flex-shrink: 0; }

@media (max-width: 860px){
  .cart__layout { grid-template-columns: 1fr; }
  .cart__summary { position: static; }
}
@media (max-width: 560px){
  /* The old layout gave row 1 three tracks — image, info, and the remove
     button — while row 2 put the line total in that same third track. The
     total is the widest thing in the card, so it set the track width and the
     info column collapsed to about 160px: the title wrapped to three lines and
     the saving badge had to truncate to "10% b...". Taking the × out of the
     flow lets info span the full remaining width. */
  .cart-line {
    position: relative;
    grid-template-columns: 72px minmax(0, 1fr) auto;
    grid-template-areas:
      "img  info info"
      "qty  qty  total";
    column-gap: 12px;
    row-gap: 14px;
    padding: 14px;
    align-items: start;
  }
  .cart-line__img { grid-area: img; align-self: start; }
  .cart-line__info { grid-area: info; min-width: 0; padding-right: 26px; gap: 4px; }
  .cart-line__qty { grid-area: qty; justify-self: start; }
  /* A four-figure line total is the widest thing on the row. Let it size to its
     own content and shrink the stepper instead, so "$5,887.25" is never clipped
     at the card edge. */
  .cart-line__total {
    grid-area: total; justify-self: end; align-self: center;
    font-size: 1.05rem; white-space: nowrap; min-width: max-content;
  }
  .cart-line__qty { min-width: 0; }
  .cart-line__qty .qty { transform-origin: left center; }
  .cart-line__remove { position: absolute; top: 10px; right: 10px; margin: 0; }
  .cart-line__name { font-size: 0.95rem; }
  .cart-line__discount { white-space: normal; }   /* room to breathe now */
  .cart-line__discount-label { overflow: visible; text-overflow: clip; }
  .cart-line__img { grid-area: img; }
  .cart-line__info { grid-area: info; }
  .cart-line__remove { grid-area: remove; align-self: start; }
  .cart-line__qty { grid-area: qty; }
  .cart-line__total { grid-area: total; align-self: center; }
}

/* ================= checkout.css ================= */
/* ===== Checkout ===== */
.chk__crumbs { padding-top: 4px; }
.chk__layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: start; padding-bottom: 64px; }

.chk-section { padding: 26px 0; border-bottom: 1px solid var(--line); }
.chk-section:first-of-type { padding-top: 8px; }
.chk-section h2 { display: flex; align-items: center; gap: 12px; font-family: var(--f-head); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 18px; }
.chk-num { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 0.78rem; font-weight: 700; flex-shrink: 0; }

.chk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
.chk-col-2 { grid-column: span 2; }
.chk-field { display: flex; flex-direction: column; gap: 6px; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--ink-2); }
.chk-field span { font-weight: 400; color: var(--faint); text-transform: none; }
.chk-field input { width: 100%; border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 11px 13px; font-family: var(--f-body); font-size: var(--t-body); font-weight: 400; color: var(--ink); background: #fff; }
.chk-field input:focus { outline: none; border-color: var(--ink); }
.chk-select { position: relative; display: flex; align-items: center; }
.chk-select select { width: 100%; appearance: none; border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 11px 36px 11px 13px; font-family: var(--f-body); font-size: var(--t-body); background: #fff; color: var(--ink); cursor: pointer; }
.chk-select select:focus { outline: none; border-color: var(--ink); }
.chk-select svg { position: absolute; right: 12px; pointer-events: none; color: var(--muted); }

.chk-check { display: inline-flex; align-items: center; gap: 9px; font-size: var(--t-sm); color: var(--ink-2); font-weight: 500; cursor: pointer; }
.chk-check input { width: 17px; height: 17px; accent-color: var(--brand-cta); }
.chk-billing-fields { margin-top: 18px; }

.chk-optin { display: flex; align-items: flex-start; gap: 12px; margin-top: 16px; padding: 14px 16px; background: var(--brand-wash); border: 1px solid var(--brand-wash-2); border-radius: var(--r-lg); cursor: pointer; }
.chk-optin input { width: 18px; height: 18px; margin-top: 1px; accent-color: var(--brand-cta); flex-shrink: 0; }
.chk-optin__copy { display: flex; flex-direction: column; gap: 2px; }
.chk-optin__copy b { font-family: var(--f-head); font-weight: 700; font-size: 0.9rem; color: var(--ink); }
.chk-optin__copy span { font-size: var(--t-xs); color: var(--muted); line-height: 1.5; }

/* shipping method */
.chk-ship-opts { display: flex; flex-direction: column; gap: 10px; }
.chk-ship-opt { display: flex; align-items: center; gap: 14px; padding: 15px 16px; border: 1.5px solid var(--line-2); border-radius: var(--r-lg); cursor: pointer; transition: border-color .14s var(--ease), background .14s var(--ease); }
.chk-ship-opt:hover { border-color: var(--ink); }
.chk-ship-opt.is-active { border-color: var(--brand); background: var(--brand-wash); }
.chk-ship-opt input { width: 18px; height: 18px; accent-color: var(--brand-cta); flex-shrink: 0; }
.chk-ship-opt__info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
.chk-ship-opt__info b { font-family: var(--f-head); font-weight: 600; font-size: 0.95rem; color: var(--ink); }
.chk-ship-opt__info span { font-size: var(--t-sm); color: var(--muted); }
.chk-ship-opt__price { font-size: 0.95rem; color: var(--ink); }

/* payment */
.chk-pay-tabs { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
.chk-pay-tab { display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border: 1.5px solid var(--line-2); border-radius: var(--r); font-family: var(--f-head); font-weight: 600; font-size: 0.88rem; color: var(--ink-2); background: #fff; transition: border-color .14s var(--ease), background .14s var(--ease), color .14s var(--ease); }
.chk-pay-tab:hover { border-color: var(--ink); }
.chk-pay-tab.is-active { border-color: var(--brand); background: var(--brand-wash); color: var(--brand-ink); }
.chk-card { margin-top: 4px; }
.chk-card-input { position: relative; display: flex; align-items: center; }
.chk-card-input input { padding-right: 40px; }
.chk-card-input svg { position: absolute; right: 13px; color: var(--faint); pointer-events: none; }
.chk-pay-note { display: flex; align-items: center; gap: 8px; padding: 13px 16px; background: var(--paper); border-radius: var(--r); font-size: var(--t-sm); color: var(--ink-2); }
.chk-pay-note svg { color: var(--brand-ink); flex-shrink: 0; }
.chk-secure { display: flex; align-items: center; gap: 6px; margin-top: 14px; font-size: var(--t-xs); color: var(--faint); }
.chk-secure svg { color: var(--stock); flex-shrink: 0; }

/* order summary sidebar */
.chk__summary { position: sticky; top: 138px; border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: var(--r-lg); padding: 24px; background: var(--panel); }
.chk__summary h2 { font-family: var(--f-head); text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.1rem; margin-bottom: 18px; }
.chk-lines { display: flex; flex-direction: column; gap: 14px; padding-bottom: 18px; border-bottom: 1px solid var(--line); max-height: 320px; overflow-y: auto; }
.chk-line { display: grid; grid-template-columns: 52px 1fr auto; gap: 12px; align-items: center; }
.chk-line__img { position: relative; border: 1px solid var(--line); border-radius: var(--r); background: #fff; }
.chk-line__img img { width: 52px; height: 52px; object-fit: contain; padding: 4px; }
.chk-line__img em { position: absolute; top: -7px; right: -7px; display: grid; place-items: center; min-width: 18px; height: 18px; padding: 0 3px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 0.62rem; font-weight: 700; font-style: normal; }
.chk-line__info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.chk-line__info b { font-size: 0.85rem; font-weight: 600; color: var(--ink); line-height: 1.3; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.chk-line__info em { font-style: normal; font-size: var(--t-xs); color: var(--muted); }
.chk-line__price { font-size: 0.85rem; color: var(--ink-2); }
.chk-sum-rows { display: flex; flex-direction: column; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--line); }
.chk-sum-rows > div { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
.chk-sum-rows dt { color: var(--muted); font-size: var(--t-sm); }
.chk-sum-rows dt span { color: var(--faint); }
.chk-sum-rows dd { font-weight: 600; color: var(--ink-2); font-size: var(--t-sm); }

@media (max-width: 900px){
  .chk__layout { grid-template-columns: 1fr; }
  .chk__summary { position: static; order: -1; }
}
@media (max-width: 560px){
  .chk-grid { grid-template-columns: 1fr; }
  .chk-col-2 { grid-column: span 1; }
}

/* ================= industries.css ================= */
/* ===== Industries ===== */
.ind-page__intro { padding-block: 8px 4px; text-align: center; }
.ind-page__intro h1 { font-family: var(--f-head); font-weight: 700; font-size: clamp(1.85rem, 3.4vw, 2.7rem); letter-spacing: -0.015em; margin: 12px 0 10px; }
.ind-page__intro p { color: var(--muted); max-width: 64ch; margin: 0 auto; font-size: var(--t-lead); }

.ind-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.ind-card { display: flex; align-items: center; gap: 14px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-lg); padding: 12px; transition: border-color .16s var(--ease), box-shadow .16s var(--ease), transform .16s var(--ease); }
.ind-card:hover { border-color: var(--brand); box-shadow: var(--sh-md); transform: translateY(-2px); }
.ind-card__img { width: 74px; height: 74px; flex-shrink: 0; border-radius: var(--r); overflow: hidden; background: var(--panel); display: grid; place-items: center; border: 1px solid var(--line); }
.ind-card__img img { width: 100%; height: 100%; object-fit: cover; }
.ind-card__img--icon { color: var(--brand); }
.ind-card__body b { display: block; font-family: var(--f-head); font-weight: 600; font-size: 1rem; line-height: 1.15; color: var(--ink); margin-bottom: 4px; }
.ind-card__body span { display: inline-flex; align-items: center; gap: 5px; font-size: var(--t-xs); color: var(--faint); }
.ind-card:hover .ind-card__body span { color: var(--brand-ink); }
@media (max-width: 960px){ .ind-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 680px){ .ind-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 440px){ .ind-grid { grid-template-columns: 1fr; } }

/* individual industry page now reuses .colban (see collection.css) for its banner
   and .col__layout / FilterPanel for the filtered product listing */

/* ================= pages.css ================= */
/* ===== Content pages: search · contact · bulk · misc ===== */

/* search */
.search__head { padding-block: 8px 4px; text-align: center; }
.search__head h1 { font-family: var(--f-head); font-weight: 700; font-size: clamp(1.7rem, 3.2vw, 2.4rem); letter-spacing: -0.015em; margin-bottom: 18px; }
.search__q { color: var(--brand-ink); }
.search__box { display: flex; gap: 10px; max-width: 620px; margin: 0 auto; }
.search__box input { flex: 1; height: 48px; border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 0 16px; font-size: var(--t-body); }
.search__box input:focus { outline: none; border-color: var(--ink); }
.search__count { margin-top: 14px; font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-sm); color: var(--muted); }

/* contact */
.contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 40px; padding-block: 44px 70px; align-items: start; }
.contact__info > ul { display: flex; flex-direction: column; gap: 4px; }
.contact__info li { display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--line); }
.contact__ic { width: 44px; height: 44px; flex-shrink: 0; display: grid; place-items: center; background: var(--brand-wash); color: var(--brand-ink); border-radius: var(--r); }
.contact__info b { display: block; font-family: var(--f-head); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--faint); }
.contact__info li a, .contact__info li span { font-size: 1.05rem; color: var(--ink); font-weight: 500; }
.contact__info li a:hover { color: var(--brand-ink); }
.contact__ship { display: flex; gap: 12px; margin-top: 22px; padding: 16px; background: var(--paper); border-radius: var(--r-lg); border: 1px solid var(--line); }
.contact__ship svg { color: var(--brand); flex-shrink: 0; }
.contact__ship p { font-size: var(--t-sm); color: var(--muted); }

.contact__form { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--brand); border-radius: var(--r-lg); padding: 28px; }
.contact__form h2 { font-family: var(--f-head); text-transform: uppercase; letter-spacing: 0.03em; font-size: 1.3rem; margin-bottom: 20px; }
.contact__row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.contact__form label { display: block; font-family: var(--f-head); font-weight: 600; font-size: var(--t-sm); color: var(--ink-2); margin-bottom: 14px; }
.contact__form input, .contact__form textarea { width: 100%; margin-top: 6px; border: 1.5px solid var(--line-2); border-radius: var(--r); padding: 11px 13px; font-family: var(--f-body); font-size: var(--t-body); font-weight: 400; }
.contact__form input:focus, .contact__form textarea:focus { outline: none; border-color: var(--ink); }
.contact__form textarea { resize: vertical; }
.contact__sent { display: flex; gap: 12px; align-items: flex-start; padding: 18px; background: color-mix(in srgb, var(--stock) 8%, #fff); border: 1px solid color-mix(in srgb, var(--stock) 32%, #fff); border-radius: var(--r); }
.contact__sent svg { color: var(--stock); flex-shrink: 0; margin-top: 2px; }
.contact__sent b { display: block; color: var(--ink); }
.contact__sent span { font-size: var(--t-sm); color: var(--muted); }
@media (max-width: 780px){ .contact { grid-template-columns: 1fr; } .contact__row { grid-template-columns: 1fr; } }

/* bulk */
.bulk-tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
.bulk-tier { border: 1px solid var(--line); border-radius: var(--r-lg); padding: 26px 18px; text-align: center; background: #fff; position: relative; overflow: hidden; }
.bulk-tier::before { content: ""; position: absolute; inset: 0 0 auto 0; height: 4px; background: var(--brand); }
.bulk-tier b { display: block; font-family: var(--f-display); font-size: 2.4rem; color: var(--brand-ink); line-height: 1; margin-top: 6px; }
.bulk-tier span { font-family: var(--f-head); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-sm); color: var(--muted); }
.bulk-note { margin-top: 24px; font-size: var(--t-sm); color: var(--faint); max-width: 74ch; }
@media (max-width: 640px){ .bulk-tiers { grid-template-columns: 1fr 1fr; } }

/* ================= chat.css ================= */
/* ===== Chat assistant — fixed bottom-right ===== */
.chatw { position: fixed; right: 20px; bottom: 20px; z-index: 95; }

.chatw__launch { width: 58px; height: 58px; border-radius: 50%; background: var(--brand-cta); color: #fff; display: grid; place-items: center; box-shadow: 0 12px 30px rgba(223,60,34,.45), 0 0 0 3px #fff; transition: transform .18s var(--ease), box-shadow .18s var(--ease), background .18s var(--ease); position: relative; }
.chatw__launch:hover { transform: translateY(-3px) scale(1.03); box-shadow: 0 18px 40px rgba(223,60,34,.55), 0 0 0 3px #fff; background: var(--brand-cta-hov); }
.chatw__ping { position: absolute; top: -2px; right: -2px; width: 15px; height: 15px; border-radius: 50%; background: var(--ink); border: 2px solid #fff; animation: chatping 1.8s var(--ease) infinite; }
@keyframes chatping { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.18); } }

.chatw__teaser { position: absolute; right: 0; bottom: 70px; display: flex; align-items: center; gap: 8px; background: #fff; color: var(--ink); border: 1px solid var(--line); box-shadow: var(--sh-lg); border-radius: var(--r-pill) 4px var(--r-pill) var(--r-pill); padding: 11px 10px 11px 18px; font-family: var(--f-head); font-weight: 600; font-size: 0.86rem; white-space: nowrap; cursor: pointer; animation: chatfadein .3s var(--ease); }
.chatw__teaser-x { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; color: var(--faint); flex-shrink: 0; }
.chatw__teaser-x:hover { background: var(--paper); color: var(--ink); }
@keyframes chatfadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

/* panel */
.chatw__panel { position: absolute; right: 0; bottom: 0; width: 368px; max-width: calc(100vw - 40px); height: min(560px, 78vh); display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 26px 60px rgba(20,15,10,.28); overflow: hidden; animation: chatopen .22s var(--ease); }
@keyframes chatopen { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: translateY(0) scale(1); } }

.chatw__head { display: flex; align-items: center; gap: 11px; padding: 15px 16px; background: var(--ink); color: #fff; flex-shrink: 0; }
.chatw__avatar { width: 34px; height: 34px; border-radius: 50%; background: var(--brand-cta); display: grid; place-items: center; flex-shrink: 0; }
.chatw__head-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.chatw__head-info b { font-family: var(--f-head); font-weight: 700; font-size: 0.95rem; }
.chatw__head-info span { display: flex; align-items: center; gap: 5px; font-size: 0.72rem; color: rgba(255,255,255,.72); }
.chatw__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--stock); flex-shrink: 0; box-shadow: 0 0 0 2px rgba(255,255,255,.14); }
.chatw__close { margin-left: auto; color: rgba(255,255,255,.75); padding: 4px; flex-shrink: 0; }
.chatw__close:hover { color: #fff; }

.chatw__list { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--paper); scrollbar-width: thin; }
.chatw__row { display: flex; }
.chatw__row--bot { justify-content: flex-start; }
.chatw__row--user { justify-content: flex-end; }
.chatw__msg { max-width: 82%; background: #fff; border: 1px solid var(--line); border-radius: 14px 14px 14px 4px; padding: 10px 13px; }
.chatw__msg p { font-size: 0.87rem; line-height: 1.5; color: var(--ink-2); }
.chatw__row--user .chatw__msg { background: var(--ink); border-color: var(--ink); border-radius: 14px 14px 4px 14px; }
.chatw__row--user .chatw__msg p { color: #fff; }
.chatw__cta { display: inline-flex; align-items: center; gap: 5px; margin-top: 8px; font-family: var(--f-head); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.68rem; color: var(--brand-ink); }
.chatw__cta:hover { gap: 8px; }

.chatw__typing { display: inline-flex; align-items: center; gap: 4px; padding: 13px 15px; }
.chatw__typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--faint); animation: chattyping 1.1s infinite; }
.chatw__typing span:nth-child(2) { animation-delay: .15s; }
.chatw__typing span:nth-child(3) { animation-delay: .3s; }
@keyframes chattyping { 0%, 60%, 100% { opacity: .35; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }

.chatw__quick { display: flex; flex-wrap: wrap; gap: 7px; padding: 12px 16px; border-top: 1px solid var(--line); flex-shrink: 0; }
.chatw__quick button { font-family: var(--f-head); font-weight: 600; font-size: 0.76rem; color: var(--brand-ink); background: var(--brand-wash); border: 1px solid transparent; border-radius: var(--r-pill); padding: 7px 13px; transition: border-color .14s var(--ease); }
.chatw__quick button:hover { border-color: var(--brand); }

.chatw__form { display: flex; align-items: center; gap: 8px; padding: 12px; border-top: 1px solid var(--line); flex-shrink: 0; background: #fff; }
.chatw__form input { flex: 1; min-width: 0; border: 1.5px solid var(--line-2); border-radius: var(--r-pill); padding: 10px 16px; font-size: 0.87rem; background: var(--paper); }
.chatw__form input:focus { outline: none; border-color: var(--ink); background: #fff; }
.chatw__form button { width: 38px; height: 38px; flex-shrink: 0; border-radius: 50%; background: var(--brand-cta); color: #fff; display: grid; place-items: center; transition: background .14s var(--ease), opacity .14s var(--ease); }
.chatw__form button:hover { background: var(--brand-cta-hov); }
.chatw__form button:disabled { opacity: .4; pointer-events: none; }

@media (max-width: 560px){
  .chatw { right: 14px; bottom: 14px; }
  .chatw__panel { width: calc(100vw - 28px); height: min(72vh, 560px); right: -6px; }
  .chatw__teaser { right: -6px; }
}

/* ================= shopify-overrides.css ================= */
/* ============================================================================
   Shopify-only styles — appended to the bundle by build-css.sh.

   Everything here exists because Shopify produces markup the React redesign
   never had: pagination, rich-text bodies coming out of the admin, customer
   account forms, order tables, the password page. Nothing in this file
   restyles ported markup — if a rule here fights the port, the port is right
   and this file is wrong.

   It uses the same tokens as the port (var(--brand), var(--line), …) so the
   additions read as part of the same system rather than bolted on. rem is fine
   here: this theme performs no unit conversion, so it means what it says.
   ========================================================================== */

/* --- [hidden] must actually hide -------------------------------------------
   THIS RULE IS NON-NEGOTIABLE — read before removing it.

   React expressed "not showing" by not rendering the element at all
   (`{open && <Panel/>}`). Liquid can't do that for things toggled at runtime,
   so this port uses the `hidden` attribute instead. But `hidden` only hides via
   the UA stylesheet's `[hidden]{display:none}`, which has almost no specificity
   — so any ported rule like `.chatw__panel{display:flex}` or
   `.faq__a{display:block}` silently beats it and the element stays on screen.

   That is exactly why the chat panel would not close: the close button set
   `hidden`, and `.chatw__panel{display:flex}` overrode it. Same latent bug for
   the FAQ answers, drawer submenus, product tabs, the lightbox and the search
   dropdown.

   One rule fixes the whole class of bug. It is scoped to the attribute only, so
   it can never affect an element that isn't explicitly hidden. */
[hidden] { display: none !important; }

/* ===========================================================================
   REQUESTED REFINEMENTS — these intentionally go BEYOND the React port.
   Everything else in this file only supports Shopify-only markup; this block is
   the one place where the design was asked to improve on the original.
   All values come from the existing tokens — no new palette.
   ======================================================================== */

/* --- buy row: add to cart --------------------------------------------------
   BUG: base.css sets `svg { display: block }`. The two state labels are wrapped
   in a <span> so JS can swap them, and a block-level svg inside a non-flex span
   pushes the text onto its own line — the cart icon was sitting above
   "ADD TO CART". Making the state wrapper a flex line restores the single row
   the React button had, where icon and text were siblings of the flex button. */
.pdp-buy__add > span,
.pc__cta > span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

/* --- buy row: quantity stepper ---------------------------------------------
   Was: three equal cells divided by full-height 1.5px rules, which read like a
   spreadsheet row rather than one control. Now the control is a single unit —
   the number is the anchor, the -/+ are quiet until you reach for them, and the
   hover fill is inset so it never touches the outer border. The stepper stays
   achromatic at rest because the CTA beside it is the one flare in this row. */
.pdp-buy__actions .qty,
.cart-line__qty .qty {
  background: #fff;
  border-color: var(--line-2);
  overflow: hidden;
}
.qty input {
  /* the dividers were the "spreadsheet" tell — the grouping is already carried
     by the outer border, so the rules are redundant weight */
  border-inline: 0;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.pdp-buy__actions .qty input { font-size: 1.0625rem; }
.qty button {
  position: relative;
  color: var(--muted);
  transition: color .14s var(--ease), background .14s var(--ease);
}
.qty button::after {
  /* inset hover plate, so the fill reads as a target rather than a table cell */
  content: "";
  position: absolute;
  inset: 5px;
  border-radius: 7px;
  background: transparent;
  transition: background .14s var(--ease);
}
.qty button:hover { color: var(--ink); background: transparent; }
.qty button:hover::after { background: var(--paper-2); }
.qty button:active::after { background: var(--line); }
.qty button svg { position: relative; z-index: 1; }

/* --- buy row: wishlist -----------------------------------------------------
   Was: `color: var(--faint)` on a hollow box — a pale grey heart in an empty
   square reads as unfinished rather than restrained. It now sits at the same
   ink weight as the rest of the row at rest, warms on hover, and fills solid
   when saved so the state is unmistakable at a glance. */
.pdp-buy__wish {
  color: var(--ink-2);
  background: #fff;
  transition: color .16s var(--ease), border-color .16s var(--ease),
              background .16s var(--ease), transform .16s var(--ease);
}
.pdp-buy__wish:hover {
  color: var(--brand-ink);
  border-color: var(--brand);
  background: var(--brand-wash);
}
.pdp-buy__wish:active { transform: scale(.96); }
.pdp-buy__wish.is-on {
  color: var(--brand);
  border-color: var(--brand);
  background: var(--brand-wash);
}
/* a single confirming beat when it's saved — not a loop */
.pdp-buy__wish.is-on svg { animation: mts-heart-pop .26s var(--ease); }
@keyframes mts-heart-pop {
  0%   { transform: scale(1); }
  45%  { transform: scale(1.22); }
  100% { transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .pdp-buy__wish.is-on svg { animation: none; }
}

/* card heart: same treatment, scaled down */
.pc__wish {
  color: var(--ink-2);
  transition: color .16s var(--ease), background .16s var(--ease), transform .16s var(--ease);
}
.pc__wish:hover { color: var(--brand-ink); background: var(--brand-wash); }
.pc__wish.is-on { color: var(--brand); }
.pc__wish.is-on svg { fill: var(--brand); animation: mts-heart-pop .26s var(--ease); }

/* --- newsletter modal ------------------------------------------------------
   The store's signature device is the hazard-tape stripe, so the dialog is
   edged with it rather than given a gradient or a stock illustration. Charcoal
   type, one brand CTA, nothing else competing. */
.mts-pop {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: grid;
  place-items: center;
  padding: 20px;
}
.mts-pop__scrim {
  position: absolute;
  inset: 0;
  background: rgba(20, 15, 12, .62);
  animation: mts-pop-fade .28s var(--ease) both;
}
.mts-pop__card {
  position: relative;
  width: min(520px, 100%);
  background: #fff;
  border-radius: var(--r-lg);
  box-shadow: var(--sh-lg);
  overflow: hidden;
  animation: mts-pop-rise .34s var(--ease) both;
}
/* the signature: hazard tape along the top edge */
.mts-pop__card::before {
  content: "";
  display: block;
  height: 7px;
  background: repeating-linear-gradient(45deg,
    var(--brand) 0 14px, var(--ink) 14px 28px);
}
.mts-pop__body { padding: 34px 34px 30px; }
.mts-pop__logo {
  display: block;
  margin-bottom: 20px;
}
.mts-pop__logo img {
  width: 168px;
  height: auto;
  display: block;
}
.mts-pop__title {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 1.6rem;
  line-height: 1.14;
  letter-spacing: -0.015em;
  color: var(--ink);
  margin-bottom: 10px;
  text-wrap: balance;
}
.mts-pop__text {
  color: var(--muted);
  font-size: var(--t-sm);
  line-height: 1.6;
  margin-bottom: 20px;
}
.mts-pop__form { display: flex; gap: 10px; }
.mts-pop__form input {
  flex: 1;
  min-width: 0;
  border: 1.5px solid var(--line-2);
  border-radius: 10px;
  padding: 13px 15px;
  font-family: var(--f-body);
  font-size: var(--t-body);
  color: var(--ink);
  background: #fff;
  transition: border-color .14s var(--ease);
}
.mts-pop__form input:focus { outline: none; border-color: var(--ink); }
.mts-pop__form button { border-radius: 10px; padding-inline: 22px; white-space: nowrap; }
.mts-pop__fine {
  margin-top: 14px;
  font-size: var(--t-xs);
  color: var(--faint);
  display: flex;
  align-items: center;
  gap: 6px;
}
.mts-pop__close {
  position: absolute;
  top: 16px;
  right: 14px;
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 8px;
  color: var(--faint);
  background: transparent;
  transition: color .14s var(--ease), background .14s var(--ease);
}
.mts-pop__close:hover { color: var(--ink); background: var(--paper); }
.mts-pop__done {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 16px;
  border-radius: 10px;
  background: color-mix(in srgb, var(--stock) 9%, #fff);
  border: 1px solid color-mix(in srgb, var(--stock) 34%, #fff);
  color: var(--ink);
  font-weight: 600;
}
.mts-pop__done svg { color: var(--stock); flex-shrink: 0; }
@keyframes mts-pop-fade { from { opacity: 0 } to { opacity: 1 } }
@keyframes mts-pop-rise {
  from { opacity: 0; transform: translateY(14px) scale(.98) }
  to   { opacity: 1; transform: none }
}
@media (prefers-reduced-motion: reduce) {
  .mts-pop__scrim, .mts-pop__card { animation: none; }
}
@media (max-width: 520px) {
  .mts-pop__body { padding: 26px 22px 24px; }
  .mts-pop__title { font-size: 1.35rem; }
  .mts-pop__form { flex-direction: column; }
}

/* --- wishlist page --------------------------------------------------------- */
.page-hero--plain {
  background: none;
  color: inherit;
  text-align: center;
  padding-block: 34px 6px;
}
.page-hero--plain h1 {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: clamp(1.85rem, 3.4vw, 2.7rem);
  letter-spacing: -0.015em;
  margin: 10px 0 8px;
  color: var(--ink);
}

/* --- pagination ------------------------------------------------------------
   The React catalogue rendered all 132 products at once; a live storefront
   paginates. Built from the design's existing button/hairline vocabulary. */
.mts-pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 40px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
}
.mts-pager__list { display: flex; align-items: center; gap: 4px; }
.mts-pager__step,
.mts-pager__num {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-width: 40px;
  height: 40px;
  padding-inline: 12px;
  justify-content: center;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: var(--t-sm);
  color: var(--ink-2);
  border: 1px solid var(--line-2);
  border-radius: var(--r);
  background: #fff;
  transition: border-color .16s var(--ease), color .16s var(--ease), background .16s var(--ease);
}
.mts-pager__step:hover,
.mts-pager__num:hover { border-color: var(--ink); color: var(--ink); }
.mts-pager__num.is-current {
  background: var(--brand-cta);
  border-color: var(--brand-cta);
  color: #fff;
}
.mts-pager__step.is-disabled { opacity: .45; pointer-events: none; }
.mts-pager__back { transform: rotate(180deg); }
.mts-pager__gap { padding-inline: 6px; color: var(--faint); }
@media (max-width: 560px) {
  .mts-pager__list { order: -1; width: 100%; justify-content: center; margin-bottom: 8px; }
}

/* --- rich text from the admin ----------------------------------------------
   Collection descriptions, page bodies and product descriptions arrive as raw
   HTML — headings, lists, tables. The React version rendered typed blocks with
   their own classes, so those bare elements need the equivalent treatment here.

   Do NOT write literal angle-bracket tag names in this file. It is concatenated
   into a .liquid stylesheet, and theme-check parses that as HTML — a tag name
   in a comment reads as an unclosed element and fails the whole file. */
.catseo__intro > h2,
.catseo__intro > h3,
.catseo__intro > h4,
.page-prose > h2,
.page-prose > h3,
.page-prose > h4,
.pdp-desc > h2,
.pdp-desc > h3,
.pdp-desc > h4 {
  font-family: var(--f-head);
  font-weight: 700;
  color: var(--ink);
  line-height: 1.15;
  margin-top: 28px;
  margin-bottom: 10px;
}
.catseo__intro > h2, .page-prose > h2, .pdp-desc > h2 { font-size: var(--t-h3); }
.catseo__intro > h3, .page-prose > h3, .pdp-desc > h3 { font-size: 1.15rem; }
.catseo__intro > h4, .page-prose > h4, .pdp-desc > h4 { font-size: 1rem; }

.catseo__intro > p,
.page-prose > p,
.pdp-desc > p { margin-bottom: 14px; color: var(--ink-2); }

.catseo__intro ul,
.catseo__intro ol,
.page-prose ul,
.page-prose ol,
.pdp-desc ul,
.pdp-desc ol {
  margin: 0 0 18px;
  padding-left: 0;
  list-style: none;
  display: grid;
  gap: 9px;
}
.catseo__intro li,
.page-prose li,
.pdp-desc li {
  position: relative;
  padding-left: 26px;
  color: var(--ink-2);
  line-height: 1.55;
}
/* the check mark the React list blocks drew with an icon */
.catseo__intro li::before,
.page-prose li::before,
.pdp-desc li::before {
  content: "";
  position: absolute;
  left: 2px;
  top: 0.5em;
  width: 11px;
  height: 6px;
  border-left: 2px solid var(--brand-ink);
  border-bottom: 2px solid var(--brand-ink);
  transform: translateY(-50%) rotate(-45deg);
}
.catseo__intro ol,
.page-prose ol,
.pdp-desc ol { counter-reset: mts-ol; }
.catseo__intro ol > li::before,
.page-prose ol > li::before,
.pdp-desc ol > li::before {
  counter-increment: mts-ol;
  content: counter(mts-ol) ".";
  border: 0;
  transform: none;
  top: 0;
  width: auto;
  height: auto;
  font-family: var(--f-num);
  font-weight: 700;
  color: var(--brand-ink);
}

.page-prose img,
.pdp-desc img { border-radius: var(--r-lg); margin: 18px 0; }

.catseo__intro a,
.page-prose a,
.pdp-desc a { color: var(--brand-ink); text-decoration: underline; text-underline-offset: 2px; }
.catseo__intro a:hover,
.page-prose a:hover,
.pdp-desc a:hover { color: var(--brand-cta-hov); }

.catseo__intro strong,
.page-prose strong,
.pdp-desc strong { color: var(--ink); }

.catseo__intro blockquote,
.page-prose blockquote {
  margin: 18px 0;
  padding: 14px 18px;
  border-left: 3px solid var(--brand);
  background: var(--paper);
  border-radius: 0 var(--r) var(--r) 0;
  color: var(--muted);
}

/* Tables in admin HTML — match the ported .spec-table look, and never let a
   wide spec table push the page sideways on mobile. */
.page-prose table,
.pdp-desc table {
  width: 100%;
  border-collapse: collapse;
  margin: 18px 0;
  font-size: var(--t-sm);
}
.page-prose th, .page-prose td,
.pdp-desc th, .pdp-desc td {
  border: 1px solid var(--line);
  padding: 10px 12px;
  text-align: left;
  vertical-align: top;
}
.page-prose th, .pdp-desc th {
  background: var(--paper);
  font-family: var(--f-head);
  font-weight: 600;
  color: var(--ink);
}
.mts-table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }

/* --- customer account ------------------------------------------------------ */
.mts-auth {
  display: grid;
  gap: 22px;
  max-width: 520px;
  margin-inline: auto;
  padding-block: 48px;
}
.mts-auth__note {
  margin-top: 14px;
  font-size: var(--t-sm);
  color: var(--muted);
}
.mts-auth__note a { color: var(--brand-ink); font-weight: 600; }
.mts-auth__toggle {
  margin-top: 12px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: var(--t-sm);
  color: var(--brand-ink);
  text-decoration: underline;
  text-underline-offset: 3px;
}
.mts-auth__toggle:hover { color: var(--brand-cta-hov); }

.contact__sent--error {
  background: color-mix(in srgb, var(--sale) 8%, #fff);
  border-color: color-mix(in srgb, var(--sale) 32%, #fff);
}
.contact__sent--error svg { color: var(--sale); }

.mts-orders { width: 100%; }
.mts-orders a { color: var(--brand-ink); font-weight: 600; }

.mts-address {
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
}
.mts-address__actions { display: flex; gap: 16px; margin-top: 8px; }
.mts-address-form { margin-top: 16px; }
.mts-address__default { margin-bottom: 14px; }

.mts-order-addresses {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  margin-top: 28px;
}
@media (max-width: 700px) { .mts-order-addresses { grid-template-columns: 1fr; } }

/* --- password + gift card --------------------------------------------------- */
.mts-password,
.mts-giftcard {
  min-height: 70vh;
  display: grid;
  place-content: center;
  text-align: center;
  gap: 16px;
  padding-block: 64px;
}
.mts-password__logo { margin-inline: auto; }
.mts-giftcard__code {
  font-size: 1.4rem;
  letter-spacing: 0.12em;
  padding: 14px 20px;
  border: 1px dashed var(--line-2);
  border-radius: var(--r-lg);
  background: var(--paper);
}

/* --- no-JS safety nets ------------------------------------------------------
   The ported markup assumes JS toggles these. Without it, show rather than
   hide — a visitor with JS off should still reach the content. */
.no-js .faq__a[hidden],
.no-js .hd-drawer__sub[hidden] { display: block !important; }
.no-js [data-mts-panel][hidden] { display: block !important; }
.no-js .hslide__slide { position: relative; opacity: 1; }

/* --- utility bar icons -----------------------------------------------------
   The packaged icons here were filled multi-colour illustrations (an actual
   Australian flag, a rendered delivery truck) forced to white with
   `filter: brightness(0) invert(1)`. At 16-18px that flattens every one of them
   into an indistinguishable white blob — which is why the strip looked cheap.

   The bar now uses the theme's own 1.75-stroke icon set, which was drawn for
   this size, so all four read as one family. Slightly reduced opacity keeps
   them subordinate to the label they sit beside; they lift to full white with
   the text on hover. */
.hd-util__ic svg {
  opacity: .92;
  transition: opacity .16s var(--ease);
  overflow: visible;              /* stop 1.75px strokes clipping at the box edge */
}
.hd-util li:hover .hd-util__ic svg { opacity: 1; }
.hd-util__ic {
  /* optical alignment: stroke icons sit a hair high against uppercase labels */
  transform: translateY(-0.5px);
}

/* --- account: saved addresses grid ----------------------------------------- */
.mts-address-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 14px;
  margin-top: 4px;
}
.mts-address-grid .mts-address {
  padding: 16px;
  border: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  border-radius: var(--r-lg);
  background: #fff;
  color: var(--ink-2);
  line-height: 1.6;
  font-size: var(--t-sm);
}
.mts-address-grid .tag { margin-bottom: 8px; }

/* --- account: signed-out card ----------------------------------------------
   The React card held a tabbed sign-in/register form, so it filled naturally.
   Ours hands authentication to Shopify's hosted OAuth, which leaves one button
   — without this the card reads as an empty box with a stray sentence in it.
   Left-aligned, properly spaced, and the supporting text sits under the action
   rather than floating above it. */
.auth__card { padding: 30px 30px 26px; text-align: left; }
.auth__card > .auth__alt:first-child {
  margin: 0 0 22px;
  font-size: var(--t-body);
  color: var(--muted);
  line-height: 1.6;
}
.auth__card .btn--block { margin-bottom: 16px; }
.auth__card > .auth__alt:last-child {
  margin: 0;
  padding-top: 16px;
  border-top: 1px solid var(--line);
  font-size: var(--t-sm);
  color: var(--muted);
}
.auth__card > .auth__alt:last-child a {
  color: var(--brand-ink);
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* --- utility bar: supplied icons -------------------------------------------
   The ported rule tints every image in this strip white
   (filter: brightness(0) invert(1)). That is right for single-colour artwork —
   a black or navy glyph would otherwise be invisible on the red bar — and wrong
   for full-colour artwork, where it collapses the whole illustration into one
   white silhouette. The Australian flag is the clearest case: tinted white it
   stops being a flag at all.

   So the tint is opt-out per icon rather than global. No plate, no background:
   the SVGs are transparent and render bare. */
.hd-util__ic img.hd-util__ic--colour {
  filter: none;
  opacity: 1;
}
.hd-util__ic img {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* --- pinned nav strip ------------------------------------------------------
   Only the nav bar pins, not the whole masthead. The masthead is 85px of logo,
   search and account actions; pinning all of it eats a tenth of the viewport on
   every scroll. The nav strip is 42px and carries the thing people actually
   reach for mid-page.

   It has to be `fixed`, not `sticky`: base.css sets body{overflow-x:clip} to
   stop full-bleed sections causing horizontal scroll, and a non-visible overflow
   on an ancestor stops position:sticky engaging in Chromium (.hd is
   display:contents, so body IS the ancestor). Measured before this change the
   bar simply scrolled away — top:-1058 at 1100px of scroll. A spacer of equal
   height holds its place in flow so the page never jumps at the swap. */
.hd-stick {
  /* MUST stay free of transform / will-change / filter / contain. Any of those
     make this element the containing block for `position: fixed` descendants,
     which silently pins .hd-nav to this box instead of the viewport — it kept
     its class and its computed `position: fixed`, and still scrolled away. */
  position: static;
  box-shadow: none;
  will-change: auto;
}

.hd-nav.is-fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  transition: transform .28s var(--ease), box-shadow .22s var(--ease);
  will-change: transform;
}
.hd-nav.is-fixed.is-hidden { transform: translateY(-100%); }
.hd-nav.is-fixed.is-pinned { box-shadow: var(--sh-md); }
/* never slide out from under an open panel */
.hd-nav.is-locked { transform: none !important; }
.mts-stick-spacer { display: block; }

@media (prefers-reduced-motion: reduce) {
  .hd-nav.is-fixed { transition: none; }
  .hd-nav.is-fixed.is-hidden { transform: none; }
}

/* --- scroll smoothness -----------------------------------------------------
   The marquees and the hero run continuously, so the browser repaints them even
   when they are nowhere near the viewport. Painting is confined to each band so
   a repaint inside one can't invalidate the rest of the page, and the JS pauses
   the animations outright once they scroll out of view. */
.brandx__slider,
.tmx__marquee,
.indx-strip__viewport,
.hslide__track { contain: paint; }

.mts-offscreen .brandx__track,
.mts-offscreen .tmx__track { animation-play-state: paused !important; }

/* --- utility bar: supplied icons -------------------------------------------
   The ported rule tints every image in this strip white
   (filter: brightness(0) invert(1)). That is right for single-colour artwork —
   a black or navy glyph would otherwise be invisible on the red bar — and wrong
   for full-colour artwork, where it collapses the whole illustration into one
   white silhouette. The Australian flag is the clearest case: tinted white it
   stops being a flag at all.

   So the tint is opt-out per icon rather than global. No plate, no background:
   the SVGs are transparent and render bare. */
.hd-util__ic img.hd-util__ic--colour {
  filter: none;
  opacity: 1;
}
.hd-util__ic img {
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* --- sticky header: why it is fixed, not sticky -----------------------------
   The port sets .hd-stick{position:sticky;top:0}, but it never actually stuck:
   base.css sets body{overflow-x:clip}, and a non-visible overflow on an ancestor
   stops position:sticky engaging in Chromium. (.hd is display:contents, so body
   IS the ancestor here.) Measured on the live page the bar simply scrolled away
   — top:-1058 at 1100px of scroll.

   Rather than remove overflow-x:clip — which is there to stop the full-bleed
   sections causing horizontal scroll — the bar is promoted to position:fixed
   once it would have pinned, and a spacer of equal height takes its place in
   flow so the page doesn't jump at the swap. mts-theme.js owns the toggle. */
.mts-stick-spacer { display: block; }

/* --- smart sticky header ---------------------------------------------------
   The ported .hd-stick is sticky-always, which on a 9,000px homepage means the
   masthead and mega-nav sit on top of the content the whole way down. This
   hides it while you scroll down — you're reading, not navigating — and snaps
   it back the moment you scroll up, which is when you actually want it.

   Only .hd-stick moves; the red utility strip sits above it and scrolls away
   naturally, so the revealed bar is the useful part (search, cart, nav) and
   nothing else.

   The shadow only appears once the bar is pinned away from the top, so at rest
   the header still reads as part of the page rather than floating over it. */
/* Never animate the bar out from under someone who has a panel open — the
   trigger would slide away while they were using it. */
@media (prefers-reduced-motion: reduce) {
  .hd-stick { transition: none; }
  /* stay put rather than jump */
}

/* --- category dropdown -----------------------------------------------------
   Replaces the scrolling rail. With 62 categories the old list meant scrolling
   inside a scrolling page; this collapses it to one click while keeping the
   group headings and counts a native <select> can't render. */
.rail--select {
  position: relative;
  z-index: 20;
  /* The ported .rail is a card with `overflow: hidden`, which clipped the
     absolutely-positioned panel to the card's own height — the list opened but
     was cut off two rows in. The dropdown is its own control, so the card
     chrome comes off entirely. */
  overflow: visible;
  border: 0;
  background: none;
  border-radius: 0;
}
.rail--select .rail__head {
  margin-bottom: 10px;
  background: none;
  color: var(--ink);
  padding: 0;
}
/* The old rail was hidden on small screens because a 62-row scroll list was
   unusable there. A dropdown is *more* useful on mobile, so it stays. */
@media (max-width: 900px) {
  .rail--select { display: block; }
}
/* The sticky sidebar offset assumed the whole masthead pinned. Only the 48px
   nav strip does now, so the old 143px left a large gap. */
.col__side { top: 64px; }

.rail-dd { position: relative; }
.rail-dd__toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 12px 14px;
  background: #fff;
  border: 1.5px solid var(--line-2);
  border-radius: 10px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: var(--t-sm);
  color: var(--ink);
  text-align: left;
  transition: border-color .14s var(--ease), box-shadow .14s var(--ease);
}
.rail-dd__toggle:hover { border-color: var(--ink); }
.rail-dd[data-open] .rail-dd__toggle {
  border-color: var(--ink);
  box-shadow: var(--sh-sm);
}
.rail-dd__label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rail-dd__caret { display: inline-flex; color: var(--muted); transition: transform .18s var(--ease); }
.rail-dd[data-open] .rail-dd__caret { transform: rotate(180deg); }

.rail-dd__panel {
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  right: 0;
  z-index: 60;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: var(--r-lg);
  box-shadow: var(--sh-lg);
  overflow: hidden;
  animation: mts-dd-in .16s var(--ease) both;
}
@keyframes mts-dd-in {
  from { opacity: 0; transform: translateY(-4px) }
  to   { opacity: 1; transform: none }
}
@media (prefers-reduced-motion: reduce) {
  .rail-dd__panel { animation: none; }
  .rail-dd__caret { transition: none; }
}

.rail-dd__search {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--line);
  background: var(--panel);
}
.rail-dd__search svg { color: var(--faint); flex-shrink: 0; }
.rail-dd__search input {
  flex: 1;
  min-width: 0;
  border: 0;
  background: none;
  font-size: var(--t-sm);
  color: var(--ink);
}
.rail-dd__search input:focus { outline: none; }

.rail-dd__scroll { max-height: 340px; overflow-y: auto; overscroll-behavior: contain; }
.rail-dd__group-label {
  position: sticky;
  top: 0;
  z-index: 1;
  padding: 9px 14px 5px;
  background: #fff;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: var(--t-eyebrow);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--faint);
}
.rail-dd__opt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 9px 14px;
  font-size: 0.92rem;
  color: var(--ink-2);
  transition: background .12s var(--ease), color .12s var(--ease);
}
.rail-dd__opt b { font-size: var(--t-xs); color: var(--faint); font-weight: 600; }
.rail-dd__opt:hover,
.rail-dd__opt.is-focus { background: var(--paper); color: var(--brand-ink); }
.rail-dd__opt.is-active {
  background: var(--brand-wash);
  color: var(--brand-ink);
  font-weight: 600;
}
.rail-dd__opt.is-active b { color: var(--brand-ink); }
.rail--select .rail__none { padding: 14px; font-size: var(--t-sm); color: var(--muted); }

/* --- filter sidebar --------------------------------------------------------
   Matches the live mytapestore.com.au sidebar: collapsible group headings with
   a chevron and a short brand underline, options carrying their result count.
   The card chrome from the ported .filt-card is dropped — on the original each
   group is its own band separated by a rule, not one boxed panel. */
.filt-card {
  border: 0;
  background: none;
  border-radius: 0;
  padding: 0;
  overflow: visible;
}
.filt-card__head { display: none; }

.filt {
  border: 0;
  padding: 0;
  margin-bottom: 22px;
}
.filt__title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  padding: 0 0 9px;
  margin: 0;
  background: none;
  border: 0;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: var(--t-sm);
  letter-spacing: 0.07em;
  text-transform: uppercase;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  position: relative;
  border-bottom: 1px solid var(--line);
}
/* the short brand underline from the original */
.filt__title::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -1px;
  width: 46px;
  height: 2px;
  background: var(--brand);
}
.filt__chev { color: var(--muted); transition: transform .2s var(--ease); flex-shrink: 0; }
.filt__title[aria-expanded="false"] .filt__chev { transform: rotate(-90deg); }

.filt__body { padding-top: 12px; }
/* long option lists scroll inside their own group rather than pushing the page */
.filt__colours,
.filt__cats {
  display: block;
  max-height: 260px;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-width: thin;
  scrollbar-color: var(--line-2) transparent;
}
.filt__colours::-webkit-scrollbar,
.filt__cats::-webkit-scrollbar { width: 8px; }
.filt__colours::-webkit-scrollbar-thumb,
.filt__cats::-webkit-scrollbar-thumb {
  background: var(--line-2); border-radius: 100px; border: 2px solid #fff;
}

.filt__check {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 0;
  font-size: 0.92rem;
  color: var(--ink-2);
  cursor: pointer;
  min-width: 0;
}
/* :not(.filt__dot) matters. The colour swatch is itself a <span>, so a bare
   `.filt__check > span { flex: 1 }` made it grow to fill the row — a 17px
   circle stretched into a 200px ellipse. That selector also outranks
   `.filt__dot`'s own width, so the width there could never win. */
.filt__check > span:not(.filt__dot) {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.filt__check input { flex-shrink: 0; accent-color: var(--brand); width: 16px; height: 16px; }
.filt__check:hover > span { color: var(--brand-ink); }
.filt__check input:disabled ~ span { opacity: .45; }
.filt__count {
  flex-shrink: 0;
  font-size: var(--t-xs);
  font-weight: 600;
  color: var(--faint);
}
.filt__dot {
  flex: 0 0 17px;            /* never grow, never shrink — it is a circle */
  width: 17px;
  height: 17px;
  border-radius: 50%;
  border: 1px solid var(--line-2);
  background: var(--paper);
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.5);
}

.filt__clear {
  display: inline-block;
  margin-top: 4px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: var(--t-sm);
  color: var(--brand-ink);
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* the sidebar itself must never clip the category dropdown or scroll sideways */
.col__side { overflow: visible; min-width: 0; }
.col__layout { min-width: 0; }

/* --- mega-menu overflow ----------------------------------------------------
   A 3-column panel opening from a mid-nav item is ~570px wide, and below about
   1200px that runs past the right edge — the page scrolled 110px sideways at
   1024px. body{overflow-x:clip} did not catch it because the scrollport is on
   <html>, not <body>, and once the nav is position:fixed it is outside body's
   clip anyway.

   Fixed at the source: below 1200px every panel anchors to the right edge of
   its trigger, so it opens inwards and can never leave the viewport. The clip
   on <html> is the belt-and-braces guard for anything else that misbehaves. */
html { overflow-x: clip; }

@media (max-width: 1200px) {
  .hd-nav__item .hd-mega,
  .hd-nav__item--wide .hd-mega {
    left: auto;
    right: 0;
    transform: translateY(8px) scale(0.98);
  }
  .hd-nav__item.is-open .hd-mega,
  .hd-nav__item--wide.is-open .hd-mega {
    transform: translateY(0) scale(1);
  }
}
/* The panel can never be wider than the page gutters allow. It must NOT wrap:
   flex-wrap here collapsed the three mega-menu columns into one very long
   single column, which is what turned the nav into "one big dropdown". Columns
   stay side by side; the right-anchoring above is what keeps them on screen. */
.hd-mega { max-width: calc(100vw - 32px); }
.hd-mega__cols { flex-wrap: nowrap; }

/* --- Judge.me -------------------------------------------------------------
   Judge.me's current widget uses a `jm-*` namespace (the older `jdgm-*` classes
   are the legacy widget) and, importantly, exposes CSS custom properties for
   theming. Setting those is far more durable than overriding hashed classes
   with !important — the variables are a supported contract, the class names are
   not, and they change between releases.

   Both namespaces are covered: `jm-*` for the current widget, `jdgm-*` for the
   badge and any legacy surface still in play. */
.jm-review-widget,
.jdgm-widget,
#judgeme_product_reviews {
  /* buttons -> the theme's brand CTA */
  --jm-btn-bg: var(--brand-cta);
  --jm-btn-hover-bg: var(--brand-cta-hov);
  --jm-btn-color: #fff;
  --jm-btn-border: var(--brand-cta);
  --jm-btn-border-radius: 10px;
  --jm-primary-button-bg: var(--brand-cta);
  --jm-secondary-button-bg: #fff;
  --jm-review-widget-button-color: var(--brand-cta);
  --jm-review-widget-button-text-color: #fff;

  /* surfaces + text */
  --jm-widget-border-radius: var(--r-lg);
  --jm-review-widget-text-color: var(--ink-2);
  --jm-star-color: var(--star);
}

/* typography: the widget inherits the store's faces rather than shipping its own */
.jm-review-widget,
.jm-review-widget *,
.jdgm-widget,
.jdgm-widget * { font-family: var(--f-body); }

.jm-review-widget-minimal-header__title,
.jm-review-widget__header .jm-text,
.jdgm-rev-widg__title {
  font-family: var(--f-head);
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}
.jm-no-reviews-state__text { color: var(--muted); }

/* review rows pick up the store's hairline vocabulary */
.jm-review, .jdgm-rev { border-color: var(--line); }
.jm-review__author, .jdgm-rev__author { font-family: var(--f-head); color: var(--ink); }
.jm-review__body, .jdgm-rev__body { color: var(--ink-2); line-height: 1.6; }

/* form inputs match the contact/account forms */
.jm-review-widget input[type="text"],
.jm-review-widget input[type="email"],
.jm-review-widget textarea,
.jdgm-form input[type="text"],
.jdgm-form input[type="email"],
.jdgm-form textarea {
  border: 1.5px solid var(--line-2);
  border-radius: 10px;
  font-family: var(--f-body);
  color: var(--ink);
  padding: 12px 14px;
}
.jm-review-widget input:focus,
.jm-review-widget textarea:focus,
.jdgm-form input:focus,
.jdgm-form textarea:focus { outline: none; border-color: var(--ink); }

/* stars */
.jdgm-star, .jm-star, [class*="jm-star"] { color: var(--star); }

/* the preview badge sits inline under the product title */
.pdp-buy__rating .jdgm-preview-badge,
.pdp-buy__rating .jm-preview-badge { display: inline-flex; align-items: center; gap: 8px; }

/* never let a widget push the page sideways */
.jm-review-widget, .jdgm-widget, .mts-app-block { max-width: 100%; }
.mts-app-block { margin-block: 4px; }

